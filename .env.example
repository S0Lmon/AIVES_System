# sa is used only by the one-shot migrate/db-init containers.
MSSQL_SA_PASSWORD=ReplaceWithAStrongPassword123@
# Password of the aives_app login the web containers use (read/write data only).
MSSQL_APP_PASSWORD=ReplaceWithAnotherStrongPassword456@
MSSQL_PID=Express

# Domain Caddy serves and issues the TLS certificate for; "localhost" for a local test.
AIVES_DOMAIN=localhost
AIVES_HTTP_PORT=80
AIVES_HTTPS_PORT=443
AIVES_WEB_REPLICAS=2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional local model; requires "docker compose --profile ollama up -d".
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=phi3:mini

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=AIVES

ADMIN_EMAIL=

DEMO_ACCOUNT_ENABLED=false
DEMO_ACCOUNT_EMAIL=demo.aives@gmail.com
DEMO_ACCOUNT_PASSWORD=
DEMO_ACCOUNT_DISPLAY_NAME=AIVES Demo
DEMO_ACCOUNT_RESET_PASSWORD=false

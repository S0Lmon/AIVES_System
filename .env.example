# sa is used only by the one-shot migrate/db-init containers.
MSSQL_SA_PASSWORD=ReplaceWithAStrongPassword123@
# Password of the aives_app login the web containers use (read/write data only).
MSSQL_APP_PASSWORD=ReplaceWithAnotherStrongPassword456@
MSSQL_PID=Express

# Password of secrets/dataprotection.pfx, which encrypts the cookie keys stored in SQL.
# scripts/preflight.sh creates the certificate with this password if it is missing.
DATAPROTECTION_CERT_PASSWORD=ReplaceWithAThirdStrongPassword789@

# Domain Caddy serves and issues the TLS certificate for; "localhost" for a local test.
AIVES_DOMAIN=localhost
AIVES_HTTP_PORT=80
AIVES_HTTPS_PORT=443

# Cloudflare Tunnel (no router port forwarding): uncomment these lines and drop the two
# port lines above. AIVES_DOMAIN is then the tunnel's public hostname. See DEPLOY.md.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
# AIVES_CADDY_SITE=:80
# AIVES_HTTP_PORT=127.0.0.1:8088
# AIVES_HTTPS_PORT=127.0.0.1:8443
# No domain? COMPOSE_PROFILES=quicktunnel gives a temporary https://*.trycloudflare.com address
# (no token needed); keep AIVES_CADDY_SITE=:80 and the 127.0.0.1 port lines above.
AIVES_WEB_REPLICAS=2

# Razor Pages site with the offline voice viva (service "razor", one instance). Caddy serves it on
# :8081, published at 127.0.0.1:8089; with quicktunnel it gets its own trycloudflare.com address.
# With a domain, set AIVES_RAZOR_SITE to its own hostname (e.g. razor.example.com).
# AIVES_RAZOR_SITE=:8081
# AIVES_RAZOR_HTTP_PORT=127.0.0.1:8089
# Whisper + Piper models from scripts/download-speech-models.ps1 -WithPreviewModel (about 750 MB).
# Missing models only turn the viva into typed answers.
# SPEECH_MODELS_DIR=./AIVES.WebRazor/App_Data/speech-models
# CPU threads per transcription (the container has no GPU) and the faster live-preview model.
# SPEECH_THREADS=8
# SPEECH_PREVIEW_MODEL=whisper/ggml-base.bin
# Gemini for the kept transcript and/or reading questions aloud; Local by default (see README).
# SPEECH_PROVIDER=Local
# SPEECH_TTS_PROVIDER=Local

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Model for live follow-up questions in the AI viva; keep it a fast "lite" model.
INTERVIEW_MODEL=gemini-3.5-flash-lite
# Model for AI grading suggestions after the viva; not live, so empty uses GEMINI_MODEL.
GRADING_MODEL=

# Printed at the top of exported grade sheets.
REPORT_SCHOOL_NAME=TRƯỜNG ĐẠI HỌC FPT
REPORT_UNIT_NAME=

# Optional local model; requires "docker compose --profile ollama up -d".
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=phi3:mini

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=AIVES

# Email domains allowed to register (comma-separated, exact match after "@").
REGISTRATION_EMAIL_DOMAINS=gmail.com,fpt.edu.vn

ADMIN_EMAIL=

DEMO_ACCOUNT_ENABLED=false
DEMO_ACCOUNT_EMAIL=demo.aives@gmail.com
DEMO_ACCOUNT_PASSWORD=
DEMO_ACCOUNT_DISPLAY_NAME=AIVES Demo
DEMO_ACCOUNT_RESET_PASSWORD=false

@page "{id:int}"
@model AIVES.WebRazor.Pages.Grading.ExamModel
@inject DisplayTimeZone TimeZone
@{
    var exam = Model.Exam;
    var finalized = exam.Rows.Count(row => row.FinalizedAtUtc is not null);
    var finished = exam.Rows.Count(row => row.InterviewStatus == InterviewStatus.Completed);
    ViewData["Title"] = exam.Title;
}
<div class="page-heading"><div><span class="page-kicker">Grading / Exam</span><h1>@exam.Title</h1><p>@exam.SubjectName@(exam.TopicName is null ? "" : " / " + exam.TopicName) · @TimeZone.ToLocal(exam.StartsAtUtc).ToString("yyyy-MM-dd HH:mm") · @L10n.Format("{0} of {1} vivas finished, {2} grades confirmed", finished, exam.Rows.Count, finalized)</p></div>
<div class="d-flex flex-wrap gap-2"><a class="btn btn-light" asp-page="/Reports/Exam" asp-route-id="@exam.ExamId">@L10n.T("Class report")</a><a class="btn btn-light" asp-page="Export" asp-route-id="@exam.ExamId">@L10n.T("Grade sheet (.xlsx)")</a><a class="btn btn-light" asp-page="Audit" asp-route-id="@exam.ExamId">@L10n.T("Audit log")</a><a class="btn btn-light" asp-page="/Interviews/Monitor" asp-route-examId="@exam.ExamId">@L10n.T("Live interview")</a></div></div>
<section class="panel overflow-hidden mb-4"><div class="table-responsive"><table class="table data-table"><thead><tr><th>#</th><th>@L10n.T("Candidate")</th><th>@L10n.T("Viva")</th><th>@L10n.T("AI proposal")</th><th>@L10n.T("Final grade")</th><th></th></tr></thead><tbody>
@foreach (var row in exam.Rows) { <tr><td>@row.Order</td><td><strong>@(row.DisplayName ?? row.Email)</strong><div class="small text-muted">@row.Email@(row.StudentCode is null ? "" : " · " + row.StudentCode)</div></td>
<td>@switch (row.InterviewStatus) { case InterviewStatus.Completed: { <span class="status-label ready">@L10n.T("Completed")</span> break; } case InterviewStatus.InProgress: { <span class="status-label warning">@L10n.T("In progress")</span> break; } default: { <span class="small text-muted">@L10n.T("Not started")</span> break; } }</td>
<td>@if (row.InterviewStatus != InterviewStatus.Completed) { <span class="small text-muted">—</span> } else if (row.GradingStatus == GradingStatus.Pending) { <span class="small text-muted">@L10n.T("AI grading…")</span> } else if (row.GradingStatus == GradingStatus.AiFailed && row.AiScore10 is null) { <span class="status-label missing">@L10n.T("AI could not grade")</span> } else { <span>@row.AiScore10?.ToString("0.##") / 10</span> }</td>
<td>@if (row.FinalScore is { } score) { <strong>@score.ToString("0.##") / 10</strong> } else if (row.InterviewStatus == InterviewStatus.Completed) { <span class="status-label warning">@L10n.T("To review")</span> }</td>
<td class="text-end">@if (row.InterviewStatus != InterviewStatus.NotStarted) { <a class="btn btn-sm @(row.FinalScore is null ? "btn-primary" : "btn-light")" asp-page="Candidate" asp-route-id="@row.CandidateId">@(row.FinalScore is null ? L10n.T("Review & grade") : L10n.T("View"))</a> }</td></tr> }
</tbody></table></div></section>
<a asp-page="Index" class="btn btn-light">@L10n.T("Back")</a>

@page "{id:int}"
@model AIVES.WebRazor.Pages.Grading.CandidateModel
@{
    var candidate = Model.Candidate;
    var finalized = candidate.FinalizedAtUtc is not null;
    var completed = candidate.Interview?.Status == InterviewStatus.Completed;
    var signals = candidate.Signals;
    ViewData["Title"] = candidate.DisplayName ?? candidate.Email;
}
<div class="page-heading"><div><span class="page-kicker">Grading / Candidate</span><h1>@(candidate.DisplayName ?? candidate.Email)</h1><p>@candidate.Email@(candidate.StudentCode is null ? "" : " · " + candidate.StudentCode) · @candidate.ExamTitle (@candidate.SubjectName) · @L10n.Format("Candidate {0}", candidate.Order)</p></div>
<div class="d-flex flex-wrap gap-2 align-items-center">@if (finalized) { <span class="status-label ready">@L10n.Format("Confirmed {0}/10", ViewText.Score(candidate.FinalScore))</span> }@if (completed) { <form method="post" asp-page-handler="RequestAi"><button type="submit" class="btn btn-light">@L10n.T("Ask the AI to grade again")</button></form> }<a class="btn btn-light" asp-page="Exam" asp-route-id="@candidate.ExamId">@L10n.T("Back to the class")</a></div></div>
@if (TempData["GradeMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }@if (TempData["GradeError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@if (!completed) { <div class="alert alert-warning" role="status">@L10n.T("The viva is not finished yet. You can look at the answers so far; the grade can be confirmed once it is finished.")</div> }
else if (candidate.GradingStatus == GradingStatus.Pending) { <div class="alert alert-info" role="status">@L10n.T("The AI is preparing its proposal. Reload the page in a minute, or grade without it.")</div> }
else if (candidate.GradingStatus == GradingStatus.AiFailed) { <div class="alert alert-warning" role="status">@L10n.T("The AI could not grade every question"): @candidate.GradingError</div> }
<section class="panel p-4 mb-3"><div class="d-flex flex-wrap gap-4">
<div><div class="small text-muted">@L10n.T("AI proposal")</div><strong class="fs-4">@ViewText.Score(candidate.AiScore10)</strong> / 10</div><div><div class="small text-muted">@L10n.T("Final grade")</div><strong class="fs-4">@(finalized ? ViewText.Score(candidate.FinalScore) : "—")</strong> / 10</div>
<div><div class="small text-muted">@L10n.T("Answers")</div><strong>@signals.Answers</strong> @if (signals.Unanswered > 0) { <span class="text-muted small">(@L10n.Format("{0} unanswered", signals.Unanswered))</span> }</div><div><div class="small text-muted">@L10n.T("Follow-ups asked")</div><strong>@signals.FollowUps</strong></div>
<div><div class="small text-muted">@L10n.T("Average time to start answering")</div><strong>@ViewText.Seconds(signals.AverageResponseDelaySeconds)</strong></div><div><div class="small text-muted">@L10n.T("Average answer length")</div><strong>@ViewText.Seconds(signals.AverageAnswerSeconds)</strong></div><div><div class="small text-muted">@L10n.T("Speaking pace")</div><strong>@(signals.WordsPerMinute is { } wpm ? L10n.Format("{0} words/min", wpm) : "—")</strong></div>
<div><div class="small text-muted">@L10n.T("Hesitations")</div><strong>@signals.FillerWords</strong>@if (signals.FillerRatio is { } ratio) { <span class="small text-muted"> (@((ratio * 100).ToString("0.#"))%)</span> }</div><div><div class="small text-muted">@L10n.T("Over time / typed")</div><strong>@signals.TimedOut / @signals.Typed</strong></div></div>
<p class="small text-muted mb-0 mt-2">@L10n.T("Timing and fluency are shown for context only; they are not part of the AI score.")@if (candidate.RecordingConsentAtUtc is { } consent) { <span> @L10n.Format("Recording agreed at {0}.", Model.TimeZone.ToLocal(consent).ToString("yyyy-MM-dd HH:mm"))</span> }</p></section>
<form method="post" asp-page-handler="Save">
@for (var i = 0; i < candidate.Questions.Count; i++) {
    var q = candidate.Questions[i]; var input = Model.Form.Questions[i];
    <section class="panel p-4 mb-3"><div class="d-flex justify-content-between flex-wrap gap-2 mb-2"><h2 class="h5 mb-0">@L10n.Format("Question {0}", q.Order) <span class="badge text-bg-light ms-1">@q.BloomLevelName</span></h2><span class="small text-muted">@(q.Rubric is null ? L10n.T("No rubric: holistic score") : L10n.Format("Rubric: {0}", q.Rubric.Name))</span></div>
    <p class="mb-2">@q.Content</p><details class="mb-3"><summary class="small">@L10n.T("Expected answer")</summary><p class="small mt-2 mb-0">@q.ExpectedAnswer</p></details>
    <h3 class="h6">@L10n.T("Transcript")</h3>@if (q.Turns.Count == 0) { <p class="small text-muted">@L10n.T("This question was not reached.")</p> }
    <ol class="small ps-3">@foreach (var turn in q.Turns) { <li class="mb-2"><strong>@(turn.Kind == TurnKind.FollowUp ? L10n.T("Follow-up") : L10n.T("Main question")):</strong> @turn.QuestionText
        <div class="mt-1">@(string.IsNullOrEmpty(turn.Answer) ? (turn.AnsweredAtUtc is null ? L10n.T("Waiting for the answer") : L10n.T("No answer")) : turn.Answer)</div>
        @if (turn.RawAnswer is { Length: > 0 } raw) { <div class="text-muted"><small>@L10n.T("As recognised before term correction"): @raw</small></div> }
        <div class="text-muted">@if (turn.InputMode == AnswerInputMode.Typed) { <span class="badge text-bg-light">@L10n.T("Typed")</span> }@if (turn.TimedOut) { <span class="badge text-bg-warning">@L10n.T("Over time")</span> }@if (turn.Decision is { } decision) { <span class="badge text-bg-light">@L10n.T("Examiner"): @ViewText.Reason(decision)</span> }@if (turn.AnsweredAtUtc is { } answered) { <span class="badge text-bg-light">@L10n.Format("{0} s to answer", Math.Round((answered - turn.AskedAtUtc).TotalSeconds))</span> }</div>
        @if (turn.RecordingId is { } recordingId) { @if (turn.RecordingHasVideo) { <video class="mt-2 d-block" controls preload="none" width="320" src="@Url.Page("Candidate", "Recording", new { id = candidate.CandidateId, recordingId })"></video> } else { <audio class="mt-2 d-block" controls preload="none" src="@Url.Page("Candidate", "Recording", new { id = candidate.CandidateId, recordingId })"></audio> } }
    </li> }</ol>
    <div class="row g-3"><div class="col-lg-7"><div class="border rounded-3 p-3 h-100"><div class="d-flex justify-content-between"><h3 class="h6 mb-2">@L10n.T("AI proposal")</h3><span><strong>@ViewText.Score(q.AiScore)</strong> / @ViewText.Score(q.MaxScore)</span></div>
        @if (q.AiScore is null) { <p class="small text-muted mb-0">@L10n.T("No AI proposal for this question.")</p> } else {
        @if (q.AiCriteria.Count > 0) { <table class="table table-sm small mb-2"><thead><tr><th>@L10n.T("Criterion")</th><th>@L10n.T("Level")</th><th class="text-end">@L10n.T("Points")</th></tr></thead><tbody>@foreach (var c in q.AiCriteria) { <tr><td>@c.Criterion<div class="text-muted">@c.Rationale</div></td><td>@c.Level</td><td class="text-end text-nowrap">@ViewText.Score(c.Points) / @ViewText.Score(c.MaxPoints)</td></tr> }</tbody></table> }
        @if (!string.IsNullOrWhiteSpace(q.AiSummary)) { <p class="small mb-2">@q.AiSummary</p> }
        <div class="row small"><div class="col-md-4"><strong>@L10n.T("Strengths")</strong><ul class="ps-3 mb-0">@foreach (var item in q.Strengths) { <li>@item</li> }</ul></div><div class="col-md-4"><strong>@L10n.T("Weaknesses")</strong><ul class="ps-3 mb-0">@foreach (var item in q.Weaknesses) { <li>@item</li> }</ul></div><div class="col-md-4"><strong>@L10n.T("Missing points")</strong><ul class="ps-3 mb-0">@foreach (var item in q.MissingPoints) { <li>@item</li> }</ul></div></div>
        @if (q.AiModel is { } model) { <p class="small text-muted mt-2 mb-0">@L10n.Format("Proposed by {0}", model)</p> } }</div></div>
    <div class="col-lg-5"><div class="border rounded-3 p-3 h-100"><h3 class="h6 mb-2">@L10n.T("Your decision")</h3><input type="hidden" asp-for="Form.Questions[i].Id" />
        <label class="form-label small" for="score-@q.Id">@L10n.Format("Score (0 – {0})", ViewText.Score(q.MaxScore))</label><input id="score-@q.Id" asp-for="Form.Questions[i].Score" class="form-control mb-2" inputmode="decimal" disabled="@finalized" />
        @if (q.LecturerScore is null && q.AiScore is not null) { <div class="form-text mb-2">@L10n.T("Pre-filled with the AI proposal. Change it if you disagree.")</div> }
        <label class="form-label small" for="comment-@q.Id">@L10n.T("Comment for the student (optional)")</label><textarea id="comment-@q.Id" asp-for="Form.Questions[i].Comment" class="form-control" rows="2" maxlength="2000" disabled="@finalized"></textarea>
    </div></div></div></section>
}
<section class="panel p-4 mb-3"><label asp-for="Form.Comment" class="form-label">@L10n.T("Overall comment for the student (optional)")</label><textarea asp-for="Form.Comment" class="form-control mb-3" rows="3" maxlength="2000" disabled="@finalized"></textarea>
    @if (finalized) { <p class="small text-muted">@L10n.Format("Confirmed by {0} at {1}.", candidate.FinalizedByEmail ?? "—", Model.TimeZone.ToLocal(candidate.FinalizedAtUtc!.Value).ToString("yyyy-MM-dd HH:mm"))</p> }
    else { <div class="d-flex flex-wrap gap-2"><button type="submit" name="Form.Finalize" value="false" class="btn btn-light">@L10n.T("Save draft")</button><button type="submit" name="Form.Finalize" value="true" class="btn btn-primary" disabled="@(!completed)" onclick="return confirm('@L10n.T("Confirm this grade? The student will see the scores and comments.")');">@L10n.T("Confirm the grade")</button></div><p class="small text-muted mt-2 mb-0">@L10n.T("You decide the final grade. The total is converted to a 10-point scale from your question scores.")</p> }
</section></form>
@if (finalized) { <form method="post" asp-page-handler="Reopen" class="mb-4" onsubmit="return confirm('@L10n.T("Reopen this grade? The student will not see it until you confirm again.")');"><button type="submit" class="btn btn-outline-secondary">@L10n.T("Reopen to change")</button></form> }

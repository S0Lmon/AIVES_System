@page "/Interview/{id:int}/{handler?}/{turnId:int?}"
@model AIVES.WebRazor.Pages.Interviews.InterviewApiModel
@inject DisplayTimeZone TimeZone
@{
    var state = Model.State;
    ViewData["Title"] = state.ExamTitle;
    var culture = state.Language.ToSpeechLocale();
}
<div class="page-heading"><div><span class="page-kicker">Exams / AI viva</span><h1>@state.ExamTitle</h1><p>@L10n.T("Your slot"): @TimeZone.ToLocal(state.SlotStartsAtUtc).ToString("yyyy-MM-dd HH:mm") – @TimeZone.ToLocal(state.SlotEndsAtUtc).ToString("HH:mm") (@TimeZone.OffsetLabel)</p></div></div>
@if (state.AdminTestMode)
{
    <div class="alert alert-warning" role="status">@L10n.T("Administrator test run: this is a separate copy of the selected question set. It does not change the student's attempt or enter grading.")</div>
}
@Html.AntiForgeryToken()
<div id="interview" data-base-url="@Url.Page("/Interviews/Interview", new { id = state.CandidateId })" data-lang="@culture"
     data-candidate-id="@state.CandidateId" data-speech-hub-url="@Url.Content("~/hubs/speech-recognition")"
     data-stt-available="@Model.ServerRecognizesAnswers.ToString().ToLowerInvariant()"
     data-audio-url="@(Model.ServerReadsQuestions ? Url.Page("/Interviews/Interview", "QuestionAudio", new { id = state.CandidateId }) : null)"
     data-initial-state="@System.Text.Json.JsonSerializer.Serialize(state, InterviewApiModel.JsonOptions)"
     data-text-main="@L10n.T("Question {0} of {1}")" data-text-followup="@L10n.T("Follow-up question")"
     data-text-processing="@L10n.T("The examiner is considering your answer…")" data-text-listening="@L10n.T("Listening… speak your answer.")"
     data-text-speaking="@L10n.T("The examiner is reading the question…")"
     data-text-type-answer="@L10n.T("Type your answer below.")"
     data-text-no-speech="@L10n.T("The local Vosk model for this language is not installed on the server. Please type your answer.")"
     data-text-speech-unavailable="@L10n.T("No server voice is available for this language; read the question above.")"
     data-text-mic-error="@L10n.T("The microphone could not be used or connected to speech recognition. Please type your answer.")"
     data-text-error="@L10n.T("Something went wrong. Please try again.")"
     data-text-consent="@L10n.T("Please tick that you agree to the recording before starting.")"
     data-text-record-error="@L10n.T("The recording could not start (camera or microphone unavailable). Your answers are still saved as text.")"
     data-text-recording="@L10n.T("Recording")">
    <section class="panel p-4 mb-3" data-step="intro" hidden><h2 class="h5">@L10n.T("Before you start")</h2>
        <ul class="mb-3"><li>@L10n.T("The examiner presents each question; it may be read aloud when a matching server voice is installed. You can answer by speaking or typing.")</li>@if (Model.QuestionTextSentToOnlineSpeech) { <li>@L10n.T("The selected Edge TTS voice sends question text to Microsoft's online speech service. Microphone recognition remains local to this server.")</li> }<li>@L10n.T("Each answer has a time limit. When it runs out, your answer is submitted automatically.")</li><li>@L10n.T("Depending on your answer, the examiner may ask a follow-up question.")</li><li>@L10n.T("For speech input, allow microphone access and keep a stable connection to the server. Stay in a quiet place and do not reload the page.")</li></ul>
        @if (state.Recording != RecordingMode.None) { <div class="alert alert-info small"><strong>@(state.Recording == RecordingMode.AudioVideo ? L10n.T("This viva is recorded (audio and camera).") : L10n.T("This viva is recorded (audio)."))</strong> @L10n.T("The whole viva, including the examiner's questions, and each answer are recorded and stored encrypted as evidence in case of a grade appeal. Only your lecturer and administrators can play them; every playback is logged, and recordings are deleted automatically after the retention period.")</div><div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="recordingConsent" data-field="consent" /><label class="form-check-label" for="recordingConsent">@L10n.T("I agree that this viva and my answers are recorded.")</label></div> }
        <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="speechConsent" data-field="speech-consent" disabled="@(!Model.ServerRecognizesAnswers)" /><label class="form-check-label" for="speechConsent">@L10n.T("Use offline Vosk on this server to recognize my spoken answers. Microphone audio is streamed here and is not sent to an external speech service.")</label></div>
        <p class="small text-muted mb-3">@L10n.T("Leave this off to type. Speech recognition requires the local language model. If this viva is recorded, audio/video is stored separately as disclosed above.")</p>
        <button type="button" class="btn btn-primary" data-action="start">@L10n.T("Start the viva")</button>
    </section>
    <section class="panel p-4 mb-3" data-step="question" hidden><div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap"><span class="badge text-bg-light" data-field="position"></span><span class="d-flex gap-2 align-items-center"><span class="status-label missing" data-field="rec" hidden>● @L10n.T("Recording")</span><span class="status-label ready" data-field="timer" aria-live="polite"></span></span></div>
        <video data-field="preview" class="rounded mb-2" width="160" height="120" muted playsinline autoplay hidden></video><p class="fs-5 mb-3" data-field="question" aria-live="polite"></p><p class="small text-muted mb-2" data-field="status" aria-live="polite"></p>
        <label class="form-label" for="interviewAnswer">@L10n.T("Your answer")</label><textarea id="interviewAnswer" class="form-control mb-2" rows="5" maxlength="5000" data-field="answer" readonly></textarea>
        <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="interviewTyping" data-field="typing" /><label class="form-check-label" for="interviewTyping">@L10n.T("Type my answer instead of speaking")</label></div>
        <div class="d-flex gap-2 flex-wrap"><button type="button" class="btn btn-primary" data-action="submit">@L10n.T("Finish my answer")</button><button type="button" class="btn btn-light" data-action="repeat">@L10n.T("Read the question again")</button></div>
    </section>
    <section class="panel p-4 mb-3" data-step="processing" hidden><p class="mb-0" data-field="processing"></p></section>
    <section class="panel p-4 mb-3" data-step="done" hidden><h2 class="h5">@L10n.T("Your viva is complete")</h2><p class="mb-0">@L10n.T("Thank you. Your answers have been recorded for your lecturer to review.")</p></section>
    <div class="alert alert-danger" role="alert" data-field="error" hidden></div>
</div>
<div class="d-flex gap-2">
    @if (state.AdminTestMode)
    {
        <a asp-page="/Exams/Details" asp-route-id="@state.ExamId" class="btn btn-light">@L10n.T("Back to exam details")</a>
    }
    else
    {
        <a asp-page="/MyExams/Index" class="btn btn-light">@L10n.T("Back to my exams")</a>
    }
</div>
@section Scripts { <script src="~/js/interview.js" asp-append-version="true"></script> }

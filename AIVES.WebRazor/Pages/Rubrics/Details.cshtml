@page "{id:int}"
@model AIVES.WebRazor.Pages.Rubrics.DetailsModel
@{
    var rubric = Model.Rubric;
    var levels = rubric.Levels.OrderBy(level => level.Order).ToList();
    ViewData["Title"] = rubric.Name;
}
<div class="page-heading">
    <div>
        <span class="page-kicker">Rubric · @rubric.TotalPoints điểm</span>
        <h1>@rubric.Name</h1>
        <p>@rubric.Description</p>
    </div>
    <a asp-page="Index" class="btn btn-light">Tất cả rubric</a>
</div>
<section class="panel">
    <div class="table-responsive">
        <table class="table data-table">
            <thead>
                <tr>
                    <th>Tiêu chí</th>
                    @foreach (var level in levels)
                    {
                        <th>@level.Name</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var criterion in rubric.Criteria.OrderBy(criterion => criterion.Order))
                {
                    <tr>
                        <td><strong>@criterion.Criterion</strong><br /><small class="text-muted">tối đa @criterion.MaxPoints điểm</small></td>
                        @foreach (var level in levels)
                        {
                            var cell = DetailsModel.Cell(criterion, level);
                            <td>
                                <span class="badge-soft mb-1">@(cell?.Points ?? 0) đ</span>
                                <div class="small">@cell?.Descriptor</div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

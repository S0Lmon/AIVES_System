@page "{id:int}"
@model AIVES.WebRazor.Pages.Rubrics.DetailsModel
@{
    var rubric = Model.Rubric;
    var levels = rubric.Levels.OrderBy(level => level.Order).ToList();
    ViewData["Title"] = rubric.Name;
}
<div class="page-heading">
    <div>
        <span class="page-kicker">@L10n.Format("Rubric · {0} points", rubric.TotalPoints)</span>
        <h1>@rubric.Name</h1>
        <p>@rubric.Description</p>
    </div>
    <a asp-page="Index" class="btn btn-light">@L10n.T("All rubrics")</a>
</div>
<section class="panel">
    <div class="table-responsive">
        <table class="table data-table">
            <thead>
                <tr>
                    <th>@L10n.T("Criterion")</th>
                    @foreach (var level in levels)
                    {
                        <th>@level.Name</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var criterion in rubric.Criteria.OrderBy(criterion => criterion.Order))
                {
                    <tr>
                        <td><strong>@criterion.Criterion</strong><br /><small class="text-muted">@L10n.Format("up to {0} points", criterion.MaxPoints)</small></td>
                        @foreach (var level in levels)
                        {
                            var cell = DetailsModel.Cell(criterion, level);
                            <td>
                                <span class="badge-soft mb-1">@L10n.Format("{0} pts", cell?.Points ?? 0)</span>
                                <div class="small">@cell?.Descriptor</div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

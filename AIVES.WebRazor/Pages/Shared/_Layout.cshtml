<!DOCTYPE html>
@{
    var page = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
    string Active(string folder) => page.StartsWith(folder, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isStaff = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Lecturer);
}
<html lang="@L10n.Current.ToCultureCode()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AIVES</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hallmark.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/slide-panels.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalog-picker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/banks.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/realtime.css" asp-append-version="true" />
</head>
<body data-user-id="@AivesHub.UserId(User)" data-hub-url="@(signedIn ? AivesHub.Path : "")">
    <div class="app-shell">
        <aside class="sidebar" id="appSidebar">
            <a class="brand" asp-page="/Index">
                <div class="brand-mark">A</div>
                <div><strong>AIVES</strong><small>AI-powered Viva Exam</small></div>
            </a>
            <nav class="side-nav">
                <div class="nav-label">Menu</div>
                <a class="side-link @(page == "/Index" ? "active" : "")" asp-page="/Index">
                    <span>@L10n.T("Overview")</span>
                </a>
                @if (isStaff)
                {
                    <div class="nav-label nav-label-spaced">@L10n.T("Staff")</div>
                    <a class="side-link @Active("/Questions")" asp-page="/Questions/Index" asp-route-tab="bank">
                        <span>@L10n.T("Question bank")</span>
                    </a>
                    <a class="side-link @Active("/Rubrics")" asp-page="/Rubrics/Index" asp-route-tab="bank">
                        <span>@L10n.T("Rubric bank")</span>
                    </a>
                    <a class="side-link @Active("/Catalog")" asp-page="/Catalog/Index">
                        <span>@L10n.T("Catalog")</span>
                    </a>
                    <a class="side-link @Active("/Exams")" asp-page="/Exams/Index">
                        <span>@L10n.T("Exams")</span>
                    </a>
                    <a class="side-link @(page.StartsWith("/Exams/Calendar", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Exams/Calendar">
                        <span>@L10n.T("Calendar")</span>
                    </a>
                    <a class="side-link @Active("/Grading")" asp-page="/Grading/Index">
                        <span>@L10n.T("Grading")</span>
                    </a>
                    <a class="side-link @Active("/Reports")" asp-page="/Reports/Index">
                        <span>@L10n.T("Reports")</span>
                    </a>
                    <a class="side-link @Active("/Glossary")" asp-page="/Glossary/Index">
                        <span>@L10n.T("Subject terms")</span>
                    </a>
                }
                <a class="side-link @Active("/MyExams")" asp-page="/MyExams/Index">
                    <span>@L10n.T("My exams")</span>
                </a>
                @if (isAdmin)
                {
                    <div class="nav-label nav-label-spaced">@L10n.T("Admin")</div>
                    <a class="side-link @Active("/Admin/Users")" asp-page="/Admin/Users"><span>@L10n.T("Users")</span></a>
                    <a class="side-link @Active("/Admin/Subjects")" asp-page="/Admin/Subjects"><span>@L10n.T("Lecturers per subject")</span></a>
                    <a class="side-link @Active("/Admin/Settings")" asp-page="/Admin/Settings"><span>@L10n.T("Speech settings")</span></a>
                    <a class="side-link @Active("/Admin/Audit")" asp-page="/Admin/Audit"><span>@L10n.T("Audit log")</span></a>
                }
                <div class="nav-label nav-label-spaced">@L10n.T("Legal")</div>
                <a class="side-link" asp-page="/Privacy"><span>@L10n.T("Data policy")</span></a>
            </nav>
            <div class="sidebar-note">
                <div class="note-dot"></div>
                <div><strong>@L10n.T("System ready")</strong><small>@L10n.T("All services online")</small></div>
            </div>
        </aside>
        <div class="app-main">
            <header class="topbar">
                <div class="topbar-copy">
                    <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation">☰</button>
                    <strong>@ViewData["Title"]</strong>
                </div>
                <div class="topbar-actions">
                    <div class="database-pill"><span></span><span>@L10n.T("System online")</span></div>
                    <div class="d-flex align-items-center gap-2">
                        @await Html.PartialAsync("_LanguageSwitcher")
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var displayName = User.Identity.Name ?? "GV";
                            <a class="avatar" asp-page="/Profile/Index" title="@L10n.T("Your profile")">@displayName[..Math.Min(2, displayName.Length)].ToUpperInvariant()</a>
                        }
                        else
                        {
                            <a asp-page="/Account/Login" class="btn btn-outline-primary btn-sm">@L10n.T("Sign in")</a>
                        }
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="live-status" data-live-status="connecting" title="Trạng thái kết nối real-time"><span class="live-dot"></span><span data-live-label>Đang kết nối…</span></span>
                        <div class="dropdown">
                            <button class="online-pill dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="online-dot"></span> <span data-online-count>0</span> online
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end online-menu" data-online-list>
                                <li class="dropdown-item-text text-muted small">Chưa có dữ liệu</li>
                            </ul>
                        </div>
                    }
                </div>
            </header>
            <main class="content-area">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success" role="status">@success</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger" role="alert">@error</div>
                }
                @if (TempData["Notice"] is string notice)
                {
                    <div class="alert alert-info" role="status">@notice</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <div class="toast-stack" data-toast-stack aria-live="polite" aria-atomic="false"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (signedIn)
    {
        <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
        <script src="~/js/realtime.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

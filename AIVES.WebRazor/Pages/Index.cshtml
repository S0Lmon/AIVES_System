@page
@model IndexModel
@{
    ViewData["Title"] = "Tổng quan";
}
<div class="welcome-row">
    <div>
        <span class="page-kicker">Razor Pages · SignalR</span>
        <h1>Xin chào, @AivesHub.DisplayName(User)</h1>
        <p>Mọi thay đổi của đồng nghiệp hiện ra ở đây ngay lập tức, không cần tải lại trang.</p>
    </div>
    @if (Model.IsStaff)
    {
        <a asp-page="/Questions/Create" class="btn btn-primary">+ Thêm câu hỏi</a>
    }
</div>

@if (Model.IsStaff && Model.Numbers is { } stats)
{
    <div class="metric-grid mb-4" data-stats-url="@Url.Page("/Index", "Stats")">
        <div class="panel metric-card stat-card"><div><strong data-stat="questions">@stats.Questions</strong><small>Câu hỏi trong ngân hàng</small></div></div>
        <div class="panel metric-card stat-card"><div><strong data-stat="activeQuestions">@stats.ActiveQuestions</strong><small>Câu hỏi đang hoạt động</small></div></div>
        <div class="panel metric-card stat-card"><div><strong data-stat="subjects">@stats.Subjects</strong><small>Môn học · <span data-stat="topics">@stats.Topics</span> chủ đề</small></div></div>
        <div class="panel metric-card stat-card"><div><strong data-stat="rubrics">@stats.Rubrics</strong><small>Rubric</small></div></div>
    </div>
}

<div class="dashboard-grid">
    @if (Model.IsStaff)
    {
        <section class="panel">
            <div class="panel-header">
                <h2>Hoạt động trực tiếp</h2>
                <small class="text-muted">Kể từ khi bạn mở trang này</small>
            </div>
            <ul class="activity-feed" data-activity-feed hidden></ul>
            <p class="activity-empty" data-activity-empty>Chưa có thay đổi nào. Hãy mở một tab khác (hoặc đăng nhập tài khoản khác) và thêm / sửa / xoá một câu hỏi để thấy cập nhật real-time.</p>
        </section>
    }
    <section class="panel">
        <div class="panel-header"><h2>Đang online</h2><span class="badge-soft"><span data-online-count>0</span> người</span></div>
        <ul class="activity-feed" data-online-board></ul>
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const feed = document.querySelector('[data-activity-feed]');
            const empty = document.querySelector('[data-activity-empty]');
            const statsBox = document.querySelector('[data-stats-url]');
            const board = document.querySelector('[data-online-board]');

            document.addEventListener('aives:presence', (event) => {
                board.replaceChildren(...event.detail.map((user) => {
                    const item = document.createElement('li');
                    const dot = document.createElement('span');
                    dot.className = 'feed-dot created';
                    const name = document.createElement('div');
                    name.textContent = user.name;
                    const tabs = document.createElement('time');
                    tabs.textContent = `${user.connections} tab`;
                    item.append(dot, name, tabs);
                    return item;
                }));
            });

            const refreshStats = async () => {
                if (!statsBox) return;
                const response = await fetch(statsBox.dataset.statsUrl, { credentials: 'same-origin' });
                if (!response.ok) return;
                const stats = await response.json();
                for (const [key, value] of Object.entries(stats)) {
                    const cell = statsBox.querySelector(`[data-stat="${key}"]`);
                    if (!cell || cell.textContent === String(value)) continue;
                    cell.textContent = String(value);
                    cell.classList.add('bumped');
                    setTimeout(() => cell.classList.remove('bumped'), 1200);
                }
            };

            document.addEventListener('aives:entity-changed', (event) => {
                const change = event.detail;
                refreshStats();
                if (!feed) return;
                const item = document.createElement('li');
                const dot = document.createElement('span');
                dot.className = `feed-dot ${change.action}`;
                const body = document.createElement('div');
                const line = document.createElement('strong');
                line.textContent = window.aivesLive.describe(change);
                const title = document.createElement('p');
                title.textContent = change.title;
                body.append(line, title);
                const time = document.createElement('time');
                time.textContent = new Date(change.atUtc).toLocaleTimeString('vi-VN');
                item.append(dot, body, time);
                feed.prepend(item);
                while (feed.children.length > 30) feed.lastElementChild.remove();
                feed.hidden = false;
                empty.hidden = true;
            });
            document.addEventListener('aives:reconnected', refreshStats);
        })();
    </script>
}

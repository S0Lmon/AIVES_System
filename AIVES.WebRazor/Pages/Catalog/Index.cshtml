@page
@model AIVES.WebRazor.Pages.Catalog.IndexModel
@{
    ViewData["Title"] = L10n.T("Catalog");
    var opened = Model.Subjects.FirstOrDefault(x => x.Id == Model.SubjectId);
}
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<nav class="bank-tabs" aria-label="@L10n.T("Catalog sections")">
    <a class="bank-tab @(Model.ActiveTab == "subject" ? "is-active" : "")" asp-page="./Index" asp-route-tab="subject">@L10n.T("Subjects & topics")</a>
    <a class="bank-tab @(Model.ActiveTab == "material" ? "is-active" : "")" asp-page="./Index" asp-route-tab="material">@L10n.T("Materials")</a>
</nav>
<div class="stat-strip"><div class="stat"><span class="stat-value">@Model.Subjects.Count</span><span class="stat-label">@L10n.T("Subjects")</span></div><div class="stat"><span class="stat-value">@Model.Topics.Count</span><span class="stat-label">@L10n.T("Topics")</span></div><div class="stat"><span class="stat-value">@Model.Materials.Count</span><span class="stat-label">@L10n.T("Materials")</span></div></div>
@if (Model.ActiveTab == "subject")
{
    <form method="get" class="cat-toolbar-form mb-3"><input type="hidden" name="tab" value="subject" /><input type="search" name="subjectFilter" value="@Model.SubjectFilter" class="form-control form-control-sm" placeholder="@L10n.T("Search subjects or topics")" /><button class="btn btn-light btn-sm">@L10n.T("Search")</button><a class="btn btn-primary btn-sm" href="#new-subject">@L10n.T("Add subject")</a>@if (opened is not null) { <a class="btn btn-light btn-sm" asp-page="./Index" asp-route-tab="subject">@L10n.T("All subjects")</a> }</form>
    <form method="post" asp-page-handler="CreateSubject" id="new-subject" class="panel form-panel mb-3"><div class="panel-header"><h2>@L10n.T("New subject")</h2><p>@L10n.T("Create a subject, then add topics to hold course material.")</p></div><div class="panel-body row g-3"><div class="col-md-4"><label class="form-label">@L10n.T("Subject name")</label><input name="Subject.Name" class="form-control" maxlength="200" required /></div><div class="col-md-5"><label class="form-label">@L10n.T("Description")</label><input name="Subject.Description" class="form-control" maxlength="500" /></div><div class="col-md-3 align-self-end"><button class="btn btn-primary">@L10n.T("Create subject")</button></div></div></form>
    @if (opened is not null)
    {
        var topics = Model.Topics.Where(x => x.SubjectId == opened.Id).ToList();
        <section class="panel subject-page">
            <header class="subject-page-head"><div><span class="page-kicker">@L10n.T("Subject")</span><h2>@opened.Name</h2><p class="text-muted">@opened.Description</p></div><div class="subject-page-stats"><span class="badge-soft">@L10n.Format("{0} topics", topics.Count)</span><span class="badge-soft">@L10n.Format("{0} materials", opened.MaterialCount)</span></div></header>
            <div class="subject-page-actions"><button class="btn btn-light btn-sm" type="button" onclick="document.getElementById('edit-subject').hidden=!document.getElementById('edit-subject').hidden">@L10n.T("Edit subject")</button><form method="post" asp-page-handler="DeleteSubject" asp-route-id="@opened.Id" onsubmit="return confirm('@L10n.T("Delete this subject and everything under it?")')"><button class="btn btn-light btn-sm text-danger">@L10n.T("Delete subject")</button></form></div>
            <form method="post" asp-page-handler="UpdateSubject" asp-route-id="@opened.Id" id="edit-subject" class="cat-inline-form mb-3" hidden><div class="cat-inline-grid"><input name="Subject.Name" value="@opened.Name" class="form-control" maxlength="200" required /><input name="Subject.Description" value="@opened.Description" class="form-control" maxlength="500" /><button class="btn btn-primary btn-sm">@L10n.T("Save")</button></div></form>
            <form method="post" asp-page-handler="CreateTopic" class="topic-create"><input type="hidden" name="Topic.SubjectId" value="@opened.Id" /><div class="topic-create-head"><h3>@L10n.T("Add a topic")</h3><p class="text-muted">@L10n.T("Topics hold material that AI questions are grounded in.")</p></div><div class="topic-create-grid"><div><label class="form-label">@L10n.T("Topic name")</label><input name="Topic.Name" class="form-control" maxlength="200" required /></div><div><label class="form-label">@L10n.T("Description")</label><input name="Topic.Description" class="form-control" maxlength="500" /></div><button class="btn btn-primary">@L10n.T("+ Add topic")</button></div></form>
            @if (topics.Count == 0) { <div class="cat-empty-row">@L10n.T("No topics under this subject yet.")</div> }
            else { <div class="table-responsive"><table class="table data-table compact cat-topics"><thead><tr><th>#</th><th>@L10n.T("Topic")</th><th>@L10n.T("Material")</th><th>@L10n.T("Actions")</th></tr></thead><tbody>@for (var i=0;i<topics.Count;i++) { var t=topics[i]; <tr><td><span class="sheet-rownumber">@(i+1)</span></td><td><strong>@t.Name</strong><small class="d-block text-muted">@t.Description</small></td><td><a asp-page="./Index" asp-route-tab="material" asp-route-subjectId="@opened.Id" asp-route-topicId="@t.Id">@t.MaterialCount</a></td><td class="d-flex gap-1"><details><summary class="btn btn-light btn-sm">@L10n.T("Edit")</summary><form method="post" asp-page-handler="UpdateTopic" asp-route-id="@t.Id" asp-route-subjectId="@opened.Id" class="cat-inline-form"><input name="Topic.Name" value="@t.Name" class="form-control" required /><input name="Topic.Description" value="@t.Description" class="form-control" /><button class="btn btn-primary btn-sm">@L10n.T("Save")</button></form></details><form method="post" asp-page-handler="DeleteTopic" asp-route-id="@t.Id" asp-route-subjectId="@opened.Id" onsubmit="return confirm('@L10n.T("Delete this topic and its material?")')"><button class="btn btn-light btn-sm text-danger">@L10n.T("Delete")</button></form></td></tr> }</tbody></table></div> }
        </section>
    }
    else
    {
        <section class="panel overflow-hidden"><div class="panel-header"><h2>@L10n.T("Subjects")</h2></div><div class="table-responsive"><table class="table data-table"><thead><tr><th>@L10n.T("Subject")</th><th>@L10n.T("Topics")</th><th>@L10n.T("Materials")</th><th></th></tr></thead><tbody>
        @foreach (var s in Model.Subjects.Where(x => string.IsNullOrWhiteSpace(Model.SubjectFilter) || x.Name.Contains(Model.SubjectFilter.Trim(), StringComparison.OrdinalIgnoreCase) || Model.Topics.Any(t => t.SubjectId == x.Id && t.Name.Contains(Model.SubjectFilter.Trim(), StringComparison.OrdinalIgnoreCase)))) { <tr><td><strong>@s.Name</strong><small class="text-muted d-block">@s.Description</small></td><td>@s.TopicCount</td><td>@s.MaterialCount</td><td><a class="btn btn-light btn-sm" asp-page="./Index" asp-route-tab="subject" asp-route-subjectId="@s.Id">@L10n.T("Open")</a></td></tr> }
        </tbody></table></div></section>
    }
}
else
{
    <form method="get" class="cat-toolbar-form mb-3"><input type="hidden" name="tab" value="material" /><select name="subjectId" class="form-select form-select-sm"><option value="">@L10n.T("All subjects")</option>@foreach(var s in Model.Subjects){<option value="@s.Id" selected="@(s.Id==Model.SubjectId)">@s.Name</option>}</select><select name="topicId" class="form-select form-select-sm"><option value="">@L10n.T("All topics")</option>@foreach(var t in Model.Topics.Where(x=>Model.SubjectId is null || x.SubjectId==Model.SubjectId)){<option value="@t.Id" selected="@(t.Id==Model.TopicId)">@t.SubjectName — @t.Name</option>}</select><input name="materialFilter" value="@Model.MaterialFilter" class="form-control form-control-sm" placeholder="@L10n.T("Search material")" /><button class="btn btn-light btn-sm">@L10n.T("Filter")</button></form>
    <div class="dashboard-grid mb-3">
        <form method="post" asp-page-handler="CreateMaterial" class="panel form-panel"><div class="panel-header"><h2>@L10n.T("Add material")</h2></div><div class="panel-body"><div class="mb-3"><label class="form-label">@L10n.T("Topic")</label><select name="Material.TopicId" class="form-select" required><option value="">@L10n.T("Choose topic")</option>@foreach(var t in Model.Topics.Where(x=>Model.SubjectId is null || x.SubjectId==Model.SubjectId)){<option value="@t.Id">@t.SubjectName — @t.Name</option>}</select></div><div class="mb-3"><label class="form-label">@L10n.T("Title")</label><input name="Material.Title" class="form-control" minlength="2" maxlength="300" required /></div><div class="mb-3"><label class="form-label">@L10n.T("Content")</label><textarea name="Material.Content" class="form-control" rows="6" required></textarea></div><div class="form-check mb-3"><input type="checkbox" name="Material.IsActive" value="true" checked class="form-check-input" /><label class="form-check-label">@L10n.T("Active for AI retrieval")</label></div><button class="btn btn-primary">@L10n.T("Save material")</button></div></form>
        <form method="post" asp-page-handler="ImportMaterial" enctype="multipart/form-data" class="panel form-panel align-self-start"><div class="panel-header"><h2>@L10n.T("Import material")</h2><p>@L10n.T("PDF, Word, PowerPoint, text, Markdown, CSV, or JSON (max 20 MB).")</p></div><div class="panel-body"><label class="form-label">@L10n.T("Topic")</label><select name="topicId" class="form-select mb-3" required><option value="">@L10n.T("Choose topic")</option>@foreach(var t in Model.Topics){<option value="@t.Id">@t.SubjectName — @t.Name</option>}</select><input name="file" type="file" class="form-control mb-3" accept=".txt,.md,.markdown,.csv,.json,.pdf,.docx,.pptx" required /><button class="btn btn-primary">@L10n.T("Import file")</button></div></form>
    </div>
    <section class="panel overflow-hidden"><div class="panel-header"><h2>@L10n.T("Material library") <small class="text-muted">@L10n.Format("{0} items", Model.Materials.Count)</small></h2></div>
        @if(Model.Materials.Count==0){<div class="empty-state"><h3>@L10n.T("No materials found")</h3></div>}
        else{<div class="table-responsive"><table class="table data-table"><thead><tr><th>@L10n.T("Title")</th><th>@L10n.T("Subject / topic")</th><th>@L10n.T("Source")</th><th>@L10n.T("Status")</th><th>@L10n.T("Actions")</th></tr></thead><tbody>
        @foreach(var m in Model.Materials){<tr><td><strong>@m.Title</strong><small class="d-block text-muted">@L10n.Format("{0} characters", m.ContentLength)</small></td><td>@m.SubjectName<small class="d-block text-muted">@m.TopicName</small></td><td>@(m.SourceFileName ?? L10n.T("Manual"))</td><td>@(m.IsActive ? L10n.T("Active") : L10n.T("Inactive"))</td><td><details><summary class="btn btn-light btn-sm">@L10n.T("Edit")</summary><form method="post" asp-page-handler="UpdateMaterial" asp-route-id="@m.Id" class="panel-body"><input type="hidden" name="Material.TopicId" value="@m.TopicId" /><input type="hidden" name="Material.SubjectId" value="@Model.SubjectId" /><label class="form-label">@L10n.T("Title")</label><input name="Material.Title" value="@m.Title" class="form-control mb-2" required /><label class="form-label">@L10n.T("Content")</label><textarea name="Material.Content" class="form-control mb-2" rows="5">@m.Content</textarea><label><input type="checkbox" name="Material.IsActive" value="true" checked="@m.IsActive" /> @L10n.T("Active")</label><input type="hidden" name="Material.SourceFileName" value="@m.SourceFileName" /><input type="hidden" name="Material.IsImportedFile" value="@(m.SourceType == AIVES.DTO.MaterialSourceType.ImportedFile ? "true" : "false")" /><button class="btn btn-primary btn-sm mt-2">@L10n.T("Save")</button></form></details><form method="post" asp-page-handler="DeleteMaterial" asp-route-id="@m.Id" asp-route-subjectId="@Model.SubjectId" asp-route-topicId="@Model.TopicId" onsubmit="return confirm('@L10n.T("Delete this material?")')"><button class="btn btn-light btn-sm text-danger">@L10n.T("Delete")</button></form></td></tr>}
        </tbody></table></div>}
    </section>
}

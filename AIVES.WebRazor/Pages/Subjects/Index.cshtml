@page
@model AIVES.WebRazor.Pages.Subjects.IndexModel
@{
    ViewData["Title"] = L10n.T("Subjects & topics");
}
<div class="page-heading">
    <div>
        <span class="page-kicker">@L10n.T("Catalog · live updates")</span>
        <h1>@L10n.T("Subjects & topics")</h1>
        <p>@L10n.T("Questions are filed under the subjects and topics here.")</p>
    </div>
</div>
<div class="dashboard-grid">
    <section class="panel" data-live-region>
        <partial name="_SubjectRows" model="Model" />
    </section>
    <form method="post" class="panel align-self-start">
        <div class="panel-header"><h2>@L10n.T("Add subject")</h2></div>
        <div class="panel-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="mb-3">
                <label asp-for="NewSubject.Name" class="form-label"></label>
                <input asp-for="NewSubject.Name" class="form-control" />
                <span asp-validation-for="NewSubject.Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewSubject.Description" class="form-label"></label>
                <textarea asp-for="NewSubject.Description" class="form-control" rows="3"></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-100">@L10n.T("Create subject")</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const region = document.querySelector('[data-live-region]');
            const refresh = () => window.refreshRegion(region, 'Rows');
            document.addEventListener('aives:entity-changed', (event) => {
                if (['subject', 'topic'].includes(event.detail.entity)) refresh();
            });
            document.addEventListener('aives:reconnected', refresh);
        })();
    </script>
}

@model AIVES.WebRazor.Pages.Subjects.DetailsModel
<div class="panel-header"><h2>@Model.Topics.Count chủ đề</h2></div>
@if (Model.Topics.Count == 0)
{
    <p class="activity-empty">Môn học này chưa có chủ đề.</p>
}
else
{
    <div class="table-responsive">
        <table class="table data-table">
            <thead><tr><th>Chủ đề</th><th>Tài liệu</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
                @foreach (var topic in Model.Topics)
                {
                    <tr>
                        <td><div class="question-title">@topic.Name</div><small class="text-muted">@topic.Description</small></td>
                        <td>@topic.MaterialCount</td>
                        <td>
                            <form method="post" asp-page="/Subjects/Details" asp-page-handler="DeleteTopic" asp-route-id="@Model.Id" asp-route-topicId="@topic.Id"
                                  class="action-group" onsubmit="return confirm('Xoá chủ đề này cùng tài liệu của nó?');">
                                <a asp-page="/Questions/Create" asp-route-subjectId="@Model.Id" asp-route-topicId="@topic.Id" class="btn btn-sm btn-light">+ Câu hỏi</a>
                                <button type="submit" class="btn btn-sm btn-warning">Xoá</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

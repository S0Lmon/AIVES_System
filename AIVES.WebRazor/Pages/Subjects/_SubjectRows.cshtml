@model AIVES.WebRazor.Pages.Subjects.IndexModel
<div class="panel-header"><h2>@L10n.Format("{0} subjects", Model.Subjects.Count)</h2></div>
@if (Model.Subjects.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">S</div>
        <h3>@L10n.T("No subjects yet")</h3>
        <p>@L10n.T("Create the first subject with the form alongside.")</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table data-table">
            <thead><tr><th>@L10n.T("Subject")</th><th>@L10n.T("Topics")</th><th>@L10n.T("Materials")</th><th class="text-end">@L10n.T("Actions")</th></tr></thead>
            <tbody>
                @foreach (var subject in Model.Subjects)
                {
                    <tr>
                        <td>
                            <a asp-page="/Subjects/Details" asp-route-id="@subject.Id" class="question-title d-block text-decoration-none">@subject.Name</a>
                            <small class="text-muted">@subject.Description</small>
                        </td>
                        <td>@subject.TopicCount</td>
                        <td>@subject.MaterialCount</td>
                        <td>
                            <form method="post" asp-page="/Subjects/Index" asp-page-handler="Delete" asp-route-id="@subject.Id" class="action-group"
                                  onsubmit="return confirm('@L10n.T("Delete this subject with all its topics and materials?")');">
                                <a asp-page="/Subjects/Details" asp-route-id="@subject.Id" class="btn btn-sm btn-info">@L10n.T("Open")</a>
                                <button type="submit" class="btn btn-sm btn-warning">@L10n.T("Delete")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

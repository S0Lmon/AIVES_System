@page
@model AIVES.WebRazor.Pages.Glossary.IndexModel
@{
    ViewData["Title"] = L10n.T("Subject glossary");
}
<div class="page-heading"><div><span class="page-kicker">@L10n.T("Speech recognition")</span><h1>@L10n.T("Subject glossary")</h1><p>@L10n.T("Terms and spoken forms help recognition, transcript correction, examinations, and grading.")</p></div></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<form method="get" class="panel panel-body d-flex gap-2 align-items-end mb-3" style="max-width:480px">
    <div class="flex-grow-1"><label class="form-label" for="subjectId">@L10n.T("Subject")</label><select id="subjectId" name="subjectId" class="form-select" onchange="this.form.submit()">@foreach (var s in Model.Subjects) { <option value="@s.Id" selected="@(s.Id == Model.SelectedSubjectId)">@s.Name</option> }</select></div>
    <button class="btn btn-light">@L10n.T("Open")</button>
</form>
@if (Model.SelectedSubjectId == 0)
{
    <section class="panel empty-state"><h3>@L10n.T("Create a subject first")</h3><p>@L10n.T("Glossary terms belong to a subject in the catalog.")</p><a asp-page="/Catalog/Index" class="btn btn-primary">@L10n.T("Open catalog")</a></section>
}
else
{
    <form method="post" asp-page-handler="Add" class="panel p-4 mb-3">
        <input type="hidden" name="subjectId" value="@Model.SelectedSubjectId" />
        <h2 class="h4 mb-3">@L10n.Format("Add a term to {0}", Model.SubjectName)</h2>
        <div class="row g-3"><div class="col-md-5"><label class="form-label" for="term">@L10n.T("Technical term")</label><input id="term" name="term" class="form-control" maxlength="100" required /></div>
        <div class="col-md-5"><label class="form-label" for="spokenForms">@L10n.T("Spoken forms")</label><input id="spokenForms" name="spokenForms" class="form-control" maxlength="1000" placeholder="@L10n.T("Separate alternatives with semicolons")" /></div>
        <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">@L10n.T("Save term")</button></div></div>
    </form>
    <section class="panel overflow-hidden"><div class="panel-header"><h2>@L10n.T("Glossary terms") <small class="text-muted">@Model.Terms.Count</small></h2></div>
        @if (Model.Terms.Count == 0) { <div class="empty-state"><h3>@L10n.T("No terms yet")</h3><p>@L10n.Format("Add terminology used in {0}.", Model.SubjectName)</p></div> }
        else { <div class="table-responsive"><table class="table data-table"><thead><tr><th>@L10n.T("Term")</th><th>@L10n.T("Recognized spoken forms")</th><th class="text-end">@L10n.T("Actions")</th></tr></thead><tbody>
            @foreach (var item in Model.Terms) { <tr><td><strong>@item.Term</strong></td><td>@(item.SpokenForms.Count == 0 ? "—" : string.Join(" · ", item.SpokenForms))</td><td class="text-end"><form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('@L10n.T("Remove this glossary term?")')"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="subjectId" value="@Model.SelectedSubjectId" /><button class="btn btn-light btn-sm text-danger">@L10n.T("Remove")</button></form></td></tr> }
        </tbody></table></div> }
    </section>
}

@model AIVES.WebRazor.Pages.Exams.ExamFormPageModel
@{
    var editing = Model.Input.Id is not null;
    var title = editing ? L10n.T("Edit exam") : L10n.T("New exam");
}
<div class="page-heading"><div><span class="page-kicker">Exams / @(editing ? "Edit" : "New")</span><h1>@title</h1><p>@L10n.T("Questions are drawn from the active questions of the chosen subject (and topic). Saving assigns a fresh set to every candidate.")</p></div></div>
<div class="panel form-panel mb-4"><form method="post">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <input asp-for="Input.Id" type="hidden" />
    <section class="form-section"><div class="section-title"><span class="section-number">1</span><div><h2>@L10n.T("Exam")</h2><p>@L10n.T("Name the session and choose where its questions come from.")</p></div></div>
        <div class="row g-3">
            <div class="col-12"><label asp-for="Input.Title" class="form-label">@L10n.T("Title")</label><input asp-for="Input.Title" class="form-control" maxlength="@ExamLimits.TitleMaxLength" /></div>
            <div class="col-md-6"><label asp-for="Input.SubjectId" class="form-label">@L10n.T("Subject")</label><select asp-for="Input.SubjectId" class="form-select"><option value="0">@L10n.T("Choose a subject")</option>@foreach (var subject in Model.Subjects) { <option value="@subject.Id">@subject.Name</option> }</select></div>
            <div class="col-md-6"><label asp-for="Input.TopicId" class="form-label">@L10n.T("Topic")</label><select asp-for="Input.TopicId" class="form-select"><option value="">@L10n.T("Any topic")</option>@foreach (var topic in Model.Topics) { <option value="@topic.Id" data-subject="@topic.SubjectId">@topic.Name</option> }</select></div>
            <div class="col-md-6"><label asp-for="Input.Term" class="form-label">@L10n.T("Term / semester")</label><input asp-for="Input.Term" class="form-control" maxlength="@ExamLimits.TermMaxLength" /></div>
            <div class="col-md-6"><label asp-for="Input.ExamType" class="form-label">@L10n.T("Examination type")</label><input asp-for="Input.ExamType" class="form-control" maxlength="@ExamLimits.ExamTypeMaxLength" /></div>
        </div>
    </section>
    <section class="form-section"><div class="section-title"><span class="section-number">2</span><div><h2>@L10n.T("Schedule")</h2><p>@L10n.T("Candidates sit one after another; each slot follows the previous one.")</p></div></div><div class="row g-3">
        <div class="col-md-6"><label asp-for="Input.StartsAtLocal" class="form-label">@L10n.T("First slot starts") (@Model.TimeZoneLabel)</label><input asp-for="Input.StartsAtLocal" type="datetime-local" value="@Model.Input.StartsAtLocal?.ToString("yyyy-MM-ddTHH:mm")" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Input.EndsAtLocal" class="form-label">@L10n.T("Exam ends") (@Model.TimeZoneLabel)</label><input asp-for="Input.EndsAtLocal" type="datetime-local" value="@Model.Input.EndsAtLocal?.ToString("yyyy-MM-ddTHH:mm")" class="form-control" /><div class="form-text">@L10n.T("The window all slots must fit into. Leave empty to end with the last slot.")</div></div>
        <div class="col-md-6"><label asp-for="Input.SlotMinutes" class="form-label">@L10n.T("Minutes per candidate")</label><input asp-for="Input.SlotMinutes" type="number" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Input.BufferMinutes" class="form-label">@L10n.T("Buffer between candidates (minutes)")</label><input asp-for="Input.BufferMinutes" type="number" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Input.BreakMinutes" class="form-label">@L10n.T("Break length (minutes)")</label><input asp-for="Input.BreakMinutes" type="number" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Input.BreakEveryCount" class="form-label">@L10n.T("Break after every N candidates")</label><input asp-for="Input.BreakEveryCount" type="number" class="form-control" /></div>
    </div></section>
    <section class="form-section"><div class="section-title"><span class="section-number">3</span><div><h2>@L10n.T("Questions per candidate")</h2><p>@L10n.T("Main questions are fixed per candidate; follow-up questions are the most the examiner may add.")</p></div></div><div class="row g-3">
        <div class="col-md-6"><label asp-for="Input.Strategy" class="form-label">@L10n.T("Question selection strategy")</label><select asp-for="Input.Strategy" asp-items="Html.GetEnumSelectList<QuestionSelectionStrategy>()" class="form-select"></select></div>
        <div class="col-md-6"><label asp-for="Input.MainQuestionCount" class="form-label">@L10n.T("Main questions")</label><input asp-for="Input.MainQuestionCount" type="number" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Input.MaxFollowUpQuestions" class="form-label">@L10n.T("Maximum follow-up questions")</label><input asp-for="Input.MaxFollowUpQuestions" type="number" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Input.MaxFollowUpsPerQuestion" class="form-label">@L10n.T("Follow-ups per question")</label><input asp-for="Input.MaxFollowUpsPerQuestion" type="number" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Input.AnswerTimeLimitSeconds" class="form-label">@L10n.T("Answer time limit (seconds)")</label><input asp-for="Input.AnswerTimeLimitSeconds" type="number" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="Input.Language" class="form-label">@L10n.T("Interview language")</label><select asp-for="Input.Language" asp-items="@(new SelectList(Model.Languages))" class="form-select"></select></div>
        <div class="col-md-6"><label asp-for="Input.Recording" class="form-label">@L10n.T("Recording")</label><select asp-for="Input.Recording" asp-items="Html.GetEnumSelectList<RecordingMode>()" class="form-select"></select></div>
    </div></section>
    <section class="form-section"><div class="section-title"><span class="section-number">4</span><div><h2>@L10n.T("Candidates")</h2><p>@L10n.T("Paste one email per line, or separate addresses with commas or semicolons.")</p></div></div>
        <label asp-for="Input.CandidateEmails" class="form-label">@L10n.T("Candidate email addresses")</label><textarea asp-for="Input.CandidateEmails" rows="7" class="form-control"></textarea>
    </section>
    <section class="form-section"><label asp-for="Input.Instructions" class="form-label">@L10n.T("Instructions")</label><textarea asp-for="Input.Instructions" rows="3" class="form-control"></textarea>
        <div class="form-check mt-3"><input asp-for="Input.ScheduleOverflowAllowed" class="form-check-input" /><label asp-for="Input.ScheduleOverflowAllowed" class="form-check-label">@L10n.T("Allow the schedule to run beyond the exam end time")</label></div>
    </section>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">@L10n.T("Save")</button><a asp-page="Index" class="btn btn-light">@L10n.T("Cancel")</a></div>
</form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

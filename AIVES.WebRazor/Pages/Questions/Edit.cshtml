@page "/Question/Edit/{id:int}"
@model AIVES.WebRazor.Pages.Questions.EditModel
@{
    ViewData["Title"] = $"Sửa câu hỏi #{Model.Id}";
}
<div class="page-heading">
    <div>
        <span class="page-kicker">Ngân hàng câu hỏi</span>
        <h1>Sửa câu hỏi #@Model.Id</h1>
        <p>Nếu đồng nghiệp cũng đang mở câu hỏi này, bạn sẽ thấy tên họ ở đây.</p>
    </div>
    <a asp-page="Details" asp-route-id="@Model.Id" class="btn btn-light">Xem chi tiết</a>
</div>

<div class="editors-banner" data-editors-banner hidden role="status">
    <span class="live-dot" style="background:#e0a422"></span>
    <span data-editors-text></span>
</div>
<div class="stale-banner" data-stale-banner hidden role="alert"></div>

<form method="post" class="panel form-panel" data-question-form data-question-id="@Model.Id" data-my-name="@AivesHub.DisplayName(User)">
    <partial name="_QuestionFields" model="Model" />
    <div class="form-actions">
        <a asp-page="Index" class="btn btn-light">Huỷ</a>
        <button type="submit" class="btn btn-primary" data-save>Lưu thay đổi</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.querySelector('[data-question-form]');
            const questionId = Number(form.dataset.questionId);
            const myName = form.dataset.myName;
            const editorsBanner = document.querySelector('[data-editors-banner]');
            const editorsText = document.querySelector('[data-editors-text]');
            const staleBanner = document.querySelector('[data-stale-banner]');
            const live = window.aivesLive;
            if (!live) return;

            const join = () => live.connection.invoke('JoinQuestion', questionId).catch((error) => console.warn(error));
            live.ready.then(join, () => {});
            // A reconnect gets a new connection id, which is in no group yet.
            document.addEventListener('aives:reconnected', join);

            document.addEventListener('aives:editors', (event) => {
                if (event.detail.questionId !== questionId) return;
                const others = event.detail.editors.filter((name) => name !== myName);
                editorsBanner.hidden = others.length === 0;
                editorsText.textContent = others.length === 0 ? '' :
                    `${others.join(', ')} cũng đang mở câu hỏi này. Ai lưu sau sẽ ghi đè thay đổi của người lưu trước.`;
            });

            document.addEventListener('aives:entity-changed', (event) => {
                const change = event.detail;
                if (change.entity !== 'question' || change.id !== questionId) return;
                if (change.actorId === document.body.dataset.userId) return;
                staleBanner.hidden = false;
                if (change.action === 'deleted') {
                    staleBanner.textContent = `${change.actorName} vừa xoá câu hỏi này. Không thể lưu nữa.`;
                    form.querySelector('[data-save]').disabled = true;
                    live.connection.invoke('LeaveQuestion', questionId).catch(() => {});
                } else {
                    staleBanner.textContent = `${change.actorName} vừa lưu một phiên bản mới của câu hỏi này. Tải lại trang để xem trước khi lưu, nếu không bạn sẽ ghi đè thay đổi của họ.`;
                }
            });
        })();
    </script>
}

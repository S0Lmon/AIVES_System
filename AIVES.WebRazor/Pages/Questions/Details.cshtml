@page "{id:int}"
@model AIVES.WebRazor.Pages.Questions.DetailsModel
@{
    var question = Model.Question;
    ViewData["Title"] = $"Câu hỏi #{question.Id}";
}
<div class="page-heading">
    <div>
        <span class="page-kicker">Ngân hàng câu hỏi</span>
        <h1>Câu hỏi #@question.Id</h1>
        <p>Cập nhật lần cuối @question.ModifiedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="Edit" asp-route-id="@question.Id" class="btn btn-primary">Sửa</a>
        <a asp-page="Delete" asp-route-id="@question.Id" class="btn btn-warning">Xoá</a>
        <a asp-page="Index" class="btn btn-light">Danh sách</a>
    </div>
</div>
<div class="stale-banner" data-stale-banner hidden role="alert"></div>
<div class="panel panel-body" data-question-id="@question.Id">
    <div class="content-quote mb-4">@question.Content</div>
    <div class="detail-grid">
        <div class="detail-item"><small>Môn học</small>@(question.SubjectName ?? "—")</div>
        <div class="detail-item"><small>Chủ đề</small>@(question.TopicName ?? "—")</div>
        <div class="detail-item"><small>Mức Bloom</small>@question.BloomLevelName</div>
        <div class="detail-item"><small>Độ khó</small>@(question.Difficulty ?? "—")</div>
        <div class="detail-item"><small>Rubric</small>@(question.RubricName ?? "—")</div>
        <div class="detail-item"><small>Trạng thái</small>@(question.IsActive ? "Hoạt động" : "Tạm ẩn")</div>
    </div>
    <h2 class="h6 mt-4">Đáp án mong đợi</h2>
    <p class="mb-0" style="white-space:pre-line">@(string.IsNullOrWhiteSpace(question.ExpectedAnswer) ? "—" : question.ExpectedAnswer)</p>
</div>
@section Scripts {
    <script>
        (() => {
            const questionId = Number(document.querySelector('[data-question-id]').dataset.questionId);
            const banner = document.querySelector('[data-stale-banner]');
            document.addEventListener('aives:entity-changed', (event) => {
                const change = event.detail;
                if (change.entity !== 'question' || change.id !== questionId) return;
                if (change.action === 'deleted') {
                    banner.textContent = `${change.actorName} vừa xoá câu hỏi này.`;
                    banner.hidden = false;
                } else {
                    window.location.reload();
                }
            });
        })();
    </script>
}

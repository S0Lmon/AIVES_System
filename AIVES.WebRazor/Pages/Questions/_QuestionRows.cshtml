@model AIVES.WebRazor.Pages.Questions.IndexModel
<div class="panel-header">
    <h2>@L10n.Format("Showing {0} of {1} questions", Model.Questions.Count, Model.TotalCount)</h2>
</div>
@if (Model.Questions.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">?</div>
        <h3>@L10n.T("No matching questions")</h3>
        <p>@L10n.T("Try clearing the filters or add a new question.")</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table data-table">
            <thead>
                <tr><th>@L10n.T("Question")</th><th>@L10n.T("Subject / topic")</th><th>Bloom</th><th>@L10n.T("Status")</th><th class="text-end">@L10n.T("Actions")</th></tr>
            </thead>
            <tbody>
                @foreach (var question in Model.Questions)
                {
                    <tr>
                        <td>
                            <span class="question-id">#@question.Id</span>
                            <div class="question-title">@(question.Content.Length > 160 ? question.Content[..160] + "…" : question.Content)</div>
                        </td>
                        <td><div>@(question.SubjectName ?? "—")</div><small class="text-muted">@question.TopicName</small></td>
                        <td><span class="badge-soft">@question.BloomLevelName</span></td>
                        <td><span class="status-badge @(question.IsActive ? "active" : "inactive")">@(question.IsActive ? L10n.T("Active") : L10n.T("Hidden"))</span></td>
                        <td>
                            <div class="action-group">
                                <a asp-page="/Questions/Details" asp-route-id="@question.Id" class="btn btn-sm btn-light">@L10n.T("View")</a>
                                <a asp-page="/Questions/Edit" asp-route-id="@question.Id" class="btn btn-sm btn-info">@L10n.T("Edit")</a>
                                <a asp-page="/Questions/Delete" asp-route-id="@question.Id" class="btn btn-sm btn-warning">@L10n.T("Delete")</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

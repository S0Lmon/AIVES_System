@page "/Question/Create"
@model AIVES.WebRazor.Pages.Questions.CreateModel
@{
    ViewData["Title"] = L10n.T("Add question");
}
<div class="page-heading">
    <div>
        <span class="page-kicker">@L10n.T("Question bank")</span>
        <h1>@L10n.T("Add question")</h1>
        <p>@L10n.T("When you save, every lecturer with the question bank open sees the new question straight away.")</p>
    </div>
    <button type="button" class="btn btn-light slide-trigger" data-slide="aiPanel" aria-controls="aiPanel">✦ @L10n.T("Quick generate")</button>
</div>
<form method="post" class="panel form-panel">
    <partial name="_QuestionFields" model="Model" />
    <div class="form-actions">
        <a asp-page="Index" class="btn btn-light">@L10n.T("Cancel")</a>
        <button type="submit" class="btn btn-primary">@L10n.T("Save question")</button>
    </div>
</form>
<partial name="_AiGenerateSlide" model="Model" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ai-slide.js" asp-append-version="true"></script>
}

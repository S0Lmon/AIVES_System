@page "/Question/Create"
@model AIVES.WebRazor.Pages.Questions.CreateModel
@{
    ViewData["Title"] = "Thêm câu hỏi";
}
<div class="page-heading">
    <div>
        <span class="page-kicker">Ngân hàng câu hỏi</span>
        <h1>Thêm câu hỏi</h1>
        <p>Khi lưu, mọi giảng viên đang mở ngân hàng câu hỏi sẽ thấy câu hỏi mới ngay lập tức.</p>
    </div>
    <button type="button" class="btn btn-light slide-trigger" data-slide="aiPanel" aria-controls="aiPanel">✦ @L10n.T("Quick generate")</button>
</div>
<form method="post" class="panel form-panel">
    <partial name="_QuestionFields" model="Model" />
    <div class="form-actions">
        <a asp-page="Index" class="btn btn-light">Huỷ</a>
        <button type="submit" class="btn btn-primary">Lưu câu hỏi</button>
    </div>
</form>
<partial name="_AiGenerateSlide" model="Model" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ai-slide.js" asp-append-version="true"></script>
}

@page "/Question/Delete/{id:int}"
@model AIVES.WebRazor.Pages.Questions.DeleteModel
@{
    ViewData["Title"] = $"Xoá câu hỏi #{Model.Question.Id}";
}
<div class="panel danger-panel">
    <div class="danger-header">
        <h1>Xoá câu hỏi #@Model.Question.Id?</h1>
        <p>Thao tác này không thể hoàn tác. Đồng nghiệp đang mở câu hỏi sẽ được báo ngay.</p>
    </div>
    <div class="panel-body">
        <div class="content-quote mb-4">@Model.Question.Content</div>
        <form method="post" class="d-flex gap-2 justify-content-end">
            <a asp-page="Details" asp-route-id="@Model.Question.Id" class="btn btn-light">Huỷ</a>
            <button type="submit" class="btn btn-danger">Xoá vĩnh viễn</button>
        </form>
    </div>
</div>

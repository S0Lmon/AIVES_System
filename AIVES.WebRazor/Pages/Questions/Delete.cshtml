@page "/Question/Delete/{id:int}"
@model AIVES.WebRazor.Pages.Questions.DeleteModel
@{
    ViewData["Title"] = L10n.Format("Delete question #{0}", Model.Question.Id);
}
<div class="panel danger-panel">
    <div class="danger-header">
        <h1>@L10n.Format("Delete question #{0}?", Model.Question.Id)</h1>
        <p>@L10n.T("This cannot be undone. Colleagues who have the question open are told straight away.")</p>
    </div>
    <div class="panel-body">
        <div class="content-quote mb-4">@Model.Question.Content</div>
        <form method="post" class="d-flex gap-2 justify-content-end">
            <a asp-page="Details" asp-route-id="@Model.Question.Id" class="btn btn-light">@L10n.T("Cancel")</a>
            <button type="submit" class="btn btn-danger">@L10n.T("Delete permanently")</button>
        </form>
    </div>
</div>

@page
@model AIVES.WebRazor.Pages.Admin.UsersModel
@{
    ViewData["Title"] = L10n.T("Users");
}
<div class="page-heading">
    <div><span class="page-kicker">Admin / Users</span><h1>@L10n.T("User management")</h1><p>@L10n.T("New accounts start as students. Promote lecturers here so they can manage the question bank, rubrics and catalogue.")</p></div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-light" asp-page="/Admin/Subjects">@L10n.T("Lecturers per subject")</a>
        <a class="btn btn-light" asp-page="/Admin/Settings">@L10n.T("Speech & recording settings")</a>
        <a class="btn btn-light" asp-page="/Admin/Audit">@L10n.T("Audit log")</a>
    </div>
</div>
<div class="mb-3" style="max-width:360px">
    <input id="userFilter" type="search" class="form-control" placeholder="@L10n.T("Filter by name or email")" aria-label="@L10n.T("Filter by name or email")" />
</div>
@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert alert-success" role="status">@Model.Message</div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
<section class="panel overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table data-table">
            <thead><tr><th scope="col">@L10n.T("Account")</th><th scope="col">@L10n.T("Verified")</th><th scope="col">@L10n.T("Created")</th><th scope="col">@L10n.T("Role")</th><th scope="col" class="text-end">@L10n.T("Change role")</th></tr></thead>
            <tbody id="userRows">
                <partial name="_UserRows" model="Model" />
            </tbody>
        </table>
    </div>
</section>
<script>
    (function () {
        var input = document.getElementById('userFilter');
        var region = document.getElementById('userRows');
        var online = new Set();

        // Re-applied after every live refresh, which replaces the rows.
        var applyFilter = function () {
            var term = input.value.trim().toLowerCase();
            region.querySelectorAll('[data-user-row]').forEach(function (row) {
                row.hidden = term.length > 0 && row.dataset.userRow.indexOf(term) < 0;
            });
        };
        var applyPresence = function () {
            region.querySelectorAll('[data-user-id]').forEach(function (row) {
                row.querySelector('.user-online').hidden = !online.has(row.dataset.userId);
            });
        };
        var refresh = function () {
            window.refreshRegion(region, 'Rows').then(function () { applyFilter(); applyPresence(); });
        };

        input.addEventListener('input', applyFilter);
        document.addEventListener('aives:presence', function (event) {
            online = new Set(event.detail.map(function (user) { return user.userId; }));
            applyPresence();
        });
        document.addEventListener('aives:user-changed', refresh);
        document.addEventListener('aives:reconnected', refresh);
    })();
</script>
<p class="small text-muted">@L10n.T("Administrators are set with AdminAccess:Emails (ADMIN_EMAIL in .env) and also have lecturer access. A role change applies to the user's open sessions within a minute.")</p>

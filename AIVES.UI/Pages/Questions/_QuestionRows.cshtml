@model AIVES.WebRazor.Pages.Questions.IndexModel
<div class="panel-header">
    <h2>Hiển thị @Model.Questions.Count / @Model.TotalCount câu hỏi</h2>
</div>
@if (Model.Questions.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">?</div>
        <h3>Không có câu hỏi phù hợp</h3>
        <p>Thử bỏ bộ lọc hoặc thêm câu hỏi mới.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table data-table">
            <thead>
                <tr><th>Câu hỏi</th><th>Môn / chủ đề</th><th>Bloom</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr>
            </thead>
            <tbody>
                @foreach (var question in Model.Questions)
                {
                    <tr>
                        <td>
                            <span class="question-id">#@question.Id</span>
                            <div class="question-title">@(question.Content.Length > 160 ? question.Content[..160] + "…" : question.Content)</div>
                        </td>
                        <td><div>@(question.SubjectName ?? "—")</div><small class="text-muted">@question.TopicName</small></td>
                        <td><span class="badge-soft">@question.BloomLevelName</span></td>
                        <td><span class="status-badge @(question.IsActive ? "active" : "inactive")">@(question.IsActive ? "Hoạt động" : "Tạm ẩn")</span></td>
                        <td>
                            <div class="action-group">
                                <a asp-page="/Questions/Details" asp-route-id="@question.Id" class="btn btn-sm btn-light">Xem</a>
                                <a asp-page="/Questions/Edit" asp-route-id="@question.Id" class="btn btn-sm btn-info">Sửa</a>
                                <a asp-page="/Questions/Delete" asp-route-id="@question.Id" class="btn btn-sm btn-warning">Xoá</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

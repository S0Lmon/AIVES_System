@model AIVES.DTO.ExamDetailsDto
@inject AIVES.WebMVC.DisplayTimeZone TimeZone
@{
    ViewData["Title"] = Model.Title;
    var started = Model.HasStarted(DateTime.UtcNow);
    string ReasonLabel(AIVES.DTO.FollowUpReason reason) => reason switch
    {
        AIVES.DTO.FollowUpReason.Sufficient => L10n.T("answer sufficient"),
        AIVES.DTO.FollowUpReason.Vague => L10n.T("answer vague"),
        AIVES.DTO.FollowUpReason.Missing => L10n.T("key points missing"),
        AIVES.DTO.FollowUpReason.Contradiction => L10n.T("contradiction"),
        AIVES.DTO.FollowUpReason.OffTopic => L10n.T("off topic"),
        AIVES.DTO.FollowUpReason.LimitReached => L10n.T("follow-up limit reached"),
        AIVES.DTO.FollowUpReason.NoAnswer => L10n.T("no answer given"),
        _ => L10n.T("AI unavailable, moved on")
    };
}

<div class="page-heading">
    <div>
        <span class="page-kicker">Exams / Details</span>
        <h1>@Model.Title</h1>
        <p>
            @Model.SubjectName@(Model.TopicName is null ? "" : " / " + Model.TopicName) ·
            @TimeZone.ToLocal(Model.StartsAtUtc).ToString("yyyy-MM-dd HH:mm") – @TimeZone.ToLocal(Model.EndsAtUtc).ToString("HH:mm") (@TimeZone.OffsetLabel) ·
            @L10n.Format("{0} min per candidate", Model.SlotMinutes) ·
            @L10n.Format("{0} main question(s), up to {1} follow-up(s)", Model.MainQuestionCount, Model.MaxFollowUpQuestions)
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (!started)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light">@L10n.T("Edit")</a>
            <form method="post" asp-action="Reassign" asp-route-id="@Model.Id" class="d-inline">
                <button type="submit" class="btn btn-light">@L10n.T("Draw new questions")</button>
            </form>
        }
        else
        {
            <span class="status-label warning">@L10n.T("Locked: the exam has started")</span>
        }
        <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="d-inline" onsubmit="return confirm('@L10n.T("Delete this exam and its schedule?")');">
            <button type="submit" class="btn btn-outline-danger">@L10n.T("Delete")</button>
        </form>
    </div>
</div>

@if (TempData["ExamMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
@if (TempData["ExamWarning"] is string warning)
{
    <div class="alert alert-warning" role="status">@warning</div>
}
@if (TempData["ExamError"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<section class="panel overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table data-table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">@L10n.T("Slot") (@TimeZone.OffsetLabel)</th>
                    <th scope="col">@L10n.T("Candidate")</th>
                    <th scope="col">@L10n.T("Main questions")</th>
                    <th scope="col">@L10n.T("Viva")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var candidate in Model.Candidates)
                {
                    <tr>
                        <td>@candidate.Order</td>
                        <td class="small text-nowrap">@TimeZone.ToLocal(candidate.StartsAtUtc).ToString("HH:mm") – @TimeZone.ToLocal(candidate.EndsAtUtc).ToString("HH:mm")</td>
                        <td>
                            <strong>@(candidate.DisplayName ?? candidate.Email)</strong>
                            <div class="small text-muted">@candidate.Email</div>
                            @if (candidate.DisplayName is null)
                            {
                                <span class="badge text-bg-light">@L10n.T("No account yet")</span>
                            }
                        </td>
                        <td>
                            <ol class="mb-0 ps-3">
                                @foreach (var question in candidate.Questions)
                                {
                                    <li class="mb-1"><span class="badge text-bg-light me-1">@question.BloomLevelName</span>@question.Content</li>
                                }
                            </ol>
                        </td>
                        <td>
                            @if (candidate.Interview is null)
                            {
                                <span class="small text-muted">@L10n.T("Not started")</span>
                            }
                            else
                            {
                                var record = candidate.Interview;
                                <span class="status-label @(record.Status == AIVES.DTO.InterviewStatus.Completed ? "ready" : "warning")">@(record.Status == AIVES.DTO.InterviewStatus.Completed ? L10n.T("Completed") : L10n.T("In progress"))</span>
                                <details class="mt-2">
                                    <summary class="small">@L10n.Format("Transcript ({0} turns)", record.Turns.Count)</summary>
                                    <ol class="small mt-2 ps-3 mb-0">
                                        @foreach (var turn in record.Turns)
                                        {
                                            <li class="mb-2">
                                                <strong>@(turn.Kind == AIVES.DTO.TurnKind.FollowUp ? L10n.T("Follow-up") : L10n.Format("Main question {0}", turn.MainIndex)):</strong> @turn.QuestionText
                                                <div class="mt-1">
                                                    @if (string.IsNullOrEmpty(turn.Answer))
                                                    {
                                                        <em class="text-muted">@(turn.AnsweredAtUtc is null ? L10n.T("Waiting for the answer") : L10n.T("No answer"))</em>
                                                    }
                                                    else
                                                    {
                                                        <span>@turn.Answer</span>
                                                    }
                                                </div>
                                                <div class="text-muted">
                                                    @if (turn.InputMode == AIVES.DTO.AnswerInputMode.Typed) { <span class="badge text-bg-light">@L10n.T("Typed")</span> }
                                                    @if (turn.TimedOut) { <span class="badge text-bg-warning">@L10n.T("Over time")</span> }
                                                    @if (turn.Decision is { } decision) { <span class="badge text-bg-light">@L10n.T("Examiner"): @ReasonLabel(decision)</span> }
                                                </div>
                                            </li>
                                        }
                                    </ol>
                                </details>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<a asp-action="Index" class="btn btn-light">@L10n.T("Back to exams")</a>

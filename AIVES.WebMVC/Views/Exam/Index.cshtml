@model AIVES.WebMVC.Models.ViewModels.ExamIndexViewModel
@inject AIVES.WebMVC.DisplayTimeZone TimeZone
@{
    ViewData["Title"] = @L10n.T("Exams");
    var now = DateTime.UtcNow;
}

<div class="page-heading">
    <div>
        <span class="page-kicker">Exams / Schedule</span>
        <h1>@L10n.T("Viva exam sessions")</h1>
        <p>@L10n.T("Each candidate gets a time slot and their own set of main questions, drawn so that candidates sitting one after another do not share questions.")</p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <a asp-action="Create" class="btn btn-primary">@L10n.T("New exam")</a>
    </div>
</div>

@if (TempData["ExamMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

<section class="panel overflow-hidden mb-4">
    @if (Model.Exams.Count == 0)
    {
        <p class="p-4 mb-0 text-muted">@L10n.T("No exams yet. Create one to schedule candidates and assign questions.")</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th scope="col">@L10n.T("Exam")</th>
                        <th scope="col">@L10n.T("Subject")</th>
                        <th scope="col">@L10n.T("Time") (@TimeZone.OffsetLabel)</th>
                        <th scope="col">@L10n.T("Candidates")</th>
                        <th scope="col">@L10n.T("Status")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exam in Model.Exams)
                    {
                        var start = TimeZone.ToLocal(exam.StartsAtUtc);
                        var end = TimeZone.ToLocal(exam.EndsAtUtc);
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@exam.Id"><strong>@exam.Title</strong></a></td>
                            <td>@exam.SubjectName@(exam.TopicName is null ? "" : " / " + exam.TopicName)</td>
                            <td class="small">@start.ToString("yyyy-MM-dd HH:mm") – @end.ToString("HH:mm")<div class="text-muted">@L10n.Format("{0} min per candidate", exam.SlotMinutes)</div></td>
                            <td>@exam.CandidateCount</td>
                            <td>
                                @if (now < exam.StartsAtUtc)
                                {
                                    <span class="status-label ready">@L10n.T("Upcoming")</span>
                                }
                                else if (now < exam.EndsAtUtc)
                                {
                                    <span class="status-label warning">@L10n.T("In progress")</span>
                                }
                                else
                                {
                                    <span class="status-label">@L10n.T("Finished")</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

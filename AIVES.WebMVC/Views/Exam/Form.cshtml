@model AIVES.WebMVC.Models.ViewModels.ExamFormViewModel
@using AIVES.WebMVC.Models.ViewModels
@{
    var editing = Model.Id is not null;
    ViewData["Title"] = editing ? @L10n.T("Edit exam") : @L10n.T("New exam");
}

<div class="page-heading">
    <div>
        <span class="page-kicker">Exams / @(editing ? "Edit" : "New")</span>
        <h1>@(editing ? L10n.T("Edit exam") : L10n.T("New exam"))</h1>
        <p>@L10n.T("Questions are drawn from the active questions of the chosen subject (and topic). Saving assigns a fresh set to every candidate.")</p>
    </div>
</div>

<div class="panel form-panel mb-4">
    <form method="post" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id">
        <div asp-validation-summary="All" class="alert alert-danger"></div>

        <section class="form-section">
            <div class="section-title"><span class="section-number">1</span><div><h2>@L10n.T("Exam")</h2><p>@L10n.T("Name the session and choose where its questions come from.")</p></div></div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Title" class="form-label">@L10n.T("Title")</label>
                    <input asp-for="Title" class="form-control" maxlength="@AIVES.DTO.ExamLimits.TitleMaxLength" />
                </div>
                <div class="col-md-6">
                    @await Html.PartialAsync("_CatalogPicker", CatalogPickers.Subject(Model.Subjects, "SubjectId", L10n.T("Subject"), L10n.T("Choose a subject"), Model.SubjectId == 0 ? null : Model.SubjectId, required: true, id: "examSubject"))
                </div>
                <div class="col-md-6">
                    @await Html.PartialAsync("_CatalogPicker", CatalogPickers.Topic(Model.Topics, "TopicId", L10n.T("Topic"), L10n.T("Any topic"), Model.TopicId, id: "examTopic", subjects: Model.Subjects))
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title"><span class="section-number">2</span><div><h2>@L10n.T("Schedule")</h2><p>@L10n.T("Candidates sit one after another; each slot follows the previous one.")</p></div></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="StartsAtLocal" class="form-label">@L10n.T("First slot starts") (@Model.TimeZoneLabel)</label>
                    <input asp-for="StartsAtLocal" type="datetime-local" class="form-control" value="@(Model.StartsAtLocal?.ToString("yyyy-MM-ddTHH:mm"))" />
                </div>
                <div class="col-md-6">
                    <label asp-for="SlotMinutes" class="form-label">@L10n.T("Minutes per candidate")</label>
                    <input asp-for="SlotMinutes" type="number" min="@AIVES.DTO.ExamLimits.MinSlotMinutes" max="@AIVES.DTO.ExamLimits.MaxSlotMinutes" class="form-control" />
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title"><span class="section-number">3</span><div><h2>@L10n.T("Questions per candidate")</h2><p>@L10n.T("Main questions are fixed per candidate; follow-up questions are the most the examiner may add.")</p></div></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="MainQuestionCount" class="form-label">@L10n.T("Main questions")</label>
                    <input asp-for="MainQuestionCount" type="number" min="1" max="@AIVES.DTO.ExamLimits.MaxMainQuestions" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="MaxFollowUpQuestions" class="form-label">@L10n.T("Maximum follow-up questions")</label>
                    <input asp-for="MaxFollowUpQuestions" type="number" min="0" max="@AIVES.DTO.ExamLimits.MaxFollowUpQuestions" class="form-control" />
                    <div class="form-text">@L10n.T("In total for one candidate.")</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="MaxFollowUpsPerQuestion" class="form-label">@L10n.T("Follow-ups per question")</label>
                    <input asp-for="MaxFollowUpsPerQuestion" type="number" min="0" max="@AIVES.DTO.ExamLimits.MaxFollowUpsPerQuestionLimit" class="form-control" />
                    <div class="form-text">@L10n.T("How many times the AI may probe one main question.")</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="AnswerTimeLimitSeconds" class="form-label">@L10n.T("Answer time limit (seconds)")</label>
                    <input asp-for="AnswerTimeLimitSeconds" type="number" min="@AIVES.DTO.ExamLimits.MinAnswerSeconds" max="@AIVES.DTO.ExamLimits.MaxAnswerSeconds" class="form-control" />
                    <div class="form-text">@L10n.T("For each question, including follow-ups. The answer is submitted automatically when time runs out.")</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Language" class="form-label">@L10n.T("Interview language")</label>
                    <select asp-for="Language" class="form-select">
                        @if (Model.EnabledLanguages.Contains(AIVES.DTO.AppLanguage.Vi)) { <option value="@AIVES.DTO.AppLanguage.Vi">Tiếng Việt</option> }
                        @if (Model.EnabledLanguages.Contains(AIVES.DTO.AppLanguage.En)) { <option value="@AIVES.DTO.AppLanguage.En">English</option> }
                    </select>
                    <div class="form-text">@L10n.T("Used to read questions aloud, recognise answers and write follow-ups.")</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Recording" class="form-label">@L10n.T("Record the viva")</label>
                    <select asp-for="Recording" class="form-select">
                        <option value="@AIVES.DTO.RecordingMode.Audio">@L10n.T("Audio of every answer")</option>
                        <option value="@AIVES.DTO.RecordingMode.AudioVideo">@L10n.T("Audio and camera video")</option>
                        <option value="@AIVES.DTO.RecordingMode.None">@L10n.T("Do not record")</option>
                    </select>
                    <div class="form-text">@L10n.T("Kept encrypted as evidence for grade appeals. Students must agree before they start; only you and administrators can play it.")</div>
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="section-title"><span class="section-number">4</span><div><h2>@L10n.T("Candidates")</h2><p>@L10n.T("One email per line, in sitting order. Students see their slot under My exams once they sign in with the same email.")</p></div></div>
            <label asp-for="CandidateEmails" class="form-label">@L10n.T("Candidate emails")</label>
            <textarea asp-for="CandidateEmails" rows="8" class="form-control" placeholder="student1@fpt.edu.vn&#10;student2@fpt.edu.vn"></textarea>
        </section>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">@(editing ? L10n.T("Save and reassign questions") : L10n.T("Create exam"))</button>
            <a asp-action="@(editing ? "Details" : "Index")" asp-route-id="@Model.Id" class="btn btn-light">@L10n.T("Cancel")</a>
        </div>
    </form>
</div>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }

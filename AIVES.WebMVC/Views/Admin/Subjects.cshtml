@model AIVES.WebMVC.Models.ViewModels.SubjectAssignmentsViewModel
@{ ViewData["Title"] = L10n.T("Lecturers per subject"); }

<div class="page-heading">
    <div>
        <span class="page-kicker">Admin / Subjects</span>
        <h1>@L10n.T("Lecturers per subject")</h1>
        <p>@L10n.T("Only the lecturers ticked for a subject can create exams for it. A subject with nobody ticked stays open to every lecturer.")</p>
    </div>
    <a class="btn btn-light" asp-action="Users">@L10n.T("Users")</a>
</div>

@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert alert-success" role="status">@Model.Message</div> }

@if (Model.Subjects.Count == 0)
{
    <p class="text-muted">@L10n.T("No subjects yet. Create them in the catalogue first.")</p>
}
@if (Model.Lecturers.Count == 0)
{
    <div class="alert alert-info">@L10n.T("There are no lecturer accounts yet. Promote users to Lecturer on the Users page.")</div>
}

@foreach (var subject in Model.Subjects)
{
    var assigned = subject.Lecturers.Select(lecturer => lecturer.Id).ToHashSet();
    <form method="post" asp-action="Subjects" class="panel p-4 mb-3">
        <input type="hidden" name="subjectId" value="@subject.SubjectId" />
        <div class="d-flex justify-content-between flex-wrap gap-2 mb-2">
            <h2 class="h6 mb-0">@subject.SubjectName</h2>
            <span class="small @(assigned.Count == 0 ? "text-muted" : "")">@(assigned.Count == 0 ? L10n.T("Open to every lecturer") : L10n.Format("{0} lecturer(s) assigned", assigned.Count))</span>
        </div>
        <div class="d-flex flex-wrap gap-3 mb-2">
            @foreach (var lecturer in Model.Lecturers)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="lecturerIds" value="@lecturer.Id" id="s@(subject.SubjectId)-@lecturer.Id" checked="@assigned.Contains(lecturer.Id)" />
                    <label class="form-check-label small" for="s@(subject.SubjectId)-@lecturer.Id">@(string.IsNullOrWhiteSpace(lecturer.DisplayName) ? lecturer.Email : lecturer.DisplayName + " (" + lecturer.Email + ")")</label>
                </div>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary">@L10n.T("Save")</button>
            <a class="btn btn-sm btn-light" asp-controller="Glossary" asp-action="Index" asp-route-subjectId="@subject.SubjectId">@L10n.T("Subject terms for speech recognition")</a>
        </div>
    </form>
}

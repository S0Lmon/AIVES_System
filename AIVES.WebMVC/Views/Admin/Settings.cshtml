@model AIVES.WebMVC.Models.ViewModels.SpeechSettingsViewModel
@{ ViewData["Title"] = L10n.T("Speech & recording settings"); }

<div class="page-heading">
    <div>
        <span class="page-kicker">Admin / Settings</span>
        <h1>@L10n.T("Speech & recording settings")</h1>
        <p>@L10n.T("Languages the AI examiner can use for text-to-speech and speech recognition, how it reads, and how long recordings are kept.")</p>
    </div>
    <a class="btn btn-light" asp-action="Users">@L10n.T("Users")</a>
</div>

@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert alert-success" role="status">@Model.Message</div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert-danger" role="alert">@Model.Error</div> }

<form method="post" asp-action="Settings" class="panel p-4 mb-4" style="max-width:760px">
    <h2 class="h6">@L10n.T("Interview languages")</h2>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" asp-for="EnableVietnamese" />
        <label class="form-check-label" asp-for="EnableVietnamese">Tiếng Việt (vi-VN)</label>
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" asp-for="EnableEnglish" />
        <label class="form-check-label" asp-for="EnableEnglish">English (en-US)</label>
    </div>
    <label class="form-label" asp-for="DefaultLanguage">@L10n.T("Default language for new exams")</label>
    <select class="form-select mb-3" asp-for="DefaultLanguage" style="max-width:260px">
        <option value="@AIVES.DTO.AppLanguage.Vi">Tiếng Việt</option>
        <option value="@AIVES.DTO.AppLanguage.En">English</option>
    </select>

    <h2 class="h6 mt-4">@L10n.T("Text-to-speech")</h2>
    <label class="form-label" asp-for="SpeechRate">@L10n.T("Speaking rate (0.6 – 1.4, 1 is normal)")</label>
    <input class="form-control mb-3" asp-for="SpeechRate" type="number" step="0.05" min="0.6" max="1.4" style="max-width:160px" />
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label" asp-for="VietnameseVoice">@L10n.T("Preferred Vietnamese voice (optional)")</label>
            <input class="form-control" asp-for="VietnameseVoice" list="voiceList" placeholder="Microsoft HoaiMy Online (Natural)" />
        </div>
        <div class="col-md-6">
            <label class="form-label" asp-for="EnglishVoice">@L10n.T("Preferred English voice (optional)")</label>
            <input class="form-control" asp-for="EnglishVoice" list="voiceList" placeholder="Google US English" />
        </div>
    </div>
    <datalist id="voiceList"></datalist>
    <div class="form-text mb-3">@L10n.T("Voices come from the student's browser. When the named voice is missing, the best voice for the language is used. The list offers the voices of this browser.")</div>
    <button type="button" class="btn btn-sm btn-light mb-3" id="testVoice">@L10n.T("Listen to a sample")</button>

    <h2 class="h6 mt-4">@L10n.T("Recordings")</h2>
    <label class="form-label" asp-for="RecordingRetentionDays">@L10n.T("Delete recordings after (days)")</label>
    <input class="form-control mb-1" asp-for="RecordingRetentionDays" type="number" min="7" max="3650" style="max-width:160px" />
    <div class="form-text mb-3">@L10n.T("Recordings are encrypted at rest, can only be played by the exam's lecturer and administrators (each playback is logged), and are deleted automatically after this period.")</div>

    <button type="submit" class="btn btn-primary">@L10n.T("Save")</button>
</form>

<script>
    (function () {
        if (!window.speechSynthesis) return;
        function fill() {
            var list = document.getElementById('voiceList');
            list.innerHTML = '';
            speechSynthesis.getVoices().forEach(function (voice) {
                var option = document.createElement('option');
                option.value = voice.name;
                option.label = voice.lang;
                list.appendChild(option);
            });
        }
        fill();
        speechSynthesis.onvoiceschanged = fill;
        document.getElementById('testVoice').addEventListener('click', function () {
            var vi = document.getElementById('DefaultLanguage').value === 'Vi';
            var utterance = new SpeechSynthesisUtterance(vi ? 'Xin chào, tôi là giám khảo ảo. Câu hỏi thứ nhất.' : 'Hello, I am the virtual examiner. Question one.');
            utterance.lang = vi ? 'vi-VN' : 'en-US';
            utterance.rate = parseFloat(document.getElementById('SpeechRate').value) || 1;
            var name = document.getElementById(vi ? 'VietnameseVoice' : 'EnglishVoice').value;
            var voice = speechSynthesis.getVoices().find(function (v) { return v.name === name; });
            if (voice) utterance.voice = voice;
            speechSynthesis.cancel();
            speechSynthesis.speak(utterance);
        });
    })();
</script>

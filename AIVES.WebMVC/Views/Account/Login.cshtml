@model AIVES.WebMVC.Models.ViewModels.LoginViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = @L10n.T("Sign in"); }
<section class="auth-grid">
    <div class="auth-context"><span class="page-kicker">Secure access / AIVES</span><h1>@L10n.T("Resume your academic workspace")</h1><p>@L10n.T("Access the question bank, AI exam room and assessment records with your verified account.")</p><dl><div><dt>01</dt><dd>@L10n.T("Email is verified before sign in")</dd></div><div><dt>02</dt><dd>@L10n.T("Temporary lock after repeated failed attempts")</dd></div><div><dt>03</dt><dd>@L10n.T("Google OAuth never shares your password with AIVES")</dd></div></dl></div>
    <form asp-action="Login" method="post" class="panel auth-form">
        <input asp-for="ReturnUrl" type="hidden" />
        <div class="auth-form-head"><span class="page-kicker">Account</span><h2>@L10n.T("Sign in")</h2><p>@L10n.T("Use the Gmail account you registered with.")</p></div>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3"><label asp-for="Email" class="form-label">Gmail</label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@gmail.com" /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label">@L10n.T("Password")</label><input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="@L10n.T("Enter your password")" /><span asp-validation-for="Password" class="text-danger small"></span></div>
        <label class="auth-check"><input asp-for="RememberMe" /> <span>@L10n.T("Keep me signed in on this device")</span></label>
        <button type="submit" class="btn btn-primary auth-submit">@L10n.T("Sign in")</button>
        <div class="auth-divider"><span>@L10n.T("or")</span></div>
        <button type="submit" asp-action="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-light auth-submit">@L10n.T("Sign in with Google")</button>
        <p class="auth-switch">@L10n.T("No account yet?") <a asp-action="Register">@L10n.T("Register with Gmail")</a></p>
    </form>
</section>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
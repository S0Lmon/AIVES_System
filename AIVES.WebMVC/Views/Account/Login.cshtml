@model AIVES.WebMVC.Models.ViewModels.LoginViewModel
@{ Layout = "_AuthLayout"; ViewData["Title"] = "Đăng nhập"; }
<section class="auth-grid">
    <div class="auth-context"><span class="page-kicker">Secure access / AIVES</span><h1>Tiếp tục phiên làm việc học thuật</h1><p>Truy cập ngân hàng câu hỏi, phòng thi AI và hồ sơ đánh giá bằng tài khoản đã xác minh.</p><dl><div><dt>01</dt><dd>Email được xác minh trước khi đăng nhập</dd></div><div><dt>02</dt><dd>Khóa tạm thời khi thử sai nhiều lần</dd></div><div><dt>03</dt><dd>Google OAuth không chia sẻ mật khẩu với AIVES</dd></div></dl></div>
    <form asp-action="Login" method="post" class="panel auth-form">
        <input asp-for="ReturnUrl" type="hidden" />
        <div class="auth-form-head"><span class="page-kicker">Account</span><h2>Đăng nhập</h2><p>Nhập tài khoản Gmail đã đăng ký.</p></div>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="mb-3"><label asp-for="Email" class="form-label">Gmail</label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="tenban@gmail.com" /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label">Mật khẩu</label><input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" /><span asp-validation-for="Password" class="text-danger small"></span></div>
        <label class="auth-check"><input asp-for="RememberMe" /> <span>Ghi nhớ đăng nhập trên thiết bị này</span></label>
        <button type="submit" class="btn btn-primary auth-submit">Đăng nhập</button>
        <div class="auth-divider"><span>hoặc</span></div>
        <button type="submit" asp-action="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-light auth-submit" disabled="@(!Model.IsGoogleConfigured)">Đăng nhập với Google</button>
        @if (!Model.IsGoogleConfigured) { <p class="auth-config-note">Google OAuth chưa được cấu hình.</p> }
        <p class="auth-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký bằng Gmail</a></p>
    </form>
</section>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }

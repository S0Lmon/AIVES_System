@model AIVES.DTO.ExamGradingDto
@inject AIVES.WebMVC.DisplayTimeZone TimeZone
@using AIVES.DTO
@{
    ViewData["Title"] = Model.Title;
    var finalized = Model.Rows.Count(row => row.FinalizedAtUtc is not null);
    var finished = Model.Rows.Count(row => row.InterviewStatus == InterviewStatus.Completed);
}

<div class="page-heading">
    <div>
        <span class="page-kicker">Grading / Exam</span>
        <h1>@Model.Title</h1>
        <p>@Model.SubjectName@(Model.TopicName is null ? "" : " / " + Model.TopicName) · @TimeZone.ToLocal(Model.StartsAtUtc).ToString("yyyy-MM-dd HH:mm") ·
            @L10n.Format("{0} of {1} vivas finished, {2} grades confirmed", finished, Model.Rows.Count, finalized)</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-light" asp-action="Report" asp-route-id="@Model.ExamId">@L10n.T("Class report")</a>
        <a class="btn btn-light" asp-action="Export" asp-route-id="@Model.ExamId">@L10n.T("Grade sheet (.xlsx)")</a>
        <a class="btn btn-light" asp-action="Audit" asp-route-id="@Model.ExamId">@L10n.T("Audit log")</a>
    </div>
</div>

<section class="panel overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table data-table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">@L10n.T("Candidate")</th>
                    <th scope="col">@L10n.T("Viva")</th>
                    <th scope="col">@L10n.T("AI proposal")</th>
                    <th scope="col">@L10n.T("Final grade")</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.Order</td>
                        <td>
                            <strong>@(row.DisplayName ?? row.Email)</strong>
                            <div class="small text-muted">@row.Email@(row.StudentCode is null ? "" : " · " + row.StudentCode)</div>
                        </td>
                        <td>
                            @switch (row.InterviewStatus)
                            {
                                case InterviewStatus.Completed: <span class="status-label ready">@L10n.T("Completed")</span> break;
                                case InterviewStatus.InProgress: <span class="status-label warning">@L10n.T("In progress")</span> break;
                                default: <span class="small text-muted">@L10n.T("Not started")</span> break;
                            }
                        </td>
                        <td>
                            @if (row.InterviewStatus != InterviewStatus.Completed)
                            {
                                <span class="small text-muted">—</span>
                            }
                            else if (row.GradingStatus == GradingStatus.Pending)
                            {
                                <span class="small text-muted">@L10n.T("AI grading…")</span>
                            }
                            else if (row.GradingStatus == GradingStatus.AiFailed && row.AiScore10 is null)
                            {
                                <span class="status-label missing">@L10n.T("AI could not grade")</span>
                            }
                            else
                            {
                                <span>@row.AiScore10?.ToString("0.##") / 10</span>
                            }
                        </td>
                        <td>
                            @if (row.FinalScore is { } final)
                            {
                                <strong>@final.ToString("0.##") / 10</strong>
                            }
                            else if (row.InterviewStatus == InterviewStatus.Completed)
                            {
                                <span class="status-label warning">@L10n.T("To review")</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (row.InterviewStatus != InterviewStatus.NotStarted)
                            {
                                <a class="btn btn-sm @(row.FinalScore is null ? "btn-primary" : "btn-light")" asp-action="Candidate" asp-route-id="@row.CandidateId">
                                    @(row.FinalScore is null ? L10n.T("Review & grade") : L10n.T("View"))
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<a asp-action="Index" class="btn btn-light">@L10n.T("Back")</a>

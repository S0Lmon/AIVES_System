@model AIVES.WebMVC.Models.ViewModels.QuestionViewModel
@{ ViewData["Title"] = @L10n.T("Edit question"); }

<div class="page-heading form-panel"><div><span class="page-kicker">@L10n.Format("Question #{0}", Model.Id)</span><h1>@L10n.T("Edit question")</h1><p>@L10n.T("Refine the content or update its evaluation settings.")</p></div></div>
<form asp-action="Edit" method="post" class="panel form-panel">
    <input type="hidden" asp-for="Id" /><div asp-validation-summary="ModelOnly" class="alert alert-danger m-4 mb-0"></div>
    <section class="form-section"><div class="section-title"><span class="section-number">1</span><div><h2>@L10n.T("Question content")</h2><p>@L10n.T("Keep the prompt clear and measurable.")</p></div></div>
        <div class="mb-4"><label asp-for="Content" class="form-label">@L10n.T("Viva question") <span class="text-danger">*</span></label><textarea asp-for="Content" class="form-control" rows="5"></textarea><span asp-validation-for="Content" class="text-danger small"></span></div>
        <div><label asp-for="ExpectedAnswer" class="form-label">@L10n.T("Expected answer / key points")</label><textarea asp-for="ExpectedAnswer" class="form-control" rows="4"></textarea><span asp-validation-for="ExpectedAnswer" class="text-danger small"></span></div>
    </section>
    <section class="form-section"><div class="section-title"><span class="section-number">2</span><div><h2>@L10n.T("Assessment & organization")</h2><p>@L10n.T("Update taxonomy, rubric and classification.")</p></div></div>
        <div class="row g-4 mb-4"><div class="col-md-6"><label asp-for="BloomLevelId" class="form-label">@L10n.T("Bloom level")</label><select asp-for="BloomLevelId" asp-items="ViewBag.BloomLevels" class="form-select"><option value="">@L10n.T("Select a Bloom level")</option></select><span asp-validation-for="BloomLevelId" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="RubricId" class="form-label">@L10n.T("Scoring rubric")</label><select asp-for="RubricId" asp-items="ViewBag.Rubrics" class="form-select"><option value="">@L10n.T("Select a rubric")</option></select><span asp-validation-for="RubricId" class="text-danger small"></span></div><div class="col-md-8"><label asp-for="Context" class="form-label">@L10n.T("Subject / topic")</label><input asp-for="Context" class="form-control" /><span asp-validation-for="Context" class="text-danger small"></span></div><div class="col-md-4"><label asp-for="DisplayOrder" class="form-label">@L10n.T("Display order")</label><input asp-for="DisplayOrder" type="number" min="0" class="form-control" /><span asp-validation-for="DisplayOrder" class="text-danger small"></span></div></div>
        <div class="switch-row"><div><strong>@L10n.T("Active question")</strong><small>@L10n.T("Available for use in examinations")</small></div><div class="form-check form-switch m-0"><input asp-for="IsActive" class="form-check-input" /></div></div>
    </section>
    <div class="form-actions"><a asp-action="Index" class="btn btn-light">@L10n.T("Cancel")</a><button type="submit" class="btn btn-primary">@L10n.T("Save changes") →</button></div>
</form>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
@model AIVES.WebMVC.Models.ViewModels.QuestionViewModel
@{
    ViewData["Title"] = @L10n.T("Edit question");
    var subjects = (IReadOnlyList<AIVES.WebMVC.Models.ViewModels.SubjectOption>)(ViewBag.Subjects ?? Array.Empty<AIVES.WebMVC.Models.ViewModels.SubjectOption>());
    var topics = (IReadOnlyList<AIVES.WebMVC.Models.ViewModels.TopicOption>)(ViewBag.Topics ?? Array.Empty<AIVES.WebMVC.Models.ViewModels.TopicOption>());
}

<form asp-action="Edit" method="post" class="panel form-panel">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger m-4 mb-0"></div>

    <section class="form-section">
        <div class="section-title"><span class="section-number">1</span><div><h2>@L10n.T("Question content")</h2><p>@L10n.T("Keep the prompt clear and measurable.")</p></div></div>
        <div class="mb-4"><label asp-for="Content" class="form-label">@L10n.T("Viva question") <span class="text-danger">*</span></label><textarea asp-for="Content" class="form-control" rows="5"></textarea><span asp-validation-for="Content" class="text-danger small"></span></div>
        <div><label asp-for="ExpectedAnswer" class="form-label">@L10n.T("Expected answer / key points")</label><textarea asp-for="ExpectedAnswer" class="form-control" rows="4"></textarea><span asp-validation-for="ExpectedAnswer" class="text-danger small"></span></div>
    </section>

    <section class="form-section">
        <div class="section-title"><span class="section-number">2</span><div><h2>@L10n.T("Where it belongs")</h2><p>@L10n.T("Link the question to the catalogue so it can be found by subject and topic.")</p></div></div>
        <div class="picker-pair">
            @await Html.PartialAsync("_CatalogPicker", AIVES.WebMVC.Models.ViewModels.CatalogPickers.Subject(subjects, "SubjectId", L10n.T("Subject"), L10n.T("No subject"), Model.SubjectId, id: "editSubject"))
            @await Html.PartialAsync("_CatalogPicker", AIVES.WebMVC.Models.ViewModels.CatalogPickers.Topic(topics, "TopicId", L10n.T("Topic"), L10n.T("No topic"), Model.TopicId, id: "editTopic", subjects: subjects))
        </div>
        <div class="mt-3"><label asp-for="Context" class="form-label">@L10n.T("Note")</label><input asp-for="Context" class="form-control" maxlength="300" placeholder="@L10n.T("Optional free text for context")" /><span asp-validation-for="Context" class="text-danger small"></span></div>
    </section>

    <section class="form-section">
        <div class="section-title"><span class="section-number">3</span><div><h2>@L10n.T("Assessment & organization")</h2><p>@L10n.T("Update the Bloom level, rubric and display order.")</p></div></div>
        <div class="row g-4 mb-4">
            <div class="col-md-6"><label asp-for="BloomLevelId" class="form-label">@L10n.T("Bloom level")</label><select asp-for="BloomLevelId" asp-items="ViewBag.BloomLevels" class="form-select"><option value="">@L10n.T("Select a Bloom level")</option></select><span asp-validation-for="BloomLevelId" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="RubricId" class="form-label">@L10n.T("Scoring rubric")</label><select asp-for="RubricId" asp-items="ViewBag.Rubrics" class="form-select"><option value="">@L10n.T("No rubric")</option></select><span asp-validation-for="RubricId" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="DisplayOrder" class="form-label">@L10n.T("Display order")</label><input asp-for="DisplayOrder" type="number" min="0" class="form-control" /><span asp-validation-for="DisplayOrder" class="text-danger small"></span></div>
        </div>
        <div class="switch-row"><div><strong>@L10n.T("Active question")</strong><small>@L10n.T("Available for use in examinations")</small></div><div class="form-check form-switch m-0"><input asp-for="IsActive" class="form-check-input" /></div></div>
    </section>

    <div class="form-actions"><a asp-action="Index" asp-route-tab="bank" class="btn btn-light">@L10n.T("Cancel")</a><button type="submit" class="btn btn-primary">@L10n.T("Save changes") →</button></div>
</form>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }

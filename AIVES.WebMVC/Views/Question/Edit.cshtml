@model AIVES.WebMVC.Models.ViewModels.QuestionViewModel
@{ ViewData["Title"] = "Edit Question"; }

<div class="page-heading form-panel"><div><span class="page-kicker">Question #@Model.Id</span><h1>Edit question</h1><p>Refine the content or update its evaluation settings.</p></div></div>
<form asp-action="Edit" method="post" class="panel form-panel">
    <input type="hidden" asp-for="Id" /><div asp-validation-summary="ModelOnly" class="alert alert-danger m-4 mb-0"></div>
    <section class="form-section"><div class="section-title"><span class="section-number">1</span><div><h2>Question content</h2><p>Keep the prompt clear and measurable.</p></div></div>
        <div class="mb-4"><label asp-for="Content" class="form-label">Question prompt <span class="text-danger">*</span></label><textarea asp-for="Content" class="form-control" rows="5"></textarea><span asp-validation-for="Content" class="text-danger small"></span></div>
        <div><label asp-for="ExpectedAnswer" class="form-label">Expected answer / key points</label><textarea asp-for="ExpectedAnswer" class="form-control" rows="4"></textarea><span asp-validation-for="ExpectedAnswer" class="text-danger small"></span></div>
    </section>
    <section class="form-section"><div class="section-title"><span class="section-number">2</span><div><h2>Assessment & organization</h2><p>Update taxonomy, rubric and classification.</p></div></div>
        <div class="row g-4 mb-4"><div class="col-md-6"><label asp-for="BloomLevelId" class="form-label">Bloom taxonomy level</label><select asp-for="BloomLevelId" asp-items="ViewBag.BloomLevels" class="form-select"><option value="">Select a level</option></select><span asp-validation-for="BloomLevelId" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="RubricId" class="form-label">Scoring rubric</label><select asp-for="RubricId" asp-items="ViewBag.Rubrics" class="form-select"><option value="">Select a rubric</option></select><span asp-validation-for="RubricId" class="text-danger small"></span></div><div class="col-md-8"><label asp-for="Context" class="form-label">Subject or context</label><input asp-for="Context" class="form-control" /><span asp-validation-for="Context" class="text-danger small"></span></div><div class="col-md-4"><label asp-for="DisplayOrder" class="form-label">Display order</label><input asp-for="DisplayOrder" type="number" min="0" class="form-control" /><span asp-validation-for="DisplayOrder" class="text-danger small"></span></div></div>
        <div class="switch-row"><div><strong>Active question</strong><small>Available for use in examinations</small></div><div class="form-check form-switch m-0"><input asp-for="IsActive" class="form-check-input" /></div></div>
    </section>
    <div class="form-actions"><a asp-action="Index" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-primary">Save changes →</button></div>
</form>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }

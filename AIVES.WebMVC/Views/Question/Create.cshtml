@model AIVES.WebMVC.Models.ViewModels.QuestionViewModel
@{ ViewData["Title"] = @L10n.T("Create question"); }

<div class="page-heading form-panel"><div><span class="page-kicker">@L10n.T("Question bank")</span><h1>@L10n.T("Create a viva question")</h1><p>@L10n.T("Write a clear question and attach its Bloom level and scoring rubric.")</p></div><span class="ai-assist-chip">✦ @L10n.T("Can be generated with AI")</span></div>
<form asp-action="Create" method="post" class="panel form-panel">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger m-4 mb-0"></div>
    <section class="form-section">
        <div class="section-title"><span class="section-number">1</span><div><h2>@L10n.T("Question content")</h2><p>@L10n.T("Enter the main question and the ideas the answer should cover.")</p></div></div>
        <div class="mb-4"><label asp-for="Content" class="form-label">@L10n.T("Viva question") <span class="text-danger">*</span></label><textarea asp-for="Content" class="form-control" rows="5" placeholder="@L10n.T("Example: Explain polymorphism and give one real world example.")"></textarea><span asp-validation-for="Content" class="text-danger small"></span><div class="form-text">@L10n.T("At least 10 characters. A good question targets one assessable capability.")</div></div>
        <div><label asp-for="ExpectedAnswer" class="form-label">@L10n.T("Expected answer / key points")</label><textarea asp-for="ExpectedAnswer" class="form-control" rows="4" placeholder="@L10n.T("List the concepts and key points the student should cover...")"></textarea><span asp-validation-for="ExpectedAnswer" class="text-danger small"></span></div>
    </section>
    <section class="form-section">
        <div class="section-title"><span class="section-number">2</span><div><h2>@L10n.T("Assessment setup")</h2><p>@L10n.T("Choose the Bloom level and how the answer will be scored.")</p></div></div>
        <div class="row g-4"><div class="col-md-6"><label asp-for="BloomLevelId" class="form-label">@L10n.T("Bloom level") <span class="text-danger">*</span></label><select asp-for="BloomLevelId" asp-items="ViewBag.BloomLevels" class="form-select"><option value="">@L10n.T("Select a Bloom level")</option></select><span asp-validation-for="BloomLevelId" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="RubricId" class="form-label">@L10n.T("Scoring rubric") <span class="text-danger">*</span></label><select asp-for="RubricId" asp-items="ViewBag.Rubrics" class="form-select"><option value="">@L10n.T("Select a rubric")</option></select><span asp-validation-for="RubricId" class="text-danger small"></span></div></div>
    </section>
    <section class="form-section">
        <div class="section-title"><span class="section-number">3</span><div><h2>@L10n.T("Classification & status")</h2><p>@L10n.T("Attach a subject, topic and display order.")</p></div></div>
        <div class="row g-4 mb-4"><div class="col-md-8"><label asp-for="Context" class="form-label">@L10n.T("Subject / topic")</label><input asp-for="Context" class="form-control" placeholder="@L10n.T("Example: Object oriented programming")" /><span asp-validation-for="Context" class="text-danger small"></span></div><div class="col-md-4"><label asp-for="DisplayOrder" class="form-label">@L10n.T("Display order")</label><input asp-for="DisplayOrder" type="number" class="form-control" min="0" /><span asp-validation-for="DisplayOrder" class="text-danger small"></span></div></div>
        <div class="switch-row"><div><strong>@L10n.T("Publish to the official bank")</strong><small>@L10n.T("This question can be used in an examination")</small></div><div class="form-check form-switch m-0"><input asp-for="IsActive" class="form-check-input" type="checkbox" /></div></div>
    </section>
    <div class="form-actions"><a asp-action="Index" class="btn btn-light">@L10n.T("Cancel")</a><button type="submit" class="btn btn-primary">@L10n.T("Save question") →</button></div>
</form>
@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
@model AIVES.WebMVC.Models.ViewModels.AiReviewViewModel
@{
    // Shared by the AI tab and the Bulk tab: tick the rows worth keeping, then save them.
    var returnTab = ViewData["ReviewReturnTab"] as string ?? "ai";
    var payload = Model.HasResult && Model.ResultJson is not null
        ? Model.ResultJson
        : AIVES.WebMVC.Models.ViewModels.GeneratedQuestionJson.Serialize(
            Model.Results.Select(result => new AIVES.WebMVC.Models.ViewModels.GeneratedQuestionInput
            {
                Content = result.Content,
                ExpectedAnswer = result.ExpectedAnswer,
                BloomLevel = result.BloomLevel,
                Difficulty = result.Difficulty,
                FollowUpQuestions = result.FollowUpQuestions
            }));
}

<form method="post" asp-action="InsertReviewed" class="panel form-panel mb-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnTab" value="@returnTab" />
    <input type="hidden" name="resultJson" id="resultJson" value="@payload" />
    @* The catalogue picks live on the form above, so carry them into the save. *@
    <input type="hidden" name="subjectId" value="@Model.SubjectId" />
    <input type="hidden" name="topicId" value="@Model.TopicId" />

    <div class="panel-header mb-3">
        <div>
            <h2>@L10n.T("Review before saving")</h2>
            <small class="text-muted">@L10n.Format("{0} questions generated. Untick anything you do not want in the bank.", Model.Results.Count) @L10n.T("Edit the wording, expected answer or Bloom level before saving.")</small>
        </div>
        @if (Model.Sources.Count > 0)
        {
            <span class="badge text-bg-light">@L10n.Format("Grounded in {0} material items", Model.Sources.Count)</span>
        }
    </div>

    @if (Model.Results.Count == 0)
    {
        <p class="text-muted">@L10n.T("Nothing was generated yet.")</p>
    }

    @for (var index = 0; index < Model.Results.Count; index++)
    {
        var position = index;
        var result = Model.Results[position];
        <div class="review-row" data-review-row>
            <div class="review-head">
                <textarea name="content" class="form-control review-content" rows="2" aria-label="@L10n.T("Question")">@result.Content</textarea>
                <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" name="pick" value="@position" id="pick-@position" checked
                           data-review-toggle />
                    <label class="form-check-label small" for="pick-@position">@L10n.T("Keep")</label>
                </div>
            </div>
            <div class="review-meta">
                @* Bloom is the level the question will be stored under. Difficulty is editable here
                   because when it was left blank the model guessed it, and a wrong guess is cheaper to
                   correct now than after it is in the bank. One select per row, in row order, so the
                   save action can zip the values back onto the generated batch by index. *@
                <select name="bloom" class="form-select form-select-sm review-difficulty" aria-label="@L10n.T("Bloom level")">
                    @foreach (var level in AIVES.DTO.BloomLevels.All)
                    {
                        <option value="@level" selected="@(string.Equals(level, result.BloomLevel, StringComparison.OrdinalIgnoreCase))">@level</option>
                    }
                </select>
                <select name="difficulty" class="form-select form-select-sm review-difficulty" aria-label="@L10n.T("Difficulty")">
                    <option value="">@L10n.T("Not set")</option>
                    @foreach (var difficulty in AIVES.DTO.QuestionDifficulties.Ordered)
                    {
                        <option value="@difficulty" selected="@(difficulty == result.Difficulty)">@difficulty</option>
                    }
                </select>
            </div>
            <textarea name="expectedAnswer" class="form-control form-control-sm review-answer mt-2" rows="2" placeholder="@L10n.T("Expected answer")" aria-label="@L10n.T("Expected answer")">@result.ExpectedAnswer</textarea>
            @if (result.FollowUpQuestions.Count > 0)
            {
                <ul class="review-followups">
                    @foreach (var followUp in result.FollowUpQuestions)
                    {
                        <li>@followUp</li>
                    }
                </ul>
            }
        </div>
    }

    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-end mt-3">
        <label class="form-label mb-0 me-2" for="reviewRubric">@L10n.T("Attach rubric")</label>
        <select id="reviewRubric" name="rubricId" class="form-select form-select-sm" style="max-width: 260px">
            <option value="">@L10n.T("No rubric")</option>
            @foreach (var rubric in Model.RubricOptions)
            {
                <option value="@rubric.Id">@rubric.Name</option>
            }
        </select>
        <a class="btn btn-light" asp-action="Index" asp-route-tab="@returnTab">@L10n.T("Start over")</a>
        <button type="submit" class="btn btn-primary" disabled="@(Model.Results.Count == 0)">@L10n.T("Save and insert")</button>
    </div>
</form>
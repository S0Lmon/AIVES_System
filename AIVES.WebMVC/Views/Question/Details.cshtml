@model AIVES.WebMVC.Models.ViewModels.QuestionViewModel
@{
    ViewData["Title"] = @L10n.T("Question details");
}

<div class="page-heading">
    <div><span class="page-kicker">@L10n.Format("Question #{0}", Model.Id)</span>
        <h1>@L10n.T("Question details")</h1>
        <p>@L10n.T("Review the complete assessment setup.")</p>
    </div>
    <div class="d-flex gap-2"><a asp-action="Index" class="btn btn-light">← @L10n.T("Back")</a><a asp-action="Edit"
                                                                                                      asp-route-id="@Model.Id" class="btn btn-primary">@L10n.T("Edit question")</a></div>
    </div>
    <div class="panel">
        <div class="panel-header">
            <h2>@L10n.T("Viva question")</h2><span
            class="status-badge @(Model.IsActive ? "active" : "inactive")">@(Model.IsActive? @L10n.T("● Active") :
@L10n.T("○ Hidden"))</span>
        </div>
        <div class="panel-body">
                        <div class="content-quote mb-4">@Model.Content</div>
            @if (!string.IsNullOrWhiteSpace(Model.ExpectedAnswer))
                {
                    <div class="mb-4"><span class="page-kicker">@L10n.T("Expected answer")</span>
                        <div class="detail-item" style="white-space:pre-line">@Model.ExpectedAnswer</div>
                    </div>
                }

            <div class="detail-grid mb-4">
                <div class="detail-item"><small>@L10n.T("Bloom level")</small>
                    <spanclass="badge-soft">@Model.BloomLevelName</span>
                    </div>
                   
                    <div class="detail-item"><small>@L10n.T("Scoring rubric")</small><strong>@Model.RubricName</strong></div>
                    <div class="detail-item"><small>@L10n.T("Subject / topic")</small><strong>@(string.IsNullOrWhiteSpace(Model.Context) ? @L10n.T("Not specified") :
                                                                                                                                            Model.Context)</strong></div>
                        <div class="detail-item"><small>@L10n.T("Display order")</small><strong>@Model.DisplayOrder</strong></div>
                    </div>
                    <div class="d-flex flex-wrap justify-content-between gap-3 text-muted small"><span>@L10n.Format("Created {0}",
                                                                                                                                        Model.CreatedDate.ToString("dd MMM yyyy, HH:mm"))</span><span>@L10n.Format("Updated {0}",
                                                                                                                                        Model.ModifiedDate.ToString("dd MMM yyyy, HH:mm"))</span></div>
                    </div>
                </div>
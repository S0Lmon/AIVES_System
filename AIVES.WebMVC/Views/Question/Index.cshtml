@model AIVES.WebMVC.Models.ViewModels.QuestionBankViewModel
@{
    ViewData["Title"] = L10n.T("Question bank");
}

<nav class="bank-tabs" aria-label="@L10n.T("Question sections")">
    <a class="bank-tab @(Model.ActiveTab == AIVES.WebMVC.Models.ViewModels.QuestionTabs.Bank ? "is-active" : "")" asp-action="Index" asp-route-tab="bank">@L10n.T("Question bank")</a>
    <a class="bank-tab @(Model.ActiveTab == AIVES.WebMVC.Models.ViewModels.QuestionTabs.Create ? "is-active" : "")" asp-action="Index" asp-route-tab="create">@L10n.T("Create")</a>
    <a class="bank-tab @(Model.ActiveTab == AIVES.WebMVC.Models.ViewModels.QuestionTabs.Ai ? "is-active" : "")" asp-action="Index" asp-route-tab="ai">@L10n.T("AI generation")</a>
    <a class="bank-tab @(Model.ActiveTab == AIVES.WebMVC.Models.ViewModels.QuestionTabs.Bulk ? "is-active" : "")" asp-action="Index" asp-route-tab="bulk">@L10n.T("Bulk generation")</a>
</nav>

@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

@switch (Model.ActiveTab)
{
    case AIVES.WebMVC.Models.ViewModels.QuestionTabs.Create:
        ViewData["BloomLevels"] = Model.BloomLevels;
        ViewData["Rubrics"] = Model.Rubrics;
        ViewData["Subjects"] = Model.Subjects;
        ViewData["Topics"] = Model.Topics;
        <partial name="_QuestionCreateTab" model="Model.Editor" />
        break;

    case AIVES.WebMVC.Models.ViewModels.QuestionTabs.Ai:
        <partial name="_QuestionAiTab" model="Model" />
        break;

    case AIVES.WebMVC.Models.ViewModels.QuestionTabs.Bulk:
        <partial name="_QuestionBulkTab" model="Model" />
        break;

    default:
        <partial name="_QuestionBankTab" model="Model" />
        break;
}

@section Scripts {
    @await Html.PartialAsync("_AiSlideScripts")
    <script>
        // Untick a row in the review list and it fades back, so it is obvious what will be saved.
        (function () {
            document.querySelectorAll('[data-review-toggle]').forEach(function (toggle) {
                var row = toggle.closest('[data-review-row]');
                if (!row) return;
                var apply = function () { row.classList.toggle('is-off', !toggle.checked); };
                toggle.addEventListener('change', apply);
                apply();
            });
        }());
    </script>
}
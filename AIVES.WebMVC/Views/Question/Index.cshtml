@model IEnumerable<AIVES.WebMVC.Models.ViewModels.QuestionViewModel>
@{ ViewData["Title"] = "Ngân hàng câu hỏi"; var questions = Model.ToList(); }
<div class="page-heading"><div><span class="page-kicker">Assessment library</span><h1>Ngân hàng câu hỏi</h1><p>Quản lý câu hỏi vấn đáp, mức độ nhận thức và rubric đánh giá.</p></div><a asp-action="Create" class="btn btn-primary">Tạo câu hỏi</a></div>
@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
<div class="panel overflow-hidden"><div class="panel-header"><div><h2>Tất cả câu hỏi</h2><small class="text-muted">@questions.Count câu hỏi trong cơ sở dữ liệu</small></div><span class="status-badge active">Đã kết nối SQL</span></div>
@if (questions.Any()) { <div class="table-responsive"><table class="table data-table"><thead><tr><th>ID</th><th>Câu hỏi</th><th>Chủ đề</th><th>Mức Bloom</th><th>Rubric</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
@foreach (var item in questions) { <tr><td data-label="ID"><span class="question-id">#@item.Id.ToString("D3")</span></td><td data-label="Câu hỏi"><div class="question-title" title="@item.Content">@(item.Content.Length > 80 ? item.Content[..80] + "…" : item.Content)</div><small class="text-muted">Tạo ngày @item.CreatedDate.ToString("dd/MM/yyyy")</small></td><td data-label="Chủ đề">@(string.IsNullOrWhiteSpace(item.Context) ? "—" : item.Context)</td><td data-label="Mức Bloom"><span class="badge-soft">@item.BloomLevelName</span></td><td data-label="Rubric">@item.RubricName</td><td data-label="Trạng thái"><span class="status-badge @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? "Hoạt động" : "Tạm ẩn")</span></td><td data-label="Thao tác"><div class="action-group"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light">Xem</a><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light">Sửa</a><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger">Xóa</a></div></td></tr> }
</tbody></table></div> } else { <div class="empty-state"><div class="empty-icon">QB</div><h3>Ngân hàng chưa có câu hỏi</h3><p>Tạo câu hỏi vấn đáp có cấu trúc đầu tiên để bắt đầu.</p><a asp-action="Create" class="btn btn-primary">Tạo câu hỏi đầu tiên</a></div> }</div>

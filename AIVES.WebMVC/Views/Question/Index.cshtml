@model IEnumerable<AIVES.WebMVC.Models.ViewModels.QuestionViewModel>
@{ ViewData["Title"] = @L10n.T("Question bank"); var questions = Model.ToList(); }
<div class="page-heading"><div><span class="page-kicker">Assessment library</span><h1>@L10n.T("Question bank")</h1><p>@L10n.T("Manage viva questions, Bloom taxonomy levels and scoring rubrics.")</p></div><a asp-action="Create" class="btn btn-primary">@L10n.T("Create question")</a></div>
@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
<div class="panel overflow-hidden"><div class="panel-header"><div><h2>@L10n.T("All questions")</h2><small class="text-muted">@L10n.Format("{0} questions in the database", questions.Count)</small></div></div>
@if (questions.Any()) { <div class="table-responsive"><table class="table data-table"><thead><tr><th>ID</th><th>@L10n.T("Question")</th><th>@L10n.T("Topic")</th><th>@L10n.T("Bloom level")</th><th>Rubric</th><th>@L10n.T("Status")</th><th class="text-end">@L10n.T("Actions")</th></tr></thead><tbody>
@foreach (var item in questions) { <tr><td data-label="ID"><span class="question-id">#@item.Id.ToString("D3")</span></td><td data-label="@L10n.T("Question")"><div class="question-title" title="@item.Content">@(item.Content.Length > 80 ? item.Content[..80] + "…" : item.Content)</div><small class="text-muted">@L10n.Format("Created {0}", item.CreatedDate.ToString("dd/MM/yyyy"))</small></td><td data-label="@L10n.T("Topic")">@(string.IsNullOrWhiteSpace(item.Context) ? "—" : item.Context)</td><td data-label="@L10n.T("Bloom level")"><span class="badge-soft">@item.BloomLevelName</span></td><td data-label="Rubric">@item.RubricName</td><td data-label="@L10n.T("Status")"><span class="status-badge @(item.IsActive ? "active" : "inactive")">@(item.IsActive ? @L10n.T("Active") : @L10n.T("Hidden"))</span></td><td data-label="@L10n.T("Actions")"><div class="action-group"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light">@L10n.T("View")</a><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light">@L10n.T("Edit")</a><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger">@L10n.T("Delete")</a></div></td></tr> }
</tbody></table></div> } else { <div class="empty-state"><div class="empty-icon">QB</div><h3>@L10n.T("The bank has no questions yet")</h3><p>@L10n.T("Create your first structured viva question to get started.")</p><a asp-action="Create" class="btn btn-primary">@L10n.T("Create the first question")</a></div> }</div>
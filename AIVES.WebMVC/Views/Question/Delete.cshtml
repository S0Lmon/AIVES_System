@model AIVES.WebMVC.Models.ViewModels.QuestionViewModel
@{ ViewData["Title"] = @L10n.T("Delete question"); }

<div class="panel danger-panel">
    <div class="danger-header"><h1>@L10n.T("Delete this question?")</h1><p>@L10n.T("This action is permanent and cannot be undone.")</p></div>
    <div class="panel-body">
        <span class="page-kicker">@L10n.Format("Question #{0}", Model.Id)</span><div class="content-quote mb-4">@Model.Content</div>
        <div class="detail-grid mb-4"><div class="detail-item"><small>@L10n.T("Bloom level")</small><span class="badge-soft">@Model.BloomLevelName</span></div><div class="detail-item"><small>@L10n.T("Scoring rubric")</small><strong>@Model.RubricName</strong></div></div>
        <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2"><input type="hidden" asp-for="Id" /><a asp-action="Index" class="btn btn-light">@L10n.T("Keep question")</a><button type="submit" class="btn btn-danger">@L10n.T("Yes, delete permanently")</button></form>
    </div>
</div>
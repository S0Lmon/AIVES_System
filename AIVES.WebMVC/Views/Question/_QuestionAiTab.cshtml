@model AIVES.WebMVC.Models.ViewModels.QuestionBankViewModel
@using AIVES.WebMVC.Models.ViewModels
@{
    var ai = Model.Ai;
}

<div class="panel form-panel mb-3">
    <form method="post" asp-action="GenerateReview">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <section class="form-section">
            <div class="section-title"><span class="section-number">✦</span><div><h2>@L10n.T("Generate one question")</h2><p>@L10n.T("Pick a subject and topic, then review the result before it reaches the bank.")</p></div></div>

            <div class="row g-3">
                <div class="col-md-6">
                    @* Subject and topic are catalogue dropdowns only. The names sent to the model are
                       resolved from these ids, so there is no second free text copy to keep in step. *@
                    @await Html.PartialAsync("_CatalogPicker", CatalogPickers.Subject(ai.Subjects, "SubjectId", L10n.T("Subject"), L10n.T("Choose a subject"), ai.SubjectId, required: true, id: "aiTabSubject"))
                </div>
                <div class="col-md-6">
                    @await Html.PartialAsync("_CatalogPicker", CatalogPickers.Topic(ai.Topics, "TopicId", L10n.T("Topic"), L10n.T("Any topic"), ai.TopicId, id: "aiTabTopic", subjects: ai.Subjects))
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="genBloom">@L10n.T("Bloom level")</label>
                    <select id="genBloom" name="BloomLevelId" class="form-select">
                        <option value="">@L10n.T("Let the AI decide")</option>
                        @foreach (var level in ai.BloomLevels)
                        {
                            <option value="@level.Id" selected="@(level.Id == ai.BloomLevelId)">@level.Name</option>
                        }
                    </select>
                    <div class="form-text">@L10n.T("Leave blank and the AI assigns the level in the review.")</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="genDifficulty">@L10n.T("Difficulty")</label>
                    <select id="genDifficulty" name="Difficulty" class="form-select">
                        <option value="">@L10n.T("Let the AI decide")</option>
                        @foreach (var difficulty in AIVES.DTO.QuestionDifficulties.Ordered)
                        {
                            <option value="@difficulty" selected="@(difficulty == ai.Difficulty)">@difficulty</option>
                        }
                    </select>
                    <div class="form-text">@L10n.T("Leave blank and the AI assigns the difficulty in the review.")</div>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="UseMaterials" value="true" id="genUseMaterials" checked="@ai.UseMaterials" />
                        <label class="form-check-label" for="genUseMaterials">@L10n.T("Ground in catalog material")</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="genOutcomes">@L10n.T("Learning outcomes")</label>
                    <textarea id="genOutcomes" name="LearningOutcomes" rows="3" class="form-control" maxlength="2000" placeholder="@L10n.T("What the candidate should be able to demonstrate")">@ai.LearningOutcomes</textarea>
                </div>
                <div class="col-12">
                    <input type="hidden" name="Provider" value="@(ai.Provider?.ToString())" />
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                <button type="submit" class="btn btn-primary" disabled="@(!(ai.GeminiAvailable || ai.OllamaAvailable))">
                    @(ai.GeminiAvailable || ai.OllamaAvailable ? L10n.T("Generate") : L10n.T("No AI provider available"))
                </button>
                <span class="text-muted small">
                    @if (ai.GeminiAvailable) { <span class="badge text-bg-success me-1">Gemini</span> }
                    @if (ai.OllamaAvailable) { <span class="badge text-bg-secondary me-1">Ollama</span> }
                    @L10n.T("Active provider") <strong>@ai.ActiveProvider</strong>
                </span>
                <a class="btn btn-light btn-sm ms-auto" asp-action="Index" asp-route-tab="bulk">@L10n.T("Need a whole batch? Use bulk")</a>
            </div>
        </section>
    </form>
</div>

@if (ai.HasResult)
{
    ViewData["ReviewReturnTab"] = "ai";
    <partial name="_QuestionReview" model="ai" />
}
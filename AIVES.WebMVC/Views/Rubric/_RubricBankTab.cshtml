@model AIVES.WebMVC.Models.ViewModels.RubricViewModel

<div class="stat-strip">
    <div class="stat"><span class="stat-value">@Model.RubricCount</span><span class="stat-label">@L10n.T("Rubrics")</span></div>
    <div class="stat"><span class="stat-value">@Model.CriteriaCount</span><span class="stat-label">@L10n.T("Criterion rows")</span></div>
    <div class="stat"><span class="stat-value">@Model.LevelCount</span><span class="stat-label">@L10n.T("Level columns")</span></div>
    <div class="stat"><span class="stat-value">@Model.MaxPoints</span><span class="stat-label">@L10n.T("Highest total")</span></div>
</div>

<form method="get" asp-action="Index" class="cat-toolbar-form mb-3">
    <input type="hidden" name="tab" value="bank" />
    <label class="cat-search">
        <span class="visually-hidden">@L10n.T("Search")</span>
        <input type="search" name="search" value="@Model.SubjectFilter" class="form-control form-control-sm"
               placeholder="@L10n.T("Search rubrics or criteria")" />
    </label>
    <button type="submit" class="btn btn-light btn-sm">@L10n.T("Search")</button>
    @if (!string.IsNullOrWhiteSpace(Model.SubjectFilter))
    {
        <a class="btn btn-light btn-sm" asp-action="Index" asp-route-tab="bank">@L10n.T("Clear")</a>
    }
    <span class="cat-toolbar-spacer"></span>
    <a class="btn btn-primary btn-sm" asp-action="Index" asp-route-tab="create">@L10n.T("New rubric")</a>
</form>

<div class="panel overflow-hidden">
    <div class="panel-header">
        <div>
            <h2>@L10n.T("Stored matrices")</h2>
            <small class="text-muted">@L10n.Format("{0} rubrics in the bank", Model.RubricCount)</small>
        </div>
    </div>
    @if (Model.Rubrics.Count == 0)
    {
        <div class="p-4 text-center">
            <p class="mb-1 fw-semibold">@L10n.T("Nothing matched your search")</p>
            <p class="text-muted mb-3">@L10n.T("Build a matrix by hand, or let AI draft one for you.")</p>
            <a class="btn btn-primary" asp-action="Index" asp-route-tab="create">@L10n.T("Create a rubric")</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th>@L10n.T("Rubric")</th>
                        <th>@L10n.T("Levels")</th>
                        <th>@L10n.T("Matrix")</th>
                        <th class="text-end">@L10n.T("Total points")</th>
                        <th class="text-end">@L10n.T("Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rubric in Model.Rubrics)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold d-block">@rubric.Name</span>
                                @if (!string.IsNullOrWhiteSpace(rubric.Description))
                                {
                                    <small class="text-muted">@rubric.Description</small>
                                }
                            </td>
                            <td>
                                @if (rubric.LevelNames.Count == 0)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    @string.Join(" · ", rubric.LevelNames)
                                }
                            </td>
                            <td><span class="text-muted">@L10n.Format("{0} rows × {1} columns", rubric.CriterionCount, rubric.LevelCount)</span></td>
                            <td class="text-end"><span class="font-monospace">@rubric.TotalPoints</span></td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a class="btn btn-light btn-sm" asp-action="Edit" asp-route-id="@rubric.Id">@L10n.T("Edit")</a>
                                    <form method="post" asp-action="Delete" class="d-inline"
                                          onsubmit="return confirm('@L10n.T("Delete this rubric and its whole matrix?")');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@rubric.Id" />
                                        <button type="submit" class="btn btn-light btn-sm text-danger">@L10n.T("Delete")</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
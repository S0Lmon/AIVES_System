@model AIVES.WebMVC.Models.ViewModels.RubricViewModel
@{
    var ai = Model.Ai;
}

<div class="panel form-panel mb-3">
    <form method="post" asp-action="Generate">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <section class="form-section">
            <div class="section-title"><span class="section-number">✦</span><div><h2>@L10n.T("Describe the matrix")</h2><p>@L10n.T("AI drafts the rows and the columns so you only have to correct them.")</p></div></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="aiSubject">@L10n.T("Subject") <span class="text-danger">*</span></label>
                    <input id="aiSubject" name="Subject" value="@ai.Subject" class="form-control" maxlength="120" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="aiTopic">@L10n.T("Topic") <span class="text-danger">*</span></label>
                    <input id="aiTopic" name="Topic" value="@ai.Topic" class="form-control" maxlength="200" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="aiCriterionCount">@L10n.T("Criterion rows")</label>
                    <input id="aiCriterionCount" name="CriterionCount" type="number" min="1" max="10" value="@ai.CriterionCount" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="aiLevelCount">@L10n.T("Level columns")</label>
                    <input id="aiLevelCount" name="LevelCount" type="number" min="2" max="6" value="@ai.LevelCount" class="form-control" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="UseMaterials" value="true" id="aiUseMaterials" checked="@ai.UseMaterials" />
                        <label class="form-check-label" for="aiUseMaterials">@L10n.T("Ground in catalog material")</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label" for="aiOutcomes">@L10n.T("Learning outcomes")</label>
                    <textarea id="aiOutcomes" name="LearningOutcomes" rows="3" class="form-control" maxlength="2000" placeholder="@L10n.T("What the markers should be able to see")">@ai.LearningOutcomes</textarea>
                </div>
                <div class="col-12">
                    <input type="hidden" name="SubjectId" value="@ai.SubjectId" />
                    <input type="hidden" name="TopicId" value="@ai.TopicId" />
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                <button type="submit" class="btn btn-primary" @(ai.GeminiAvailable || ai.OllamaAvailable ? "" : "disabled")>
                    @(ai.GeminiAvailable || ai.OllamaAvailable ? L10n.T("Draft a matrix") : L10n.T("No AI provider available"))
                </button>
                <span class="text-muted small">
                    @if (ai.GeminiAvailable)
                    {
                        <span class="badge text-bg-success me-1">Gemini</span>
                    }
                    @if (ai.OllamaAvailable)
                    {
                        <span class="badge text-bg-secondary me-1">Ollama</span>
                    }
                    @L10n.T("Active provider")
                    <strong>@ai.ActiveProvider</strong>
                </span>
                <a class="btn btn-light btn-sm ms-auto" asp-action="Index" asp-route-tab="create">@L10n.T("Build it by hand instead")</a>
            </div>
        </section>
    </form>
</div>

@if (ai.HasResult)
{
    <div class="alert alert-info d-flex flex-wrap gap-2 align-items-center">
        <span>@L10n.T("Review the draft below, then save it to the bank.")</span>
        @if (ai.Sources.Count > 0)
        {
            <span class="text-muted small">@L10n.Format("Grounded in {0} material items", ai.Sources.Count)</span>
        }
    </div>

    <div class="panel form-panel">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
            <h2 class="mb-0">@ai.Generated.Name</h2>
            <span class="text-muted small">@L10n.Format("{0} rows × {1} columns", ai.Generated.Rows.Count, ai.Generated.Columns.Count)</span>
        </div>
        <partial name="_RubricMatrixEditor" model="ai.Generated" />
    </div>
}
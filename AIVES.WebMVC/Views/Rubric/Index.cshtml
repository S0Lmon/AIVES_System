@model AIVES.WebMVC.Models.ViewModels.RubricViewModel
@{
    ViewData["Title"] = L10n.T("Rubric bank");
}

<div class="page-heading form-panel">
    <div>
        <span class="page-kicker">@L10n.T("Scoring")</span>
        <h1>@L10n.T("Rubric bank")</h1>
        <p>@L10n.T("Build a scoring matrix with your own rows and columns, or let AI draft one for you.")</p>
    </div>
</div>

<nav class="bank-tabs" aria-label="@L10n.T("Rubric sections")">
    <a class="bank-tab @(Model.ActiveTab == AIVES.WebMVC.Models.ViewModels.RubricTabs.Bank ? "is-active" : "")" asp-controller="Rubric" asp-action="Index" asp-route-tab="bank">@L10n.T("Rubric bank")</a>
    <a class="bank-tab @(Model.ActiveTab == AIVES.WebMVC.Models.ViewModels.RubricTabs.Create ? "is-active" : "")" asp-controller="Rubric" asp-action="Index" asp-route-tab="create">@L10n.T("Create")</a>
    <a class="bank-tab @(Model.ActiveTab == AIVES.WebMVC.Models.ViewModels.RubricTabs.Ai ? "is-active" : "")" asp-controller="Rubric" asp-action="Index" asp-route-tab="ai">@L10n.T("AI generation")</a>
</nav>

@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

@switch (Model.ActiveTab)
{
    case AIVES.WebMVC.Models.ViewModels.RubricTabs.Create:
        ViewData["MatrixAction"] = Model.Matrix.Id > 0 ? "Update" : "Create";
        ViewData["MatrixRouteId"] = Model.Matrix.Id > 0 ? (int)Model.Matrix.Id : null;
        <partial name="_RubricMatrixEditor" model="Model.Matrix" />
        break;

    case AIVES.WebMVC.Models.ViewModels.RubricTabs.Ai:
        <partial name="_RubricAiTab" model="Model" />
        break;

    default:
        <partial name="_RubricBankTab" model="Model" />
        break;
}

@section Scripts {
    <script src="~/js/matrix.js" asp-append-version="true"></script>
}
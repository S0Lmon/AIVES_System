@model AIVES.DTO.StudentResultDto
@inject AIVES.WebMVC.DisplayTimeZone TimeZone
@using AIVES.WebMVC
@{
    ViewData["Title"] = L10n.T("My result") + " – " + Model.ExamTitle;
}

<div class="page-heading">
    <div>
        <span class="page-kicker">Exams / Result</span>
        <h1>@Model.ExamTitle</h1>
        <p>@Model.SubjectName · @L10n.Format("Grade confirmed by your lecturer on {0}", TimeZone.ToLocal(Model.FinalizedAtUtc).ToString("yyyy-MM-dd"))</p>
    </div>
    <div class="text-end">
        <div class="small text-muted">@L10n.T("Final grade")</div>
        <strong class="fs-2">@ViewText.Score(Model.FinalScore)</strong> <span class="text-muted">/ 10</span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.LecturerComment))
{
    <section class="panel p-4 mb-3">
        <h2 class="h6">@L10n.T("Comment from your lecturer")</h2>
        <p class="mb-0">@Model.LecturerComment</p>
    </section>
}

@foreach (var question in Model.Questions)
{
    <section class="panel p-4 mb-3">
        <div class="d-flex justify-content-between gap-2 flex-wrap mb-2">
            <h2 class="h5 mb-0">@L10n.Format("Question {0}", question.Order)</h2>
            <span><strong>@ViewText.Score(question.Score)</strong> / @ViewText.Score(question.MaxScore)</span>
        </div>
        <p>@question.Content</p>
        @if (!string.IsNullOrWhiteSpace(question.LecturerComment))
        {
            <p class="mb-2"><strong>@L10n.T("Lecturer"):</strong> @question.LecturerComment</p>
        }
        @if (!string.IsNullOrWhiteSpace(question.AiSummary))
        {
            <p class="small mb-2"><strong>@L10n.T("AI feedback"):</strong> @question.AiSummary</p>
        }
        <div class="row small mb-2">
            <div class="col-md-4"><strong>@L10n.T("Strengths")</strong><ul class="ps-3 mb-0">@foreach (var item in question.Strengths) { <li>@item</li> }</ul></div>
            <div class="col-md-4"><strong>@L10n.T("Weaknesses")</strong><ul class="ps-3 mb-0">@foreach (var item in question.Weaknesses) { <li>@item</li> }</ul></div>
            <div class="col-md-4"><strong>@L10n.T("Missing points")</strong><ul class="ps-3 mb-0">@foreach (var item in question.MissingPoints) { <li>@item</li> }</ul></div>
        </div>
        <details>
            <summary class="small">@L10n.T("Your answers")</summary>
            <ol class="small mt-2 ps-3 mb-0">
                @foreach (var exchange in question.Exchanges)
                {
                    <li class="mb-2"><strong>@exchange.Question</strong><div>@(string.IsNullOrWhiteSpace(exchange.Answer) ? L10n.T("No answer") : exchange.Answer)</div></li>
                }
            </ol>
        </details>
    </section>
}

<p class="small text-muted">@L10n.T("The AI feedback helped your lecturer; the scores are your lecturer's decision. If you disagree with your grade, contact your lecturer: the viva was recorded as evidence.")</p>
<a asp-action="Index" class="btn btn-light">@L10n.T("Back to my exams")</a>

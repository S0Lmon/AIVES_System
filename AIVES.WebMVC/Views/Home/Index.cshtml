@{ ViewData["Title"] = @L10n.T("Overview"); }
<section class="welcome-row"><div><span class="page-kicker">AIVES / Workbench</span><h1>@L10n.T("Viva exam orchestration")</h1><p>@L10n.T("Prepare questions, run adaptive interviews and approve results in one auditable workflow.")</p></div>@if (User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Lecturer)) { <div class="d-flex flex-wrap gap-2"><a asp-controller="Question" asp-action="Index" class="btn btn-light">@L10n.T("Open bank")</a><a asp-controller="Question" asp-action="Create" class="btn btn-primary">@L10n.T("Create question")</a></div> }</section>
<div class="workbench-grid"><section class="panel" aria-labelledby="workflow-title"><div class="panel-header"><div><span class="page-kicker">@L10n.T("Operating workflow")</span><h2 id="workflow-title">@L10n.T("From course material to grade decision")</h2></div><span class="status-label ready">@L10n.T("1 module ready")</span></div><ol class="workflow-list">
<li class="workflow-item"><span class="workflow-code">01</span><div><h3>@L10n.T("Question & rubric preparation")</h3><p>@L10n.T("Create, classify Bloom level and approve questions before use.")</p></div><span class="status-label ready">@L10n.T("Ready")</span></li>
<li class="workflow-item"><span class="workflow-code">02</span><div><h3>@L10n.T("Exam & scheduling")</h3><p>@L10n.T("Attach a subject, the participant list and a time limit.")</p></div><span class="status-label">@L10n.T("Planned")</span></li>
<li class="workflow-item"><span class="workflow-code">03</span><div><h3>@L10n.T("Adaptive interview")</h3><p>@L10n.T("STT, TTS and follow-up questions driven by the answer.")</p></div><span class="status-label">@L10n.T("Planned")</span></li>
<li class="workflow-item"><span class="workflow-code">04</span><div><h3>@L10n.T("Grade review & evidence")</h3><p>@L10n.T("Reconcile transcript, rubric and the lecturer decision.")</p></div><span class="status-label">@L10n.T("Planned")</span></li></ol></section>
<aside class="panel ai-map" aria-labelledby="ai-loop-title"><span class="page-kicker">AI interview loop</span><h2 id="ai-loop-title">@L10n.T("The lecturer always decides")</h2><div class="ai-loop"><div class="ai-node"><strong>01 · @L10n.T("Main question")</strong><span>@L10n.T("Choose by subject, Bloom level and rubric.")</span></div><div class="ai-arrow">↓</div><div class="ai-node"><strong>02 · @L10n.T("Answer recognition")</strong><span>@L10n.T("Turn speech into an auditable transcript.")</span></div><div class="ai-arrow">↓</div><div class="ai-node"><strong>03 · @L10n.T("Adaptive probing")</strong><span>@L10n.T("Clarify missing, vague or contradictory ideas.")</span></div><div class="ai-arrow">↓</div><div class="ai-node"><strong>04 · @L10n.T("Rubric suggestions")</strong><span>@L10n.T("AI proposes; the lecturer approves and finalises the grade.")</span></div></div></aside></div>
<section class="module-strip" aria-label="@L10n.T("AIVES feature groups")"><article class="module"><b>01 / LIVE</b><h3>@L10n.T("Question bank")</h3><p>@L10n.T("CRUD for questions, Bloom levels and rubrics.")</p></article><article class="module"><b>02 / ROADMAP</b><h3>@L10n.T("Exams & scheduling")</h3><p>@L10n.T("Sessions, participants and question selection.")</p></article><article class="module"><b>03 / ROADMAP</b><h3>@L10n.T("AI interview core")</h3><p>@L10n.T("STT, TTS and adaptive follow-up.")</p></article><article class="module"><b>04 / ROADMAP</b><h3>@L10n.T("Grading support")</h3><p>@L10n.T("Reconcile transcripts against rubrics.")</p></article><article class="module"><b>05 / ROADMAP</b><h3>@L10n.T("Supervision")</h3><p>@L10n.T("Recordings, logs and change history.")</p></article><article class="module"><b>06 / ROADMAP</b><h3>@L10n.T("Feedback & reports")</h3><p>@L10n.T("Per question scores and class statistics.")</p></article><article class="module"><b>07 / ROADMAP</b><h3>@L10n.T("Administration")</h3><p>@L10n.T("Accounts, permissions and language.")</p></article></section>
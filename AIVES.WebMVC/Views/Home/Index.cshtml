@model dynamic
@inject AIVES.WebMVC.DisplayTimeZone TimeZone
@{
    ViewData["Title"] = @L10n.T("Dashboard");
    var now = DateTime.UtcNow;
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isLecturer = User.IsInRole(AppRoles.Lecturer);
}

@if (isAdmin)
{
    var dto = (AdminDashboardDto)Model;
    <div class="page-heading">
        <div>
            <span class="page-kicker">AIVES / Dashboard</span>
            <h1>@L10n.T("System overview")</h1>
            <p>@L10n.T("System-wide counts and service health.")</p>
        </div>
    </div>

    <div class="metric-grid">
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon indigo">US</span>
                <span class="trend up">@L10n.T("Total users")</span>
            </div>
            <strong>@dto.TotalUsers</strong>
            <p>@L10n.T("Total users")</p>
        </div>
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon cyan">EX</span>
                <span class="trend up">@L10n.T("Exams")</span>
            </div>
            <strong>@dto.TotalExams</strong>
            <p>@L10n.T("Total exams")</p>
        </div>
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon amber">Q</span>
                <span class="trend up">@L10n.T("Question bank")</span>
            </div>
            <strong>@dto.TotalQuestions</strong>
            <p>@L10n.T("Total questions")</p>
        </div>
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon green">R</span>
                <span class="trend up">@L10n.T("Rubrics")</span>
            </div>
            <strong>@dto.TotalRubrics</strong>
            <p>@L10n.T("Total rubrics")</p>
        </div>
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon indigo">SJ</span>
                <span class="trend up">@L10n.T("Subjects")</span>
            </div>
            <strong>@dto.TotalSubjects</strong>
            <p>@L10n.T("Total subjects")</p>
        </div>
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon cyan">LIVE</span>
                <span class="trend up">@L10n.T("Active now")</span>
            </div>
            <strong>@dto.ActiveExamsNow</strong>
            <p>@L10n.T("Active exams now")</p>
        </div>
    </div>

    <div class="dashboard-grid">
        <section class="panel" aria-labelledby="health-title">
            <div class="panel-header">
                <div><span class="page-kicker">@L10n.T("System health")</span><h2 id="health-title">@L10n.T("Service status")</h2></div>
            </div>
            <div class="panel-body">
                <div class="detail-grid">
                    <div class="detail-item">
                        <small>@L10n.T("Database")</small>
                        <strong>@(dto.Health.DbOk ? L10n.T("OK") : L10n.T("Not configured"))</strong>
                    </div>
                    <div class="detail-item">
                        <small>@L10n.T("Gemini")</small>
                        <strong>@(dto.Health.GeminiOk ? L10n.T("OK") : L10n.T("Not configured"))</strong>
                    </div>
                    <div class="detail-item">
                        <small>@L10n.T("Ollama")</small>
                        <strong>@(dto.Health.OllamaOk ? L10n.T("OK") : L10n.T("Not configured"))</strong>
                    </div>
                    <div class="detail-item">
                        <small>@L10n.T("SMTP")</small>
                        <strong>@(dto.Health.SmtpOk ? L10n.T("OK") : L10n.T("Not configured"))</strong>
                    </div>
                </div>
            </div>
        </section>
        <section class="panel" aria-labelledby="admin-links-title">
            <div class="panel-header">
                <div><span class="page-kicker">@L10n.T("System")</span><h2 id="admin-links-title">@L10n.T("Administration")</h2></div>
            </div>
            <div class="panel-body">
                <div class="d-grid gap-2">
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-light btn-sm">@L10n.T("System check")</a>
                    <a asp-controller="Admin" asp-action="Users" class="btn btn-light btn-sm">@L10n.T("Users")</a>
                    <a asp-controller="Admin" asp-action="Subjects" class="btn btn-light btn-sm">@L10n.T("Subjects")</a>
                    <a asp-controller="Admin" asp-action="Settings" class="btn btn-light btn-sm">@L10n.T("Speech settings")</a>
                </div>
            </div>
        </section>
    </div>
}
else if (isLecturer)
{
    var dto = (LecturerDashboardDto)Model;
    <div class="page-heading">
        <div>
            <span class="page-kicker">AIVES / Dashboard</span>
            <h1>@L10n.T("Dashboard")</h1>
            <p>@L10n.T("Your exams and question bank status.")</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Exam" asp-action="Index" class="btn btn-light btn-sm">@L10n.T("Exams")</a>
            <a asp-controller="Question" asp-action="Index" class="btn btn-light btn-sm">@L10n.T("Question bank")</a>
            <a asp-controller="Rubric" asp-action="Index" class="btn btn-light btn-sm">@L10n.T("Rubrics")</a>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-light btn-sm">@L10n.T("Catalog")</a>
        </div>
    </div>

    <div class="metric-grid">
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon indigo">Q</span>
                <span class="trend up">@L10n.T("Total questions")</span>
            </div>
            <strong>@dto.QuestionBank.Total</strong>
            <p>@L10n.T("Total questions")</p>
        </div>
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon cyan">A</span>
                <span class="trend up">@L10n.T("Active questions")</span>
            </div>
            <strong>@dto.QuestionBank.Active</strong>
            <p>@L10n.T("Active questions")</p>
        </div>
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon amber">R</span>
                <span class="trend up">@L10n.T("Questions with rubric")</span>
            </div>
            <strong>@dto.QuestionBank.WithRubric</strong>
            <p>@L10n.T("Questions with rubric")</p>
        </div>
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon green">B</span>
                <span class="trend up">@L10n.T("Bloom spread")</span>
            </div>
            <strong>@dto.QuestionBank.BloomSpread</strong>
            <p>@L10n.T("Bloom levels used")</p>
        </div>
    </div>

    <div class="metric-grid">
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon indigo">R</span>
                <span class="trend up">@L10n.T("Rubrics")</span>
            </div>
            <strong>@dto.Rubrics.Total</strong>
            <p>@L10n.T("Total rubrics")</p>
        </div>
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon cyan">CR</span>
                <span class="trend up">@L10n.T("Rubrics with criteria")</span>
            </div>
            <strong>@dto.Rubrics.WithCriteria</strong>
            <p>@L10n.T("Rubrics with criteria")</p>
        </div>
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon amber">SJ</span>
                <span class="trend up">@L10n.T("Subjects")</span>
            </div>
            <strong>@dto.Subjects.Total</strong>
            <p>@L10n.T("Total subjects")</p>
        </div>
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon green">TM</span>
                <span class="trend up">@L10n.T("Subjects with topics")</span>
            </div>
            <strong>@dto.Subjects.WithTopics</strong>
            <p>@L10n.T("Subjects with topics")</p>
        </div>
    </div>

    <div class="dashboard-grid">
        <section class="panel" aria-labelledby="upcoming-title">
            <div class="panel-header">
                <div><span class="page-kicker">@L10n.T("Exams")</span><h2 id="upcoming-title">@L10n.T("Upcoming exams")</h2></div>
                <span class="status-label">@(dto.MyUpcomingExams.Count) @L10n.T("Upcoming")</span>
            </div>
            <div class="panel-body">
                @if (dto.MyUpcomingExams.Count == 0)
                {
                    <p class="text-muted">@L10n.T("No upcoming exams")</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table data-table">
                            <thead>
                                <tr>
                                    <th scope="col">@L10n.T("Exam")</th>
                                    <th scope="col">@L10n.T("Subject")</th>
                                    <th scope="col">@L10n.T("Time") (@TimeZone.OffsetLabel)</th>
                                    <th scope="col">@L10n.T("Candidates")</th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exam in dto.MyUpcomingExams)
                                {
                                    <tr>
                                        <td><a asp-controller="Exam" asp-action="Details" asp-route-id="@exam.Id"><strong>@exam.Title</strong></a></td>
                                        <td>@exam.SubjectName@(exam.TopicName is null ? "" : " / " + exam.TopicName)</td>
                                        <td class="small text-nowrap">@TimeZone.ToLocal(exam.StartsAtUtc).ToString("yyyy-MM-dd HH:mm") – @TimeZone.ToLocal(exam.EndsAtUtc).ToString("HH:mm")</td>
                                        <td>@exam.CandidateCount</td>
                                        <td><span class="status-label ready">@L10n.T("Upcoming")</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
        <section class="panel" aria-labelledby="past-title">
            <div class="panel-header">
                <div><span class="page-kicker">@L10n.T("Exams")</span><h2 id="past-title">@L10n.T("Past exams")</h2></div>
                <span class="status-label">@(dto.MyPastExams.Count) @L10n.T("Past")</span>
            </div>
            <div class="panel-body">
                @if (dto.MyPastExams.Count == 0)
                {
                    <p class="text-muted">@L10n.T("No past exams")</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table data-table">
                            <thead>
                                <tr>
                                    <th scope="col">@L10n.T("Exam")</th>
                                    <th scope="col">@L10n.T("Subject")</th>
                                    <th scope="col">@L10n.T("Time") (@TimeZone.OffsetLabel)</th>
                                    <th scope="col">@L10n.T("Candidates")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exam in dto.MyPastExams)
                                {
                                    <tr>
                                        <td><a asp-controller="Exam" asp-action="Details" asp-route-id="@exam.Id"><strong>@exam.Title</strong></a></td>
                                        <td>@exam.SubjectName@(exam.TopicName is null ? "" : " / " + exam.TopicName)</td>
                                        <td class="small text-nowrap">@TimeZone.ToLocal(exam.StartsAtUtc).ToString("yyyy-MM-dd HH:mm") – @TimeZone.ToLocal(exam.EndsAtUtc).ToString("HH:mm")</td>
                                        <td>@exam.CandidateCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    </div>
}
else
{
    var dto = (StudentDashboardDto)Model;
    <div class="page-heading">
        <div>
            <span class="page-kicker">AIVES / Dashboard</span>
            <h1>@L10n.T("Dashboard")</h1>
            <p>@L10n.T("Your exams and overall performance.")</p>
        </div>
    </div>

    <div class="metric-grid">
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon indigo">UP</span>
                <span class="trend up">@L10n.T("Upcoming exams")</span>
            </div>
            <strong>@dto.UpcomingCount</strong>
            <p>@L10n.T("Upcoming exams")</p>
        </div>
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon cyan">DN</span>
                <span class="trend up">@L10n.T("Past exams")</span>
            </div>
            <strong>@dto.CompletedCount</strong>
            <p>@L10n.T("Completed exams")</p>
        </div>
        <div class="metric-card">
            <div class="metric-top">
                <span class="metric-icon amber">SC</span>
                <span class="trend up">@L10n.T("Average score")</span>
            </div>
            <strong>@(dto.AverageScore?.ToString("0.#") ?? L10n.T("N/A"))</strong>
            <p>@L10n.T("Average score")</p>
        </div>
    </div>

    <div class="dashboard-grid">
        <section class="panel" aria-labelledby="student-upcoming-title">
            <div class="panel-header">
                <div><span class="page-kicker">@L10n.T("Exams")</span><h2 id="student-upcoming-title">@L10n.T("Upcoming exams")</h2></div>
                <span class="status-label">@dto.UpcomingCount</span>
            </div>
            <div class="panel-body">
                @if (dto.UpcomingExams.Count == 0)
                {
                    <p class="text-muted">@L10n.T("No upcoming exams")</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table data-table">
                            <thead>
                                <tr>
                                    <th scope="col">@L10n.T("Exam")</th>
                                    <th scope="col">@L10n.T("Subject")</th>
                                    <th scope="col">@L10n.T("Time") (@TimeZone.OffsetLabel)</th>
                                    <th scope="col">@L10n.T("Slot")</th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exam in dto.UpcomingExams)
                                {
                                    <tr>
                                        <td><strong>@exam.Title</strong></td>
                                        <td>@exam.SubjectName@(exam.TopicName is null ? "" : " / " + exam.TopicName)</td>
                                        <td class="small text-nowrap">@TimeZone.ToLocal(exam.StartsAtUtc).ToString("yyyy-MM-dd HH:mm") – @TimeZone.ToLocal(exam.EndsAtUtc).ToString("HH:mm")</td>
                                        <td class="small">@L10n.Format("{0} of {1}", exam.Order, exam.CandidateCount)</td>
                                        <td>
                                            @if (now >= exam.StartsAtUtc && now < exam.EndsAtUtc)
                                            {
                                                <a class="btn btn-sm btn-primary" asp-controller="Interview" asp-action="Index" asp-route-id="@exam.CandidateId">@L10n.T("Start the viva")</a>
                                            }
                                            else
                                            {
                                                <span class="small text-muted">@L10n.T("Opens at your slot")</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
        <section class="panel" aria-labelledby="student-past-title">
            <div class="panel-header">
                <div><span class="page-kicker">@L10n.T("Exams")</span><h2 id="student-past-title">@L10n.T("Past exams")</h2></div>
                <span class="status-label">@dto.CompletedCount</span>
            </div>
            <div class="panel-body">
                @if (dto.PastExams.Count == 0)
                {
                    <p class="text-muted">@L10n.T("No past exams")</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table data-table">
                            <thead>
                                <tr>
                                    <th scope="col">@L10n.T("Exam")</th>
                                    <th scope="col">@L10n.T("Subject")</th>
                                    <th scope="col">@L10n.T("Time") (@TimeZone.OffsetLabel)</th>
                                    <th scope="col">@L10n.T("Score")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exam in dto.PastExams)
                                {
                                    <tr>
                                        <td><strong>@exam.Title</strong></td>
                                        <td>@exam.SubjectName@(exam.TopicName is null ? "" : " / " + exam.TopicName)</td>
                                        <td class="small text-nowrap">@TimeZone.ToLocal(exam.StartsAtUtc).ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            @if (exam.ResultAvailable && exam.FinalScore.HasValue)
                                            {
                                                <span class="font-weight-bold">@exam.FinalScore.Value.ToString("0.#")/10</span>
                                            }
                                            else if (exam.InterviewStatus == InterviewStatus.Completed)
                                            {
                                                <span class="status-label">@L10n.T("Grade not confirmed")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">@L10n.T("Not finished")</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    </div>
}

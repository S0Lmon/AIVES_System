@model AIVES.WebMVC.Models.ViewModels.AiQuestionGeneratorViewModel
@{ ViewData["Title"] = @L10n.T("Generate questions with Gemini"); }

<div class="page-heading">
    <div><span class="page-kicker">AI Exam Room / Gemini</span><h1>@L10n.T("Generate a viva question set")</h1><p>@L10n.T("Gemini produces a structured draft for the lecturer to read, refine and approve before it enters an exam.")</p></div>
</div>

<div class="generator-grid">
    <form asp-action="QuestionGenerator" method="post" class="panel generator-brief">
        <div class="panel-header"><div><span class="page-kicker">Generation brief</span><h2>@L10n.T("Academic brief")</h2></div></div>
        <div class="panel-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3"><label asp-for="Subject" class="form-label">@L10n.T("Subject")</label><input asp-for="Subject" class="form-control" placeholder="@L10n.T("Example: Object oriented programming")" /><span asp-validation-for="Subject" class="text-danger small"></span></div>
            <div class="mb-3"><label asp-for="Topic" class="form-label">@L10n.T("Topic to assess")</label><input asp-for="Topic" class="form-control" placeholder="@L10n.T("Example: Polymorphism and SOLID")" /><span asp-validation-for="Topic" class="text-danger small"></span></div>
            <div class="mb-3"><label asp-for="LearningOutcomes" class="form-label">@L10n.T("Learning outcomes / knowledge scope")</label><textarea asp-for="LearningOutcomes" class="form-control" rows="5" placeholder="@L10n.T("Describe the concepts, skills or content limits Gemini should follow...")"></textarea><span asp-validation-for="LearningOutcomes" class="text-danger small"></span></div>
            <div class="row g-3"><div class="col-sm-6"><label asp-for="QuestionCount" class="form-label">@L10n.T("Number of questions")</label><input asp-for="QuestionCount" class="form-control" type="number" min="1" max="10" /><span asp-validation-for="QuestionCount" class="text-danger small"></span></div><div class="col-sm-6"><label asp-for="Difficulty" class="form-label">@L10n.T("Difficulty")</label><select asp-for="Difficulty" class="form-select"><option>@L10n.T("Balanced")</option><option>@L10n.T("Basic")</option><option>@L10n.T("Intermediate")</option><option>@L10n.T("Advanced")</option></select></div></div>
        </div>
        <div class="form-actions"><a asp-controller="Home" asp-action="Index" class="btn btn-light">@L10n.T("Back")</a><button type="submit" class="btn btn-primary"><span>@L10n.T("Generate list")</span></button></div>
    </form>

    <section class="panel generator-output" aria-live="polite">
        <div class="panel-header"><div><span class="page-kicker">Lecturer review</span><h2>@L10n.T("Suggested list")</h2></div><span class="status-label">@L10n.Format("{0} questions", Model.Questions.Count)</span></div>
        @if (Model.Questions.Count == 0)
        {
            <div class="generator-empty"><span class="generator-empty-code">AI / 00</span><h3>@L10n.T("No questions generated yet")</h3><p>@L10n.T("Fill in the academic brief on the left. The result includes the main question, expected answer, Bloom level and two follow up questions.")</p></div>
        }
        else
        {
            <ol class="generated-list">
                @for (var index = 0; index < Model.Questions.Count; index++)
                {
                    var question = Model.Questions[index];
                    <li class="generated-question">
                        <div class="generated-index">Q@((index + 1).ToString("D2"))</div>
                        <div class="generated-copy"><div class="generated-meta"><span class="badge-soft">@question.BloomLevel</span><span>@L10n.T("AI draft · needs lecturer approval")</span></div><h3>@question.Content</h3><div class="answer-block"><strong>@L10n.T("Expected key points")</strong><p>@question.ExpectedAnswer</p></div><div class="follow-up-block"><strong>@L10n.T("Follow up questions")</strong><ul>@foreach (var followUp in question.FollowUpQuestions) { <li>@followUp</li> }</ul></div></div>
                    </li>
                }
            </ol>
        }
    </section>
</div>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }

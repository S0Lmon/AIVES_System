@model AIVES.WebMVC.Models.ViewModels.AiQuestionGeneratorViewModel
@{ ViewData["Title"] = "Tạo câu hỏi bằng Gemini"; }

<div class="page-heading">
    <div><span class="page-kicker">AI Exam Room / Gemini</span><h1>Tạo bộ câu hỏi vấn đáp</h1><p>Gemini tạo bản nháp có cấu trúc để giảng viên đọc, chỉnh sửa và duyệt trước khi đưa vào kỳ thi.</p></div>
    <span class="status-label @(Model.IsGeminiConfigured ? "ready" : "")">@(Model.IsGeminiConfigured ? "Gemini đã cấu hình" : "Chưa có API key")</span>
</div>

<div class="generator-grid">
    <form asp-action="QuestionGenerator" method="post" class="panel generator-brief">
        <div class="panel-header"><div><span class="page-kicker">Generation brief</span><h2>Yêu cầu học thuật</h2></div></div>
        <div class="panel-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            @if (!Model.IsGeminiConfigured)
            {
                <div class="config-notice"><strong>Cần cấu hình Gemini API</strong><p>Dùng User Secrets với khóa mới. Không đưa API key vào mã nguồn hoặc JavaScript phía trình duyệt.</p><code>dotnet user-secrets set "Gemini:ApiKey" "YOUR_NEW_KEY" --project AIVES.WebMVC</code></div>
            }
            <div class="mb-3"><label asp-for="Subject" class="form-label">Môn học</label><input asp-for="Subject" class="form-control" placeholder="Ví dụ: Lập trình hướng đối tượng" /><span asp-validation-for="Subject" class="text-danger small"></span></div>
            <div class="mb-3"><label asp-for="Topic" class="form-label">Chủ đề cần đánh giá</label><input asp-for="Topic" class="form-control" placeholder="Ví dụ: Tính đa hình và SOLID" /><span asp-validation-for="Topic" class="text-danger small"></span></div>
            <div class="mb-3"><label asp-for="LearningOutcomes" class="form-label">Chuẩn đầu ra / phạm vi kiến thức</label><textarea asp-for="LearningOutcomes" class="form-control" rows="5" placeholder="Nêu các khái niệm, kỹ năng hoặc giới hạn nội dung Gemini cần bám theo..."></textarea><span asp-validation-for="LearningOutcomes" class="text-danger small"></span></div>
            <div class="row g-3"><div class="col-sm-6"><label asp-for="QuestionCount" class="form-label">Số câu hỏi</label><input asp-for="QuestionCount" class="form-control" type="number" min="1" max="10" /><span asp-validation-for="QuestionCount" class="text-danger small"></span></div><div class="col-sm-6"><label asp-for="Difficulty" class="form-label">Mức độ</label><select asp-for="Difficulty" class="form-select"><option>Cân bằng</option><option>Cơ bản</option><option>Trung bình</option><option>Nâng cao</option></select></div></div>
        </div>
        <div class="form-actions"><a asp-controller="Home" asp-action="Index" class="btn btn-light">Quay lại</a><button type="submit" class="btn btn-primary" disabled="@(!Model.IsGeminiConfigured)"><span>Tạo danh sách</span></button></div>
    </form>

    <section class="panel generator-output" aria-live="polite">
        <div class="panel-header"><div><span class="page-kicker">Lecturer review</span><h2>Danh sách đề xuất</h2></div><span class="status-label">@Model.Questions.Count câu</span></div>
        @if (Model.Questions.Count == 0)
        {
            <div class="generator-empty"><span class="generator-empty-code">AI / 00</span><h3>Chưa có câu hỏi được tạo</h3><p>Điền yêu cầu học thuật ở bên trái. Kết quả sẽ gồm câu hỏi chính, đáp án mong đợi, mức Bloom và hai câu hỏi đào sâu.</p></div>
        }
        else
        {
            <ol class="generated-list">
                @for (var index = 0; index < Model.Questions.Count; index++)
                {
                    var question = Model.Questions[index];
                    <li class="generated-question">
                        <div class="generated-index">Q@(index + 1).ToString("D2")</div>
                        <div class="generated-copy"><div class="generated-meta"><span class="badge-soft">@question.BloomLevel</span><span>Bản nháp AI · cần giảng viên duyệt</span></div><h3>@question.Content</h3><div class="answer-block"><strong>Ý chính mong đợi</strong><p>@question.ExpectedAnswer</p></div><div class="follow-up-block"><strong>Câu hỏi đào sâu</strong><ul>@foreach (var followUp in question.FollowUpQuestions) { <li>@followUp</li> }</ul></div></div>
                    </li>
                }
            </ol>
        }
    </section>
</div>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }

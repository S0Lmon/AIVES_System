<!DOCTYPE html>
<html lang="@L10n.Current.ToCultureCode()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AIVES</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hallmark.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/slide-panels.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/banks.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="appSidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">A</span>
                <span><strong>AIVES</strong><small>AI-powered Viva Exam</small></span>
            </a>
            <nav class="side-nav" aria-label="Main navigation">
                <span class="nav-label">@L10n.T("Work space")</span>
                <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><span class="nav-icon">OV</span> @L10n.T("Overview")</a>
                <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Question" ? "active" : "")" asp-controller="Question" asp-action="Index" asp-route-tab="bank"><span class="nav-icon">QB</span> @L10n.T("Question bank")</a>
                <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rubric" ? "active" : "")" asp-controller="Rubric" asp-action="Index" asp-route-tab="bank"><span class="nav-icon">RB</span> @L10n.T("Rubric bank")</a>
                <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalog" ? "active" : "")" asp-controller="Catalog" asp-action="Index"><span class="nav-icon">SJ</span> @L10n.T("Catalog")</a>
                <span class="side-link is-disabled" aria-disabled="true"><span class="nav-icon">EX</span> @L10n.T("Exams") <small>@L10n.T("Under construction")</small></span>
                <span class="side-link is-disabled" aria-disabled="true"><span class="nav-icon">AI</span> @L10n.T("AI exam room") <small>@L10n.T("Disabled")</small></span>
                <span class="side-link is-disabled" aria-disabled="true"><span class="nav-icon">GR</span> @L10n.T("Grading") <small>@L10n.T("Under construction")</small></span>
                <span class="side-link is-disabled" aria-disabled="true"><span class="nav-icon">RP</span> @L10n.T("Reports") <small>@L10n.T("Under construction")</small></span>
                <span class="nav-label nav-label-spaced">@L10n.T("System")</span>
                <span class="side-link is-disabled" aria-disabled="true"><span class="nav-icon">US</span> @L10n.T("Users")</span>
                @if (User.IsInRole(AIVES.DTO.AdminRoles.RoleName))
                {
                    <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index"><span class="nav-icon">AD</span> @L10n.T("System check") <small>@L10n.T("Admin")</small></a>
                }
                <a class="side-link" asp-controller="Home" asp-action="Privacy"><span class="nav-icon">ST</span> @L10n.T("Data policy")</a>
            </nav>
        </aside>
        <div class="app-main">
            <header class="topbar">
                <button class="menu-toggle" type="button" id="menuToggle" aria-label="Toggle navigation">☰</button>
                <div class="topbar-copy"><span class="eyebrow">@L10n.T("AI-powered Viva Exam System")</span><strong>@ViewData["Title"]</strong></div>
                <div class="topbar-actions">@await Html.PartialAsync("_LanguageSwitcher")@if (User.Identity?.IsAuthenticated == true) { <a class="avatar" asp-controller="Profile" asp-action="Index" title="@L10n.T("Your profile")">@((User.Identity.Name ?? "GV")[..Math.Min(2, (User.Identity.Name ?? "GV").Length)].ToUpperInvariant())</a> } else { <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-sm">@L10n.T("Sign in")</a> }</div>
            </header>
            <main class="content-area">@RenderBody()</main>
            <footer class="app-footer">AIVES · @L10n.T("AI-powered viva exam system") · 2026</footer>
        </div>
    </div>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/catalog.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

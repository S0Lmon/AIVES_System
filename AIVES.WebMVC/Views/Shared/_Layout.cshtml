<!DOCTYPE html>
<html lang="@L10n.Current.ToCultureCode()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AIVES</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hallmark.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light" aria-label="Main navigation">
    <div class="container-fluid">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index"><strong>AIVES</strong><small class="text-muted">AI-powered Viva Exam</small></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasMenu" aria-controls="offcanvasMenu" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasMenu" aria-labelledby="offcanvasMenuLabel">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="offcanvasMenuLabel">@L10n.T("Navigation")</h5>
                <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <ul class="navbar-nav flex-column">
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">@L10n.T("Overview")</a></li>
                    @if (User.IsInRole(AIVES.DTO.AppRoles.Admin) || User.IsInRole(AIVES.DTO.AppRoles.Lecturer))
                    {
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Question" ? "active" : "")" asp-controller="Question" asp-action="Index" asp-route-tab="bank">@L10n.T("Question bank")</a></li>
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rubric" ? "active" : "")" asp-controller="Rubric" asp-action="Index" asp-route-tab="bank">@L10n.T("Rubric bank")</a></li>
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalog" ? "active" : "")" asp-controller="Catalog" asp-action="Index">@L10n.T("Catalog")</a></li>
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Exam" ? "active" : "")" asp-controller="Exam" asp-action="Index">@L10n.T("Exams")</a></li>
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Grading" && ViewContext.RouteData.Values["action"]?.ToString() != "Report" ? "active" : "")" asp-controller="Grading" asp-action="Index">@L10n.T("Grading")</a></li>
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" || ViewContext.RouteData.Values["action"]?.ToString() == "Report" ? "active" : "")" asp-controller="Reports" asp-action="Index">@L10n.T("Reports")</a></li>
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Glossary" ? "active" : "")" asp-controller="Glossary" asp-action="Index">@L10n.T("Subject terms")</a></li>
                    }
                    <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MyExams" ? "active" : "")" asp-controller="MyExams" asp-action="Index">@L10n.T("My exams")</a></li>
                    <li class="nav-item"><hr class="dropdown-divider" /></li>
                    @if (User.IsInRole(AIVES.DTO.AppRoles.Admin))
                    {
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users">@L10n.T("Users") <small class="text-muted">@L10n.T("Admin")</small></a></li>
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Subjects" ? "active" : "")" asp-controller="Admin" asp-action="Subjects">@L10n.T("Lecturers per subject") <small class="text-muted">@L10n.T("Admin")</small></a></li>
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")" asp-controller="Admin" asp-action="Settings">@L10n.T("Speech settings") <small class="text-muted">@L10n.T("Admin")</small></a></li>
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Audit" ? "active" : "")" asp-controller="Admin" asp-action="Audit">@L10n.T("Audit log") <small class="text-muted">@L10n.T("Admin")</small></a></li>
                    }
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Privacy">@L10n.T("Data policy")</a></li>
                </ul>
            </div>
        </div>
        <div class="d-flex align-items-center ms-auto">
            @await Html.PartialAsync("_LanguageSwitcher")
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="avatar ms-2" asp-controller="Profile" asp-action="Index" title="@L10n.T("Your profile")">@((User.Identity.Name ?? "GV")[..Math.Min(2, (User.Identity.Name ?? "GV").Length)].ToUpperInvariant())</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm ms-2">@L10n.T("Sign in")</a>
            }
        </div>
    </div>
</nav>
<div class="container-fluid mt-3">
    @RenderBody()
</div>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/catalog.js" asp-append-version="true"></script>
    <script src="~/js/catalog-dropdown.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

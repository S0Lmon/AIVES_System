@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div class="language-switch">
    @foreach (var language in AppLanguageExtensions.Supported)
    {
        var isCurrent = L10n.Current == language;
        <form asp-controller="Home" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl" method="post" class="language-form">
            <input type="hidden" name="language" value="@language" />
            <button type="submit" class="language-option @(isCurrent ? "is-current" : "")" title="@language.GetShortLabel()" lang="@language.ToCultureCode()">@language.GetShortLabel()</button>
        </form>
    }
</div>
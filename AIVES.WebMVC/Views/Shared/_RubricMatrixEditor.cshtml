@model AIVES.WebMVC.Models.ViewModels.RubricMatrixModel
@{
    // One editor serves the create tab, the edit screen and a proposed AI matrix, so the
    // parent view decides which action receives the grid.
    var formId = "rubricMatrixForm";
    var action = (string?)ViewData["MatrixAction"] ?? "Create";
    var routeId = (int?)ViewData["MatrixRouteId"];
    var columns = Model.Columns.Count == 0
        ? AIVES.WebMVC.Models.ViewModels.MatrixColumnInput.Defaults()
        : Model.Columns;
    var rows = Model.Rows.Count == 0
        ? new List<AIVES.WebMVC.Models.ViewModels.MatrixRowInput> { new() { Cells = AIVES.WebMVC.Models.ViewModels.MatrixColumnInput.DefaultCells() } }
        : Model.Rows;
    // Spreadsheet column letters, capped at the six columns the model allows.
    var letters = new[] { "A", "B", "C", "D", "E", "F" };
}

<form id="@formId" method="post" class="panel form-panel" data-matrix-editor
      asp-controller="Rubric" asp-action="@action" asp-route-id="@routeId">
    @Html.AntiForgeryToken()
    @Html.Hidden("Id", Model.Id)
    @Html.Hidden("IsEdit", Model.IsEdit)

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <section class="form-section">
        <div class="section-title"><span class="section-number">1</span><div><h2>@L10n.T("Rubric details")</h2><p>@L10n.T("Name the matrix and say what it scores.")</p></div></div>
        <div class="mb-4"><label class="form-label" for="rubricName">@L10n.T("Name") <span class="text-danger">*</span></label><input id="rubricName" name="Name" value="@Model.Name" class="form-control" maxlength="200" required /></div>
        <div><label class="form-label" for="rubricDescription">@L10n.T("Description")</label><textarea id="rubricDescription" name="Description" class="form-control" rows="2" maxlength="1000">@Model.Description</textarea></div>
    </section>

    <section class="form-section">
        <div class="section-title"><span class="section-number">2</span><div><h2>@L10n.T("Scoring grid")</h2><p>@L10n.T("Columns are the levels. Each row is scored independently against its best cell.")</p></div></div>

        @* One toolbar for the whole sheet: the grid is the only thing to fill in, so adding a level
           and adding a criterion are both offered here rather than in separate sections. *@
        <div class="sheet-toolbar">
            <button type="button" class="btn btn-light btn-sm" data-matrix-add-column>+ @L10n.T("Level")</button>
            <button type="button" class="btn btn-light btn-sm" data-matrix-add-row>+ @L10n.T("Criterion")</button>
            <span class="text-muted small">@L10n.T("2 to 6 levels, up to 10 criteria")</span>
            <span class="sheet-toolbar-hint text-muted small">@L10n.T("Arrow keys move between cells")</span>
        </div>

        <div class="matrix-scroll">
            <table class="sheet" data-matrix>
                <thead>
                    @* Spreadsheet letter row so a level can be named by its letter. *@
                    <tr class="sheet-letters">
                        <th class="sheet-corner"></th>
                        @for (var column = 0; column < columns.Count; column++)
                        {
                            var index = column;
                            <th class="sheet-letter" data-matrix-letter>@letters[index]</th>
                        }
                    </tr>
                    <tr class="sheet-heads" data-matrix-head>
                        <th class="sheet-rowlabel">@L10n.T("Criterion")</th>
                        @for (var column = 0; column < columns.Count; column++)
                        {
                            var index = column;
                            var columnModel = columns[index];
                            <th class="sheet-colhead" data-matrix-column="@index">
                                <input name="Columns[@index].Name" value="@columnModel.Name" class="sheet-cell-input" placeholder="@L10n.T("Level name")" maxlength="120" required />
                                <div class="sheet-cellfoot">
                                    <input name="Columns[@index].Points" type="number" min="0" max="100" value="@columnModel.Points" class="sheet-points" title="@L10n.T("Points")" />
                                    <button type="button" class="sheet-remove" data-matrix-remove-column="@index" title="@L10n.T("Remove level")" aria-label="@L10n.T("Remove level")">&times;</button>
                                </div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody data-matrix-body>
                    @for (var row = 0; row < rows.Count; row++)
                    {
                        var index = row;
                        var rowModel = rows[index];
                        var cells = rowModel.Cells ?? new List<AIVES.WebMVC.Models.ViewModels.MatrixCellInput>();
                        <tr data-matrix-row="@index">
                            <th class="sheet-rowhead" scope="row">
                                <div class="sheet-rownum">
                                    <span class="sheet-rownumber" data-matrix-row-number>@(index + 1)</span>
                                    <button type="button" class="sheet-remove" data-matrix-remove-row="@index" title="@L10n.T("Remove criterion")" aria-label="@L10n.T("Remove criterion")">&times;</button>
                                </div>
                                <textarea name="Rows[@index].Criterion" class="sheet-cell-input" rows="2" maxlength="300" placeholder="@L10n.T("Criterion")" required>@rowModel.Criterion</textarea>
                                <input name="Rows[@index].Description" value="@rowModel.Description" class="sheet-note" placeholder="@L10n.T("Note")" maxlength="1000" />
                                <div class="sheet-rowtotal"><span>@L10n.T("Best")</span><b data-matrix-row-total>0</b></div>
                            </th>
                            @for (var cell = 0; cell < columns.Count; cell++)
                            {
                                var rowIndex = index;
                                var cellIndex = cell;
                                var cellModel = cellIndex < cells.Count ? cells[cellIndex] : new AIVES.WebMVC.Models.ViewModels.MatrixCellInput();
                                <td data-matrix-cell>
                                    <textarea name="Rows[@rowIndex].Cells[@cellIndex].Descriptor" class="sheet-cell-input" placeholder="@L10n.T("What this level looks like")" maxlength="1000">@cellModel.Descriptor</textarea>
                                    <div class="sheet-cellfoot">
                                        <input name="Rows[@rowIndex].Cells[@cellIndex].Points" type="number" min="0" max="100" value="@cellModel.Points" class="sheet-points" title="@L10n.T("Points")" />
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                    @* Spreadsheet style: the add button lives in the sheet, under the last row. *@
                    <tr class="sheet-addrow">
                        <th class="sheet-rowlabel"></th>
                        @for (var column = 0; column < columns.Count; column++)
                        {
                            <td></td>
                        }
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="sheet-totals">
                        <th class="sheet-rowlabel">@L10n.T("Level best")</th>
                        @for (var column = 0; column < columns.Count; column++)
                        {
                            var index = column;
                            <td class="sheet-total" data-matrix-column-total="@index">0</td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="sheet-footer">
            <span class="text-muted small" data-matrix-summary></span>
            <span class="sheet-grandtotal">@L10n.T("Rubric total") <b data-matrix-grand-total>0</b></span>
        </div>
    </section>

    <div class="d-flex gap-2 justify-content-end">
        <a class="btn btn-light" asp-controller="Rubric" asp-action="Index" asp-route-tab="bank">@L10n.T("Cancel")</a>
        <button type="submit" class="btn btn-primary">@(Model.IsEdit ? L10n.T("Save rubric") : L10n.T("Create rubric"))</button>
    </div>
</form>
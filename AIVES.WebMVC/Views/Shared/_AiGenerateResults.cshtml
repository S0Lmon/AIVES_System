@model AIVES.WebMVC.Models.ViewModels.AiQuestionGeneratorViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small"></div>

@if (Model.Sources.Count > 0)
{
    <p class="ai-sources">@L10n.Format("Grounded in {0} material items", Model.Sources.Count):
        <span>@string.Join(", ", Model.Sources.Select(source => source.Title))</span>
    </p>
}

@if (Model.Questions.Count == 0)
{
    <p class="slide-hint">@L10n.T("No questions returned. Try a more specific topic.")</p>
}
else
{
    <ul class="ai-results">
        @for (var index = 0; index < Model.Questions.Count; index++)
        {
            var question = Model.Questions[index];
            <li class="ai-result"
                data-content="@question.Content"
                data-answer="@question.ExpectedAnswer"
                data-bloom="@question.BloomLevel">
                <div class="ai-result-head">
                    <span class="ai-result-index">Q@((index + 1).ToString("D2"))</span>
                    <span class="badge-soft">@question.BloomLevel</span>
                </div>
                <p class="ai-result-content">@question.Content</p>
                @if (!string.IsNullOrWhiteSpace(question.ExpectedAnswer))
                {
                    <details class="ai-result-more">
                        <summary>@L10n.T("Expected key points")</summary>
                        <p>@question.ExpectedAnswer</p>
                        @if (question.FollowUpQuestions.Count > 0)
                        {
                            <ul class="ai-followups">
                                @foreach (var followUp in question.FollowUpQuestions)
                                {
                                    <li>@followUp</li>
                                }
                            </ul>
                        }
                    </details>
                }
                <div class="ai-result-actions">
                    <button type="button" class="btn btn-sm btn-primary ai-use" data-apply="@index">
                        @L10n.T("Use this question")
                    </button>
                    <button type="button" class="btn btn-sm btn-light ai-copy" data-copy="@index">
                        @L10n.T("Copy")
                    </button>
                </div>
            </li>
        }
    </ul>
}
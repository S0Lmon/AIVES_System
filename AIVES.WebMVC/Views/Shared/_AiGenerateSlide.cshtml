@{
    var subjects = (IReadOnlyList<AIVES.WebMVC.Models.ViewModels.SubjectOption>)(ViewBag.AiSubjects ?? Array.Empty<AIVES.WebMVC.Models.ViewModels.SubjectOption>());
    var topics = (IReadOnlyList<AIVES.WebMVC.Models.ViewModels.TopicOption>)(ViewBag.AiTopics ?? Array.Empty<AIVES.WebMVC.Models.ViewModels.TopicOption>());
    var geminiReady = (bool)(ViewBag.AiGeminiAvailable ?? false);
    var ollamaReady = (bool)(ViewBag.AiOllamaAvailable ?? false);
    var activeProvider = ViewBag.AiProvider as AIVES.DTO.AiProvider? ?? AIVES.DTO.AiProvider.Gemini;
}

<div class="slide-backdrop" data-slide-close hidden></div>
<aside class="slide-panel slide-panel-compact" id="aiPanel" role="dialog" aria-modal="true" aria-labelledby="aiPanelTitle" hidden>
    <header class="slide-header slide-header-compact">
        <div><span class="page-kicker">@L10n.T("AI assist")</span><h2 id="aiPanelTitle">✦ @L10n.T("Generate questions")</h2></div>
        <button type="button" class="slide-close" data-slide-close aria-label="@L10n.T("Close")">✕</button>
    </header>

    <form asp-controller="Question" asp-action="GenerateQuestions" method="post" id="aiPanelForm" class="slide-form">
        @Html.AntiForgeryToken()
        <div class="slide-body slide-body-compact">

            <div class="ai-engine-row">
                <select name="Provider" id="aiProvider" class="form-select form-select-sm" aria-label="@L10n.T("Engine")">
                    <option value="">@L10n.T("Automatic")</option>
                    <option value="Gemini" disabled="@(!geminiReady)">Gemini@(geminiReady ? "" : " — " + L10n.T("no key"))</option>
                    <option value="Ollama" disabled="@(!ollamaReady)">Ollama@(ollamaReady ? "" : " — " + L10n.T("not running"))</option>
                </select>
                <span class="provider-state @(activeProvider == AIVES.DTO.AiProvider.Ollama ? "on" : "off")" id="aiEngineState">
                    @(activeProvider == AIVES.DTO.AiProvider.Ollama ? "Ollama" : "Gemini")
                </span>
            </div>

            <div class="ai-brief-grid">
                <label class="ai-field"><span>@L10n.T("Subject")</span>
                    <input name="Subject" id="aiSubject" class="form-control form-control-sm" maxlength="120" required
                           placeholder="@L10n.T("Subject")" />
                </label>
                <label class="ai-field"><span>@L10n.T("Topic")</span>
                    <input name="Topic" id="aiTopic" class="form-control form-control-sm" maxlength="200" required
                           placeholder="@L10n.T("Topic to assess")" />
                </label>
            </div>

            <details class="ai-details" open>
                <summary>@L10n.T("Ground in material")</summary>
                <div class="ai-details-body">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="UseMaterials" id="aiUseMaterials" value="true" checked />
                        <label class="form-check-label small" for="aiUseMaterials">@L10n.T("Use catalog material as context")</label>
                    </div>
                    <div class="ai-brief-grid">
                        @* Ids are explicit because the question form behind this panel posts the
                           same field names, and duplicate element ids are invalid. *@
                        @await Html.PartialAsync("_CatalogPicker", AIVES.WebMVC.Models.ViewModels.CatalogPickers.Subject(subjects, "SubjectId", L10n.T("Catalog subject"), L10n.T("All subjects"), id: "aiSlideSubject"))
                        @await Html.PartialAsync("_CatalogPicker", AIVES.WebMVC.Models.ViewModels.CatalogPickers.Topic(topics, "TopicId", L10n.T("Catalog topic"), L10n.T("All topics"), id: "aiSlideTopic", subjects: subjects))
                    </div>
                </div>
            </details>

            <details class="ai-details">
                <summary>@L10n.T("Advanced")</summary>
                <div class="ai-details-body">
                    <label class="ai-field"><span>@L10n.T("Learning outcomes")</span>
                        <textarea name="LearningOutcomes" id="aiOutcomes" class="form-control form-control-sm" rows="2" maxlength="2000"></textarea>
                    </label>
                    <div class="ai-brief-grid">
                        <label class="ai-field"><span>@L10n.T("Questions")</span>
                            <input name="QuestionCount" id="aiCount" class="form-control form-control-sm" type="number" min="1" max="10" value="3" />
                        </label>
                        <label class="ai-field"><span>@L10n.T("Difficulty")</span>
                            <select name="Difficulty" id="aiDifficulty" class="form-select form-select-sm">
                                <option value="Balanced">@L10n.T("Balanced")</option>
                                <option value="Basic">@L10n.T("Basic")</option>
                                <option value="Intermediate">@L10n.T("Intermediate")</option>
                                <option value="Advanced">@L10n.T("Advanced")</option>
                            </select>
                        </label>
                    </div>
                </div>
            </details>
        </div>

        <footer class="slide-actions slide-actions-compact">
            <button type="button" class="btn btn-light btn-sm" data-slide-close>@L10n.T("Close")</button>
            <button type="submit" class="btn btn-primary btn-sm" id="aiSubmit" data-ai-busy="@L10n.T("Generating...")">
                <span class="ai-submit-label">@L10n.T("Generate")</span>
            </button>
        </footer>
    </form>

    <section class="slide-results" id="aiResults" aria-live="polite"
             data-ai-error="@L10n.T("Could not generate questions right now. Please try again later.")"
             data-done="@L10n.T("Filled in")">
        <p class="slide-hint">@L10n.T("Pick a result to fill the question form.")</p>
    </section>
</aside>
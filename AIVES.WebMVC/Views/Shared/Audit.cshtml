@model AIVES.WebMVC.Models.ViewModels.AuditViewModel
@inject AIVES.WebMVC.DisplayTimeZone TimeZone
@using AIVES.WebMVC
@{
    ViewData["Title"] = L10n.T("Audit log");
}

<div class="page-heading">
    <div>
        <span class="page-kicker">@(Model.ExamId is null ? "Admin / Audit" : "Grading / Audit")</span>
        <h1>@L10n.T("Audit log")@(Model.ExamId is null ? "" : ": " + Model.Title)</h1>
        <p>@L10n.T("Every exam change, AI proposal, score change, confirmation, recording playback and account change, newest first. Entries cannot be edited.")</p>
    </div>
    @if (Model.ExamId is { } examId)
    {
        <a class="btn btn-light" asp-controller="Grading" asp-action="Exam" asp-route-id="@examId">@L10n.T("Back to the class")</a>
    }
</div>

@if (Model.ExamId is null)
{
    <form method="get" class="d-flex flex-wrap gap-2 mb-3">
        <input name="actor" value="@Model.Actor" class="form-control" style="max-width:260px" placeholder="@L10n.T("Filter by email")" />
        <select name="action" class="form-select" style="max-width:240px">
            <option value="">@L10n.T("All actions")</option>
            @foreach (var prefix in new[] { "exam.", "interview.", "grade.", "recording.", "report.", "user.", "subject.", "settings." })
            {
                <option value="@prefix" selected="@(Model.Action == prefix)">@prefix</option>
            }
        </select>
        <button type="submit" class="btn btn-light">@L10n.T("Filter")</button>
    </form>
}

<section class="panel overflow-hidden mb-4">
    @if (Model.Entries.Count == 0)
    {
        <p class="p-4 mb-0 text-muted">@L10n.T("Nothing recorded yet.")</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table">
                <thead>
                    <tr>
                        <th scope="col">@L10n.T("Time") (@TimeZone.OffsetLabel)</th>
                        <th scope="col">@L10n.T("Who")</th>
                        <th scope="col">@L10n.T("Action")</th>
                        <th scope="col">@L10n.T("Details")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.Entries)
                    {
                        <tr>
                            <td class="small text-nowrap">@TimeZone.ToLocal(entry.AtUtc).ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="small">@(entry.ActorEmail ?? "—")</td>
                            <td class="small">
                                @ViewText.Action(entry.Action)
                                @if (entry.CandidateId is { } candidateId)
                                {
                                    <div><a asp-controller="Grading" asp-action="Candidate" asp-route-id="@candidateId">@L10n.Format("Candidate #{0}", candidateId)</a></div>
                                }
                                else if (Model.ExamId is null && entry.ExamId is { } entryExamId)
                                {
                                    <div><a asp-controller="Grading" asp-action="Audit" asp-route-id="@entryExamId">@L10n.Format("Exam #{0}", entryExamId)</a></div>
                                }
                            </td>
                            <td class="small">@entry.Details</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

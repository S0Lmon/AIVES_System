@model AIVES.WebMVC.Models.ViewModels.CatalogPickerModel
@{
    // Renders a real <select> first and lets catalog-dropdown.js upgrade the presentation. The
    // native control stays in the DOM and stays the thing the form posts, so a page with no
    // JavaScript still submits a correct SubjectId / TopicId instead of silently posting nothing.
    var id = Model.Id ?? ("picker-" + Model.Name.ToLowerInvariant().Replace(".", "-"));
    var hasValue = Model.SelectedValue is not null && Model.Options.Any(option => option.Value == Model.SelectedValue.Value);
}
<div class="picker @(Model.Grouped ? "picker-grouped" : string.Empty)"
     data-catalog-picker
     @if (!string.IsNullOrEmpty(Model.FilteredBy)) { <text>data-filtered-by="@Model.FilteredBy"</text> }>
    <label class="form-label" for="@id">@Model.Label @if (Model.Required) { <span class="text-danger">*</span> }</label>
    <select id="@id" name="@Model.Name" class="picker-select" data-picker-select
            @if (Model.Required) { <text>required</text> }>
        <option value="">@Model.EmptyLabel</option>
        @if (Model.Grouped)
        {
            var groupNames = Model.Groups.ToDictionary(group => group.Value, group => group.Text);
            foreach (var group in Model.Options.GroupBy(option => option.GroupId ?? 0))
            {
                var groupName = groupNames.TryGetValue(group.Key, out var name) ? name : string.Empty;
                <optgroup label="@groupName">
                    @foreach (var option in group)
                    {
                        <option value="@option.Value" data-group-id="@option.GroupId"
                                selected="@(Model.SelectedValue == option.Value ? "selected" : null)">@option.Text</option>
                    }
                </optgroup>
            }
        }
        else
        {
            foreach (var option in Model.Options)
            {
                <option value="@option.Value" data-group-id="@option.GroupId"
                        selected="@(Model.SelectedValue == option.Value ? "selected" : null)">@option.Text</option>
            }
        }
    </select>

    <button type="button" class="picker-toggle" data-picker-toggle aria-haspopup="listbox" aria-expanded="false" aria-controls="@id-list">
        <span class="picker-value" data-picker-value>@(hasValue ? Model.Options.First(option => option.Value == Model.SelectedValue!.Value).Text : Model.EmptyLabel)</span>
        <span class="picker-caret" aria-hidden="true">▾</span>
    </button>

    <div class="picker-menu" id="@id-list" data-picker-menu hidden>
        <div class="picker-search">
            <input type="search" class="form-control form-control-sm" data-picker-search
                   placeholder="@L10n.T("Type to filter")" autocomplete="off" />
        </div>
        <ul class="picker-list" role="listbox" data-picker-list>
            <li role="option" class="picker-item picker-empty" data-picker-empty>@Model.EmptyLabel</li>
            @foreach (var option in Model.Options)
            {
                <li role="option" class="picker-item" data-picker-item
                    data-value="@option.Value" data-group-id="@option.GroupId"
                    aria-selected="@(Model.SelectedValue == option.Value ? "true" : "false")">@option.Text</li>
            }
        </ul>
        @if (Model.Options.Count == 0)
        {
            <p class="picker-none">@L10n.T("Nothing to choose yet.")</p>
        }
    </div>
    <span class="picker-error text-danger small" data-picker-error hidden></span>
</div>

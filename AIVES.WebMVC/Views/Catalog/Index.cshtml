@model AIVES.WebMVC.Models.ViewModels.CatalogViewModel
@{ ViewData["Title"] = L10n.T("Catalog"); }

@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<nav class="cat-tabs" aria-label="@L10n.T("Catalog")">
    <a class="cat-tab @(Model.ActiveTab == AIVES.WebMVC.Models.ViewModels.CatalogTabs.Subject ? "is-active" : "")"
       asp-action="Index" asp-route-tab="@AIVES.WebMVC.Models.ViewModels.CatalogTabs.Subject">@L10n.T("Subject")</a>
    <a class="cat-tab @(Model.ActiveTab == AIVES.WebMVC.Models.ViewModels.CatalogTabs.Material ? "is-active" : "")"
       asp-action="Index" asp-route-tab="@AIVES.WebMVC.Models.ViewModels.CatalogTabs.Material">@L10n.T("Material")</a>
</nav>

<div class="cat-stats">
    <div class="cat-stat"><span class="cat-stat-value">@Model.SubjectCount</span><span class="cat-stat-label">@L10n.T("Subjects")</span></div>
    <div class="cat-stat"><span class="cat-stat-value">@Model.TopicCount</span><span class="cat-stat-label">@L10n.T("Topics")</span></div>
    <div class="cat-stat"><span class="cat-stat-value">@Model.MaterialCount</span><span class="cat-stat-label">@L10n.T("Materials")</span></div>
</div>

@if (Model.ActiveTab == AIVES.WebMVC.Models.ViewModels.CatalogTabs.Subject)
{
    @await Html.PartialAsync("_CatalogSubjectTab", Model)
}
else
{
    @await Html.PartialAsync("_CatalogMaterialTab", Model)
}
@model AIVES.WebMVC.Models.ViewModels.GlossaryViewModel
@{ ViewData["Title"] = L10n.T("Subject terms"); }

<div class="page-heading">
    <div>
        <span class="page-kicker">Catalog / Terms</span>
        <h1>@L10n.T("Subject terms for speech recognition")</h1>
        <p>@L10n.T("Technical terms are often misheard, especially English terms in a Vietnamese viva. List each term with the ways it comes out wrong; answers are corrected automatically and the AI is told which terms to expect.")</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message)) { <div class="alert alert-success" role="status">@Model.Message</div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="alert alert-danger" role="alert">@Model.Error</div> }

@if (Model.Subjects.Count == 0)
{
    <p class="text-muted">@L10n.T("No subjects yet. Create them in the catalogue first.")</p>
}
else
{
    <form method="get" class="d-flex gap-2 mb-3" style="max-width:480px">
        <select name="subjectId" class="form-select" onchange="this.form.submit()" aria-label="@L10n.T("Subject")">
            @foreach (var subject in Model.Subjects)
            {
                <option value="@subject.Id" selected="@(subject.Id == Model.SubjectId)">@subject.Name</option>
            }
        </select>
    </form>

    <form method="post" asp-action="Add" class="panel p-4 mb-3">
        <input type="hidden" name="subjectId" value="@Model.SubjectId" />
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="term">@L10n.T("Term")</label>
                <input id="term" name="term" class="form-control" maxlength="100" required placeholder="SQL" />
            </div>
            <div class="col-md-7">
                <label class="form-label" for="spokenForms">@L10n.T("How it is misheard (separate with ;)")</label>
                <input id="spokenForms" name="spokenForms" class="form-control" maxlength="1000" placeholder="ét kiu eo; ét kiu en; sequel" />
            </div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">@L10n.T("Add")</button></div>
        </div>
    </form>

    <section class="panel overflow-hidden mb-4">
        @if (Model.Terms.Count == 0)
        {
            <p class="p-4 mb-0 text-muted">@L10n.Format("No terms for {0} yet.", Model.SubjectName)</p>
        }
        else
        {
            <table class="table data-table mb-0">
                <thead><tr><th>@L10n.T("Term")</th><th>@L10n.T("Corrected from")</th><th></th></tr></thead>
                <tbody>
                    @foreach (var term in Model.Terms)
                    {
                        <tr>
                            <td><strong>@term.Term</strong></td>
                            <td class="small">@string.Join("; ", term.SpokenForms)</td>
                            <td class="text-end">
                                <form method="post" asp-action="Delete" class="d-inline">
                                    <input type="hidden" name="id" value="@term.Id" />
                                    <input type="hidden" name="subjectId" value="@Model.SubjectId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L10n.T("Remove")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

{
	servers {
		# Keep X-Forwarded-Proto/For set by a proxy in front of Caddy on the Docker network or LAN
		# (cloudflared in tunnel mode), so the app still sees that the visitor used HTTPS.
		trusted_proxies static private_ranges
	}
}

# Reverse proxy in front of the web replicas. With a domain as the site address Caddy obtains and
# renews its TLS certificate automatically (a local certificate for "localhost"). In tunnel mode
# AIVES_CADDY_SITE is ":80": Cloudflare terminates HTTPS and cloudflared connects over plain HTTP.
{$AIVES_CADDY_SITE:localhost} {
	encode zstd gzip

	reverse_proxy {
		# Re-resolve the "web" service so replicas added by scaling join the pool.
		dynamic a {
			name web
			port 8080
			refresh 10s
		}
		lb_policy round_robin
		lb_try_duration 5s
		fail_duration 30s
	}
}

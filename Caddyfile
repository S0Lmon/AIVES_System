# Reverse proxy in front of the web replicas. Caddy obtains and renews the TLS
# certificate for AIVES_DOMAIN automatically (a local certificate for "localhost").
{$AIVES_DOMAIN:localhost} {
	encode zstd gzip

	reverse_proxy {
		# Re-resolve the "web" service so replicas added by scaling join the pool.
		dynamic a {
			name web
			port 8080
			refresh 10s
		}
		lb_policy round_robin
		lb_try_duration 5s
		fail_duration 30s
	}
}
